# Bytecode Python des daemons de hypr/scripts (float-smart-place,
# border-tint, bar-tint). Regenere a chaque import, et importe depuis
# ~/.config/hypr qui est un symlink vers ce dossier -- donc il reapparait
# ici tout seul des qu'un script y touche.
__pycache__/
*.pyc

# Portfolio content staging: drafted here, copied into my-portfolio by hand
portfolio-content/
.claude/

# MathJax for the markdown renderers (config/liseuse/tex2svg.js), pinned by
# package-lock.json and installed by config/liseuse/install.sh.
config/liseuse/node_modules/

# Docs website (Astro Starlight): what npm and the build produce, and the
# pages copied from docs/ by site/scripts/sync-docs.mjs.
site/node_modules/
site/dist/
site/.astro/
site/src/content/docs/docs/

# RPMs from packaging/build-rpms.sh
rpms/
