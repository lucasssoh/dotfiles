+
+/// The folder a file went to, as the pill shows it: from the home folder,
+/// without the file's own name ("Pictures/Screenshots").
+fn shown_folder(path: &str) -> String {
+    let path = Path::new(path);
+    let dir = path.parent().unwrap_or(path);
+    let shown = match std::env::home_dir() {
+        Some(home) => match dir.strip_prefix(&home) {
+            Ok(rel) if rel.as_os_str().is_empty() => return "Home".to_owned(),
+            Ok(rel) => rel.to_path_buf(),
+            Err(_) => dir.to_path_buf(),
+        },
+        None => dir.to_path_buf(),
+    };
+    shown.to_string_lossy().into_owned()
+}
+
+/// Why a write failed, in a few words.
+fn save_error(e: &io::Error) -> String {
+    match e.kind() {
+        io::ErrorKind::NotFound => "folder missing".to_owned(),
+        io::ErrorKind::PermissionDenied => "no permission".to_owned(),
+        io::ErrorKind::StorageFull => "disk full".to_owned(),
+        _ => e.to_string(),
+    }
+}
diff -ruN a/src/toast.rs b/src/toast.rs
--- a/src/toast.rs
+++ b/src/toast.rs
@@ -0,0 +1,141 @@
+//! A short pill over the image that says what an action did: Copied,
+//! Saved, Path copied, or what went wrong.
+//!
+//! coucou-shell patch, not upstream. Satty only reported through desktop
+//! notifications, and a notification popup stays under a fullscreen window:
+//! with satty fullscreen, Ctrl+C showed nothing at all. The pill lives in
+//! satty's own window instead. Its look is `.toast` in overrides.css; it
+//! fades through the `shown` class.
+
+use relm4::gtk::{self, glib, prelude::*};
+use std::cell::RefCell;
+
+use crate::icons::icon_names;
+
+const SHOWN_FOR: u64 = 1500;
+const ERROR_SHOWN_FOR: u64 = 4000;
+
+#[derive(Clone, Copy, PartialEq)]
+pub enum Kind {
+    Done,
+    Error,
+}
+
+struct Toast {
+    root: gtk::Box,
+    icon: gtk::Image,
+    title: gtk::Label,
+    detail: gtk::Label,
+    timer: Option<glib::SourceId>,
+}
+
+thread_local! {
+    static TOAST: RefCell<Option<Toast>> = const { RefCell::new(None) };
+}
+
+/// Builds the pill, hidden. The caller lays it over the image.
+pub fn widget() -> gtk::Box {
+    let root = gtk::Box::new(gtk::Orientation::Horizontal, 8);
+    root.add_css_class("toast");
+    root.set_halign(gtk::Align::Center);
+    root.set_valign(gtk::Align::Start);
+    root.set_can_target(false);
+    root.set_margin_top(16);
+    root.set_visible(false);
+
+    let icon = gtk::Image::new();
+    icon.add_css_class("toast-icon");
+    icon.set_valign(gtk::Align::Center);
+    let title = gtk::Label::new(None);
+    title.add_css_class("toast-title");
+    let detail = gtk::Label::new(None);
+    detail.add_css_class("toast-detail");
+    detail.set_ellipsize(gtk::pango::EllipsizeMode::Middle);
+    detail.set_max_width_chars(48);
+    root.append(&icon);
+    root.append(&title);
+    root.append(&detail);
+
+    TOAST.with(|t| {
+        t.replace(Some(Toast {
+            root: root.clone(),
+            icon,
+            title,
+            detail,
+            timer: None,
+        }))
+    });
+    root
+}
+
+/// Shows `title`, and `detail` beside it in a lighter ink.
+pub fn show(kind: Kind, title: &str, detail: Option<&str>) {
+    let title = title.to_owned();
+    let detail = detail.map(str::to_owned);
+    let ctx = glib::MainContext::default();
+    if ctx.is_owner() {
+        show_now(kind, &title, detail.as_deref());
+    } else {
+        ctx.invoke(move || show_now(kind, &title, detail.as_deref()));
+    }
+}
+
+fn show_now(kind: Kind, title: &str, detail: Option<&str>) {
+    TOAST.with(|t| {
+        let mut t = t.borrow_mut();
+        let Some(t) = t.as_mut() else { return };
+        if let Some(timer) = t.timer.take() {
+            timer.remove();
+        }
+
+        t.icon.set_icon_name(Some(match kind {
+            Kind::Done => icon_names::shipped::CHECKMARK_REGULAR,
+            Kind::Error => icon_names::shipped::DISMISS_REGULAR,
+        }));
+        t.title.set_label(title);
+        t.detail.set_label(detail.unwrap_or_default());
+        t.detail.set_visible(detail.is_some());
+        if kind == Kind::Error {
+            t.root.add_css_class("error");
+        } else {
+            t.root.remove_css_class("error");
+        }
+
+        t.root.set_visible(true);
+        // A frame later, so the opacity transition runs from 0.
+        let root = t.root.clone();
+        glib::idle_add_local_once(move || root.add_css_class("shown"));
+
+        let ms = if kind == Kind::Error { ERROR_SHOWN_FOR } else { SHOWN_FOR };
+        t.timer = Some(glib::timeout_add_local_once(
+            std::time::Duration::from_millis(ms),
+            hide,
+        ));
+    });
+}
+
+fn hide() {
+    TOAST.with(|t| {
+        let mut t = t.borrow_mut();
+        let Some(t) = t.as_mut() else { return };
+        t.timer = None;
+        t.root.remove_css_class("shown");
+        // Gone once the fade is over, unless a new pill came meanwhile.
+        let root = t.root.clone();
+        glib::timeout_add_local_once(std::time::Duration::from_millis(250), move || {
+            if !root.has_css_class("shown") {
+                root.set_visible(false);
+            }
+        });
+    });
+}
+
+/// Follows the toolbars: in fullscreen the top one floats over the image,
+/// and the pill goes under it.
+pub fn set_fullscreen(fullscreen: bool) {
+    TOAST.with(|t| {
+        if let Some(t) = t.borrow().as_ref() {
+            t.root.set_margin_top(if fullscreen { 76 } else { 16 });
+        }
+    });
+}
