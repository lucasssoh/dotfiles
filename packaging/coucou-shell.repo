[coucou-shell]
name=coucou-shell
baseurl=https://lucasssoh.github.io/dotfiles/rpm/fedora/$releasever/$basearch/
enabled=1
# Releases come out often: dnf looks for one at most an hour later
# instead of its default two days.
metadata_expire=1h
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://lucasssoh.github.io/dotfiles/rpm/RPM-GPG-KEY-coucou-shell
