#!/usr/bin/env bash
# install — the entry point for a bare clone.
#
# The logic now lives in bin/cc-pkg-mng. This file stays for one reason that
# has nothing to do with taste: BOOTSTRAP. On a fresh Fedora, ~/.local/bin does
# not yet contain cc-pkg-mng (config/ccpkg/install.sh is what puts it there),
# and the PATH entry that would find it comes from config/bash/.bashrc, which
# has not been installed either. `git clone && cd dotfiles && ./install` must
# keep working with nothing else present. README.md documents that sequence.
#
# Keeping the old implementation here instead would have guaranteed exactly the
# drift this whole exercise exists to kill: two orchestrators, two phase
# tables, two ideas of what a module is, diverging on the first change. This
# file translates and delegates; it decides nothing.
#
# install_all.sh and setup_fedora.sh remain directly executable on their own,
# as scripts/lib/status.sh's header promises.
set -Eeuo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MANAGER="$DOTFILES_DIR/bin/cc-pkg-mng"

[ -x "$MANAGER" ] || chmod +x "$MANAGER" 2>/dev/null || true
[ -f "$MANAGER" ] || {
    echo "install: missing $MANAGER — incomplete clone?" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: ./install [PHASE ...] [--detect] [--dry-run] [--help]

Phases (default: everything -- system packages, then every module):
  system         Base Fedora packages + services, then the hardware phase.
  hardware       Only the CPU/GPU-specific drivers, auto-detected.
  user           All config modules, Hyprland, KDE. No sudo prompt for
                 anything already installed.
  login-manager  greetd + tuigreet. Opt-in and interactive.

Options:
  --detect     Print the hardware detection and exit. Changes nothing.
  --dry-run    Print what would be done, in order, and exit.
  -h, --help   This text.

Once installed, the day-to-day command is `cc-pkg-mng`:
  cc-pkg-mng status     what changed since it was last applied
  cc-pkg-mng update     apply it (no password needed)
  cc-pkg-mng verify     check links, binaries, packages
EOF
}

args=()
for a in "$@"; do
    case "$a" in
        system)        args+=(--system-only) ;;
        hardware)      args+=(--hardware-only) ;;
        user)          args+=(--user) ;;
        login-manager) args+=(--login-manager) ;;
        --detect)      exec "$DOTFILES_DIR/scripts/hardware-detect.sh" --report ;;
        --dry-run|-n)  args=(-n "${args[@]+${args[@]}}") ;;
        -h|--help)     usage; exit 0 ;;
        *)             echo "install: unknown argument '$a' (try --help)" >&2; exit 1 ;;
    esac
done

# `-n` has to precede the subcommand: it is a global flag on the manager.
set -- ${args[@]+"${args[@]}"}
dry=()
rest=()
for a in ${1+"$@"}; do
    case "$a" in
        -n) dry+=(-n) ;;
        *)  rest+=("$a") ;;
    esac
done

exec "$MANAGER" ${dry[@]+"${dry[@]}"} install ${rest[@]+"${rest[@]}"}
