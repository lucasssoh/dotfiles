#!/usr/bin/env bash
# cc-pkg-mng — install and update manager for these dotfiles.
#
# Why it is bash and not Rust, despite this repo shipping three Rust binaries:
# bootstrapping. A compiled manager would have to be compiled by something,
# and the thing that compiles the repo cannot itself require the repo to have
# been compiled. A bash script symlinked into ~/.local/bin is current the
# instant `git pull` returns.
#
# Why `cc-pkg-mng` and not the `cc` originally wanted: /usr/bin/cc is a
# symlink to gcc, and ~/.local/bin sits 2nd in this user's PATH against 10th
# for /usr/bin. A `cc` here would shadow the C compiler for the whole session,
# which breaks `make` (CC defaults to cc) and any pip build of a native
# extension.
#
# Scope rule, stated once: `update` is user-space unless --system, `install`
# is system-scope unless --user. `update` must never prompt for a password,
# because a command you run several times a day must not need one.
#
# Reload policy: this tool behaves like dnf/apt/pacman. It puts files and
# binaries in place and restarts NOTHING. A running process keeps its old
# version in memory; the new one takes effect the next time it starts. What is
# still running old code is reported, never acted on.
#
# Status: steps 1-5 of the plan. `install` and `verify` are still to come and
# are listed in --help as such rather than hidden, so the shape of the tool
# stays visible.
set -Eeuo pipefail

BOLD="\e[1m"; GREEN="\e[32m"; YELLOW="\e[33m"; RED="\e[31m"; BLUE="\e[34m"; DIM="\e[2m"; RESET="\e[0m"

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
DOTFILES_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
export DOTFILES_ROOT

# shellcheck source=../scripts/lib/state.sh
. "$DOTFILES_ROOT/scripts/lib/state.sh"
# shellcheck source=../scripts/lib/changes.sh
. "$DOTFILES_ROOT/scripts/lib/changes.sh"
# shellcheck source=../scripts/lib/rust.sh
. "$DOTFILES_ROOT/scripts/lib/rust.sh"
# shellcheck source=../scripts/lib/modules.sh
. "$DOTFILES_ROOT/scripts/lib/modules.sh"
# shellcheck source=../scripts/lib/restart.sh
. "$DOTFILES_ROOT/scripts/lib/restart.sh"

DRY_RUN=0
QUIET=0

info()  { [ "$QUIET" = 1 ] || echo -e "${BLUE}[INFO]${RESET}  $*"; }
ok()    { [ "$QUIET" = 1 ] || echo -e "${GREEN}[ OK ]${RESET}  $*"; }
warn()  { echo -e "${YELLOW}[WARN]${RESET}  $*" >&2; }
err()   { echo -e "${RED}[ ERR]${RESET}  $*" >&2; exit 1; }
step()  { [ "$QUIET" = 1 ] || echo -e "\n${BOLD}── $* ──${RESET}\n"; }
dry()   { echo -e "${DIM}would:${RESET} $*"; }

usage() {
    cat <<'EOF'
Usage: cc-pkg-mng <command> [options]

Commands:
  status               What has changed since each module was last applied.
                       Read-only, never fetches unless asked, always exit 0.
  update [-n]          Apply what changed, in registry order. -n prints the
                       plan and changes nothing. Never restarts anything;
                       reports what is left running an older version.
  needs-restart        Re-print that report on its own.
  build [crate...]     Build the repo's Rust binaries, skipping any whose
                       sources have not changed since the last build.
                       With no argument, all of them.
  clean [--cargo]      Remove build caches. --cargo also removes the three
                       legacy ~/.cache/*-build trees this replaced.
  help                 This text.

Not yet implemented:
  install, verify, log

Options:
  --force              build/update: act even when nothing changed.
  --adopt              update: record the current fingerprints as "already
                       applied" WITHOUT installing or checking anything.
                       For a machine that is already set up.
  --no-pull            update: do not touch git; apply local work only.
  --only <module>      update: restrict to one module (repeatable).
  --system             update: allow the root-owned system phase.
  --fetch              status: contact origin to report how far behind.
  --porcelain          status: stable key<TAB>value output for scripting.
  -n, --dry-run        Print what would happen; change nothing.
  -q, --quiet          Only warnings and errors.
      --no-color       Plain output.
  -h, --help           This text.
  -V, --version        Print the repo revision this script came from.

Examples:
  cc-pkg-mng build             # rebuild only what changed
  cc-pkg-mng build roue        # just one crate
  cc-pkg-mng build --force     # ignore the staleness check
  cc-pkg-mng clean --cargo     # reclaim the old duplicated build trees
  cc-pkg-mng update -n         # what would be applied, without doing it
  cc-pkg-mng update            # apply it (user scope, no password)
  cc-pkg-mng update --system   # include the root-owned parts
EOF
}

version() {
    local rev
    rev="$(git -C "$DOTFILES_ROOT" describe --always --dirty 2>/dev/null || echo unknown)"
    echo "cc-pkg-mng ($rev) — $DOTFILES_ROOT"
}

# ---------------------------------------------------------------- build ----
cmd_build() {
    local force=0 wanted=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --force) force=1 ;;
            -*)      err "build: unknown option $1" ;;
            *)       wanted+=("$1") ;;
        esac
        shift
    done

    # No argument means every crate, in table order.
    [ "${#wanted[@]}" -eq 0 ] && wanted=("${RUST_CRATE_ORDER[@]}")

    local c
    for c in "${wanted[@]}"; do
        [ -n "${RUST_CRATES[$c]:-}" ] || \
            err "build: unknown crate '$c' (known: ${RUST_CRATE_ORDER[*]})"
    done

    state_load
    RUST_FORCE="$force"

    local rc=0 built=0 skipped=0
    for c in "${wanted[@]}"; do
        # shellcheck disable=SC2206  # deliberate word split: "<dir> <bin>…"
        local spec=(${RUST_CRATES[$c]})
        local dir="${spec[0]}"
        local bins=("${spec[@]:1}")

        if [ "$DRY_RUN" = 1 ]; then
            local key cur
            key="$(fp_path "$DOTFILES_ROOT/$dir")|$(cargo --version 2>/dev/null)"
            cur="$(state_get "crate.$c.key")"
            if [ "$force" != 1 ] && [ "$key" = "$cur" ] && _rust_bins_present "${bins[@]}"; then
                echo -e "  ${DIM}$c: up to date${RESET}"
            else
                dry "cargo build --release in $dir  → ${bins[*]}"
            fi
            continue
        fi

        # Decide BEFORE the call whether this was already current: afterwards
        # rust_build has stored the new key, so the comparison would always
        # match and the counts would be meaningless.
        local was_current=0
        if [ "$force" != 1 ] \
           && [ "$(state_get "crate.$c.key")" = "$(fp_path "$DOTFILES_ROOT/$dir")|$(cargo --version 2>/dev/null)" ] \
           && _rust_bins_present "${bins[@]}"; then
            was_current=1
        fi

        step "$c"
        if rust_build "$dir" "${bins[@]}"; then
            if [ "$was_current" = 1 ]; then skipped=$((skipped + 1)); else built=$((built + 1)); fi
        else
            rc=1
        fi
    done

    [ "$DRY_RUN" = 1 ] && return 0

    if [ "$rc" = 0 ]; then
        ok "Rust: $built built, $skipped already up to date — target dir $CARGO_TARGET_ROOT"
    else
        warn "Rust: at least one crate failed to build — see the output above."
    fi
    return "$rc"
}

# ---------------------------------------------------------------- clean ----
cmd_clean() {
    local do_cargo=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --cargo) do_cargo=1 ;;
            -*)      err "clean: unknown option $1" ;;
            *)       err "clean: unexpected argument $1" ;;
        esac
        shift
    done
    [ "$do_cargo" = 0 ] && { usage; err "clean: nothing selected (try --cargo)"; }

    local targets=("${RUST_LEGACY_BUILD_DIRS[@]}")
    # The in-repo target/ too: it is gitignored, and the old `cp -r` copied it
    # wholesale into the cache dir on every build for no benefit at all.
    targets+=("$DOTFILES_ROOT/config/hyprland/balise-src/target")

    local d total=0 sz
    for d in "${targets[@]}"; do
        [ -d "$d" ] || continue
        sz="$(du -sm "$d" 2>/dev/null | cut -f1)"
        total=$((total + ${sz:-0}))
        if [ "$DRY_RUN" = 1 ]; then
            dry "rm -rf $d  (${sz:-?} MB)"
        else
            info "removing $d (${sz:-?} MB)"
            rm -rf "$d"
        fi
    done

    if [ "$total" = 0 ]; then
        ok "Nothing to reclaim — the legacy build trees are already gone."
    elif [ "$DRY_RUN" = 1 ]; then
        echo -e "${DIM}total:${RESET} ${total} MB would be reclaimed"
    else
        ok "Reclaimed ~${total} MB."
    fi
}

# ------------------------------------------------------- change detection ----
# Populates WALK_NAMES / WALK_STATE / WALK_FP in MODULE_ORDER order.
#
# A module is due when it is new, when its fingerprint moved, when --force was
# given, OR when its last run failed. That last rule matters: a failure is
# often environmental (a copr outage, no network), and without it a single
# transient failure would be sticky forever -- the fingerprint has not moved,
# so nothing would ever retry it.
WALK_NAMES=(); WALK_STATE=(); WALK_FP=()
walk_modules() {
    local force="${1:-0}" m fp old rc
    WALK_NAMES=(); WALK_STATE=(); WALK_FP=()
    for m in "${MODULE_ORDER[@]}"; do
        fp="$(fp_path "config/$m")"
        old="$(state_get "mod.$m.fp")"
        rc="$(state_get "mod.$m.rc" 0)"
        WALK_NAMES+=("$m"); WALK_FP+=("$fp")
        if   [ "$force" = 1 ];      then WALK_STATE+=("forced")
        elif [ -z "$old" ];         then WALK_STATE+=("new")
        elif [ "$fp" != "$old" ];   then WALK_STATE+=("changed")
        elif [ "$rc" != 0 ];        then WALK_STATE+=("retry")
        else                             WALK_STATE+=("current")
        fi
    done
}

_unmapped_paths() {
    local f
    git -C "$DOTFILES_ROOT" ls-files | while read -r f; do
        if [ "$(path_target "$f")" = unmapped ]; then printf '%s\n' "$f"; fi
    done
    # The loop's own status is that of its last iteration's test, which is
    # false whenever the final file IS mapped -- i.e. almost always. Under
    # `set -e` that propagated out of the command substitution and killed
    # `status` halfway through its own output.
    return 0
}

# --------------------------------------------------------------- status ----
cmd_status() {
    local do_fetch=0 porcelain=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --fetch)     do_fetch=1 ;;
            --porcelain) porcelain=1 ;;
            *)           err "status: unknown option $1" ;;
        esac
        shift
    done

    registry_validate || err "Module registry is inconsistent (see above)."
    state_load
    walk_modules 0

    local branch head dirty
    branch="$(git -C "$DOTFILES_ROOT" branch --show-current 2>/dev/null || echo '?')"
    head="$(git -C "$DOTFILES_ROOT" rev-parse --short HEAD 2>/dev/null || echo '?')"
    dirty=0
    [ -n "$(git -C "$DOTFILES_ROOT" status --porcelain 2>/dev/null)" ] && dirty=1

    # Never fetches silently: `status` must be safe to call from a prompt.
    local behind=""
    if [ "$do_fetch" = 1 ]; then
        git -C "$DOTFILES_ROOT" fetch --quiet 2>/dev/null || warn "fetch failed (offline?)"
        behind="$(git -C "$DOTFILES_ROOT" rev-list --count "HEAD..@{u}" 2>/dev/null || echo '?')"
    fi

    local i n st
    if [ "$porcelain" = 1 ]; then
        printf 'branch\t%s\nhead\t%s\ndirty\t%s\n' "$branch" "$head" "$dirty"
        [ -n "$behind" ] && printf 'behind\t%s\n' "$behind"
        for i in "${!WALK_NAMES[@]}"; do printf 'module\t%s\t%s\n' "${WALK_NAMES[$i]}" "${WALK_STATE[$i]}"; done
        for n in "${RUST_CRATE_ORDER[@]}"; do printf 'crate\t%s\t%s\n' "$n" "$(_crate_state "$n")"; done
        printf 'last_run\t%s\n' "$(state_get run.last '-')"
        return 0
    fi

    echo -e "${BOLD}Dépôt${RESET}    $branch @ $head $( [ "$dirty" = 1 ] && echo -e "${YELLOW}(modifications locales)${RESET}" || echo "(propre)" )"
    [ -n "$behind" ] && [ "$behind" != 0 ] && echo -e "         ${YELLOW}$behind commit(s) en retard sur origin${RESET}"
    [ -n "$behind" ] && [ "$behind" = 0 ] && echo "         à jour avec origin"

    echo -e "\n${BOLD}Modules${RESET}"
    local due=0
    for i in "${!WALK_NAMES[@]}"; do
        st="${WALK_STATE[$i]}"
        case "$st" in
            current) printf "  ${GREEN}✓${RESET} %-14s à jour\n" "${WALK_NAMES[$i]}" ;;
            new)     printf "  ${DIM}○${RESET} %-14s jamais appliqué\n" "${WALK_NAMES[$i]}"; due=$((due+1)) ;;
            changed) printf "  ${YELLOW}●${RESET} %-14s modifié depuis la dernière application\n" "${WALK_NAMES[$i]}"; due=$((due+1)) ;;
            retry)   printf "  ${RED}✗${RESET} %-14s dernier run en échec (code %s) — sera rejoué\n" "${WALK_NAMES[$i]}" "$(state_get "mod.${WALK_NAMES[$i]}.rc")"; due=$((due+1)) ;;
        esac
    done

    echo -e "\n${BOLD}Crates${RESET}"
    for n in "${RUST_CRATE_ORDER[@]}"; do
        if [ "$(_crate_state "$n")" = current ]; then
            printf "  ${GREEN}✓${RESET} %-14s à jour\n" "$n"
        else
            printf "  ${YELLOW}●${RESET} %-14s source ou toolchain modifié depuis le build\n" "$n"
        fi
    done

    local unmapped; unmapped="$(_unmapped_paths)"
    if [ -n "$unmapped" ]; then
        echo -e "\n${BOLD}Chemins non couverts${RESET} ${DIM}(aucun module ne les revendique)${RESET}"
        printf '  %s\n' $unmapped
    fi

    echo -e "\n${DIM}dernier run : $(state_get run.last 'jamais')${RESET}"
    [ "$due" -gt 0 ] && echo -e "${DIM}$due module(s) à appliquer — cc-pkg-mng update -n pour le détail${RESET}"
    return 0
}

_crate_state() {
    local c="$1" spec dir bins key
    # shellcheck disable=SC2206
    spec=(${RUST_CRATES[$c]}); dir="${spec[0]}"; bins=("${spec[@]:1}")
    key="$(fp_path "$DOTFILES_ROOT/$dir")|$(cargo --version 2>/dev/null)"
    if [ "$(state_get "crate.$c.key")" = "$key" ] && _rust_bins_present "${bins[@]}"; then
        printf 'current'
    else
        printf 'stale'
    fi
}

# --------------------------------------------------------------- update ----
cmd_update() {
    local force=0 adopt=0 no_pull=0 system=0 only=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --force)   force=1 ;;
            --adopt)   adopt=1 ;;
            --no-pull) no_pull=1 ;;
            --system)  system=1 ;;
            --only)    shift; only+=("$1") ;;
            *)         err "update: unknown option $1" ;;
        esac
        shift
    done

    registry_validate || err "Module registry is inconsistent (see above)."
    state_load

    if [ "$adopt" = 1 ]; then
        # Adoption is a CLAIM, not a check: it records fingerprints for a
        # machine nobody verified. It exists so an already-configured machine
        # does not have to re-run all 18 modules once to become incremental.
        # Step 6 will gate this behind `verify`; until that exists, the banner
        # is the whole safeguard.
        echo -e "${YELLOW}${BOLD}Adoption${RESET} — les empreintes actuelles vont être enregistrées comme"
        echo -e "«  déjà appliquées  » SANS rien vérifier ni installer. Si cette machine n'est"
        echo -e "pas réellement à jour, les modules concernés ne seront jamais rejoués."
        walk_modules 0
        local i
        for i in "${!WALK_NAMES[@]}"; do
            state_set "mod.${WALK_NAMES[$i]}.fp" "${WALK_FP[$i]}"
            state_set "mod.${WALK_NAMES[$i]}.rc" 0
            state_set "mod.${WALK_NAMES[$i]}.applied" "$(date -Iseconds)"
        done
        state_set run.last "$(date -Iseconds)"
        state_set run.cmd "update --adopt"
        state_save
        ok "${#WALK_NAMES[@]} module(s) adoptés. Prochain \`update\` : incrémental."
        return 0
    fi

    # Pull semantics: refuse over local edits rather than surprise the user
    # with a merge they did not ask for. --no-pull is the way to apply local
    # work without touching the remote.
    if [ "$no_pull" = 0 ]; then
        if [ -n "$(git -C "$DOTFILES_ROOT" status --porcelain 2>/dev/null)" ]; then
            echo -e "${YELLOW}Modifications locales non commitées :${RESET}"
            git -C "$DOTFILES_ROOT" status --short | sed 's/^/  /'
            err "refus de tirer par-dessus. Commite, remise, ou relance avec --no-pull pour n'appliquer que le local."
        fi
        info "git pull (fast-forward seulement)…"
        [ "$DRY_RUN" = 1 ] && dry "git merge --ff-only origin/$(git -C "$DOTFILES_ROOT" branch --show-current)"
    fi

    walk_modules "$force"

    local i due=()
    for i in "${!WALK_NAMES[@]}"; do
        [ "${WALK_STATE[$i]}" = current ] && continue
        if [ "${#only[@]}" -gt 0 ]; then
            local wanted=0 o
            for o in "${only[@]}"; do [ "$o" = "${WALK_NAMES[$i]}" ] && wanted=1; done
            [ "$wanted" = 1 ] || continue
        fi
        due+=("${WALK_NAMES[$i]}:${WALK_STATE[$i]}")
    done

    if [ "${#due[@]}" -eq 0 ]; then
        ok "Rien à faire — tout est à jour."
        return 0
    fi

    echo -e "\n${BOLD}Modules à appliquer, dans l'ordre${RESET}"
    local d
    for d in "${due[@]}"; do printf '  %-16s %s\n' "${d%%:*}" "${d##*:}"; done

    echo -e "\n${BOLD}Crates${RESET}"
    local n
    for n in "${RUST_CRATE_ORDER[@]}"; do
        [ "$(_crate_state "$n")" = current ] && printf "  %-16s à jour\n" "$n" || printf "  %-16s à recompiler\n" "$n"
    done

    if [ "$system" = 1 ]; then
        echo -e "\n${DIM}--system : la phase système serait incluse si ses entrées ont changé${RESET}"
    else
        echo -e "\n${DIM}portée utilisateur : aucun paquet ne sera installé, aucun sudo demandé${RESET}"
    fi

    if [ "$DRY_RUN" = 1 ]; then
        echo -e "\n${DIM}essai à blanc — rien n'a été modifié${RESET}"
        return 0
    fi

    # ---- apply ------------------------------------------------------------
    # status.sh is sourced only here, not at the top of the file: it defines
    # info/ok/warn of its own under redirect_output_to_log, and `status`/`build`
    # have no use for a log file. Sourcing it lazily keeps those two silent and
    # side-effect free.
    # shellcheck source=../scripts/lib/status.sh
    . "$DOTFILES_ROOT/scripts/lib/status.sh"
    status_init

    # Scope is handed to the modules through the environment. 0 means every
    # root-owned step is deferred and named instead of prompting.
    export CCPKG_ALLOW_ROOT="$system"
    [ "$system" = 1 ] && sudo -v || true

    # Fresh deferral ledger per run, so the closing report describes THIS run
    # and not every deferral since the machine was built.
    : > "$STATE_DIR/deferred.ledger" 2>/dev/null || true

    local name script rc secs start
    for d in "${due[@]}"; do
        name="${d%%:*}"
        if ! script="$(module_script "$name")"; then
            skip_step "$name" "config/$name/install.sh not found"
            continue
        fi
        chmod +x "$script" 2>/dev/null || true

        export CCPKG_MODULE="$name"
        start="$(date +%s)"
        if run_step "$name" "$script"; then rc=0; else rc=$?; fi
        secs=$(( $(date +%s) - start ))

        # Written immediately, not batched at the end: a run interrupted with
        # Ctrl-C then keeps every module it actually finished. The fingerprint
        # stored is the one captured BEFORE the module ran.
        local i fp=""
        for i in "${!WALK_NAMES[@]}"; do
            [ "${WALK_NAMES[$i]}" = "$name" ] && fp="${WALK_FP[$i]}"
        done
        state_set "mod.$name.fp" "$fp"
        state_set "mod.$name.rc" "$rc"
        state_set "mod.$name.secs" "$secs"
        state_set "mod.$name.applied" "$(date -Iseconds)"
        state_save
    done

    state_set run.last "$(date -Iseconds)"
    state_set run.cmd "update$( [ "$system" = 1 ] && echo ' --system' )"
    state_save

    local summary_rc=0
    status_summary || summary_rc=$?

    # Deferrals are reported separately and do NOT fail the run: the files,
    # links and binaries are all in place; only the root-owned parts are
    # outstanding.
    if [ -s "$STATE_DIR/deferred.ledger" ]; then
        echo
        echo -e "${YELLOW}Reporte (necessite --system) :${RESET}"
        sort -u "$STATE_DIR/deferred.ledger" | sed 's/^/  /'
        echo -e "${DIM}  → cc-pkg-mng update --system${RESET}"
    fi

    needs_restart_report || true
    return "$summary_rc"
}

# ------------------------------------------------------------- dispatch ----
main() {
    local cmd=""
    local args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)    usage; return 0 ;;
            -V|--version) version; return 0 ;;
            -n|--dry-run) DRY_RUN=1 ;;
            -q|--quiet)   QUIET=1 ;;
            --no-color)   BOLD=""; GREEN=""; YELLOW=""; RED=""; BLUE=""; DIM=""; RESET="" ;;
            -*)           if [ -n "$cmd" ]; then args+=("$1"); else err "unknown option $1 (try --help)"; fi ;;
            *)            if [ -z "$cmd" ]; then cmd="$1"; else args+=("$1"); fi ;;
        esac
        shift
    done

    case "$cmd" in
        build)  cmd_build  ${args[@]+"${args[@]}"} ;;
        clean)  cmd_clean  ${args[@]+"${args[@]}"} ;;
        status) cmd_status ${args[@]+"${args[@]}"} ;;
        update) cmd_update ${args[@]+"${args[@]}"} ;;
        help|"") usage ;;
        needs-restart) needs_restart_report || true ;;
        install|verify|log)
            err "'$cmd' is not implemented yet — see --help for what ships today." ;;
        *) usage; err "unknown command '$cmd'" ;;
    esac
}

main "$@"
