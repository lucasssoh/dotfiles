# ============================================================
# Le document : blocs, diff, suivi du curseur
# ============================================================
class Document:
    def __init__(self, app, dark):
        self.colors = palette(dark)
        self.conv = Converter()
        self.uml = Plantuml(self.colors)
        self.dir = os.getcwd()
        self.render = Renderer(self.colors, CodeColors(dark), self.uml, lambda: self.dir)
        self.items = []          # [(clé, widget, début, fin)]
        self.last_target = None
        self.cursor = 0

        self.win = Gtk.ApplicationWindow(application=app, title="Aperçu markdown", css_classes=["mdview"])
        self.win.set_default_size(820, 1000)
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, css_classes=["doc"])
        self.clamp = Clamp(self.box, MAX_WIDTH)
        self.scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.scroll.set_child(self.clamp)
        self.win.set_child(self.scroll)

        css = Gtk.CssProvider()
        css.load_from_string(CSS.format(**self.colors))
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        # En phase de capture : la fenêtre voit j/k/espace AVANT les textes
        # sélectionnables, qui s'en serviraient pour déplacer leur curseur.
        keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.key)
        self.win.add_controller(keys)
        self.win.present()

    def key(self, _c, keyval, _code, _state):
        name = Gdk.keyval_name(keyval) or ""
        adj = self.scroll.get_vadjustment()
        if name in ("q", "Escape"):
            self.win.close()
        elif name in ("j", "Down"):
            adj.set_value(adj.get_value() + 60)
        elif name in ("k", "Up"):
            adj.set_value(adj.get_value() - 60)
        elif name in ("space", "Page_Down"):
            adj.set_value(adj.get_value() + adj.get_page_size() * 0.9)
        elif name == "Page_Up":
            adj.set_value(adj.get_value() - adj.get_page_size() * 0.9)
        elif name == "Home":
            adj.set_value(0)
        elif name == "End":
            adj.set_value(adj.get_upper())
        else:
            return False
        return True

    def update(self, text):
        refs = "\n".join(l for l in text.split("\n") if REF_DEF.match(l))
        new = []
        for start, end, src in split_blocks(text):
            key_src = src + ("\n\n" + refs if refs else "")
            for idx, elem in enumerate(self.conv.convert(key_src)):
                new.append(((hash(key_src), idx), elem, start, end))

        old_keys = [it[0] for it in self.items]
        new_keys = [n[0] for n in new]
        sm = difflib.SequenceMatcher(None, old_keys, new_keys, autojunk=False)
        widgets = [None] * len(new)
        reused = set()
        for op, i1, i2, j1, j2 in sm.get_opcodes():
            if op == "equal":
                for a, b in zip(range(i1, i2), range(j1, j2)):
                    widgets[b] = self.items[a][1]
                    reused.add(a)
        for a, it in enumerate(self.items):
            if a not in reused:
                self.box.remove(it[1])
        made = 0
        for b, (key, elem, start, end) in enumerate(new):
            if widgets[b] is None:
                widgets[b] = self.render.block(elem)
                made += 1
        prev = None
        for w in widgets:
            if w.get_parent() is None:
                self.box.insert_child_after(w, prev)
            elif w.get_prev_sibling() is not prev:
                self.box.reorder_child_after(w, prev)
            prev = w
        self.items = [(new[b][0], widgets[b], new[b][2], new[b][3]) for b in range(len(new))]
        return made

    def target(self, line):
        best = None
        for k, (_, w, start, end) in enumerate(self.items):
            if start <= line < end:
                return k
            if start <= line:
                best = k
        return best

    def follow(self, force=False):
        k = self.target(self.cursor)
        if k is None or (k == self.last_target and not force):
            return
        self.last_target = k
        # Après une mise à jour, la mise en page n'est pas encore faite :
        # on attend une image.
        GLib.timeout_add(40, self._scroll_to, k)

    def _scroll_to(self, k):
        if k >= len(self.items):
            return False
        w = self.items[k][1]
        ok, rect = w.compute_bounds(self.clamp)
        if not ok:
            return False
        adj = self.scroll.get_vadjustment()
        top, page = adj.get_value(), adj.get_page_size()
        y, h = rect.get_y(), rect.get_height()
        if y < top or y + min(h, page * 0.5) > top + page:
            adj.set_value(max(0, y - page * SCROLL_AT))
        return False

    def handle(self, msg):
        if "name" in msg:
            self.win.set_title("Aperçu — " + msg["name"])
        if msg.get("dir"):
            self.dir = msg["dir"]
        if "cursor" in msg:
            self.cursor = max(0, int(msg["cursor"]) - 1)
        if "text" in msg:
            self.update(msg["text"])
            self.follow(force=True)
        else:
            self.follow()


# ============================================================
# Hyprland : rendre le focus au terminal une fois la fenêtre ouverte
# ============================================================
def hypr(*args):
    try:
        return subprocess.run(["hyprctl", *args], capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def refocus(back):
    if not back:
        return
    for _ in range(40):
        try:
            if any(c.get("pid") == os.getpid() for c in json.loads(hypr("-j", "clients") or "[]")):
                hypr("dispatch", "hl.dsp.focus({ window = 'address:%s' })" % back)
                return
        except ValueError:
            pass
        time.sleep(0.15)


def main():
    try:
        back = json.loads(hypr("-j", "activewindow") or "{}").get("address")
    except ValueError:
        back = None
    dark = md2pdf.desktop_is_dark()
    app = Gtk.Application(application_id="fr.dotfiles.mdview", flags=Gio.ApplicationFlags.NON_UNIQUE)
    state = {}

    def activate(app):
        try:
            doc = state["doc"] = Document(app, dark)
        except Exception:
            import traceback
            traceback.print_exc()
            state["failed"] = True
            app.quit()
            return
        threading.Thread(target=refocus, args=(back,), daemon=True).start()

        # Les messages s'accumulent pendant un rendu : seul le dernier
        # texte compte, et le dernier curseur.
        pending, lock = {}, threading.Lock()

        def drain():
            with lock:
                msg = dict(pending)
                pending.clear()
            if msg:
                doc.handle(msg)
            return False

        def read():
            for raw in sys.stdin:
                try:
                    msg = json.loads(raw)
                except ValueError:
                    continue
                with lock:
                    first = not pending
                    pending.update(msg)
                if first:
                    GLib.idle_add(drain)
            GLib.idle_add(app.quit)

        threading.Thread(target=read, daemon=True).start()

    app.connect("activate", activate)
    code = app.run(None)
    if "doc" in state:
        state["doc"].uml.close()
    return 1 if state.get("failed") else code


if __name__ == "__main__":
    sys.exit(main())
