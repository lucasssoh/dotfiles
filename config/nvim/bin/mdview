        border-bottom: 1px solid {rule}; margin: 0; }}
label.th {{ background: {surface}; color: {heading}; font-weight: 600; }}
label.td.even {{ background: {surface_2}; }}
separator.hr {{ background: {rule}; min-height: 1px; margin: 20px 0; }}
.uml {{ margin: 16px 0; }}
