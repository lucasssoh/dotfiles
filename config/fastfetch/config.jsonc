{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/rayponce.jpg",
        "width": 35,
        "type":"chafa",
        "chafa": {
            "symbols": "ascii" // Force l'usage de caractères ASCII classiques
        },
        "height": 15,
        "padding": {
            "left": 1,
            "right": 2,
            "bottom": 1
        }
    },

    "display": {
        "separator": "",
        "constants": [
            "──────────────" // {$1}, used in Custom module
        ],
        "key": {
            "width": 10
        }
    },
    "modules": [
        {
            "type": "colors",
            "paddingLeft": 16,
            "symbol": "circle"
        },
        {
            "type": "custom", // HardwareStart
            // {#1} is equivalent to `\u001b[1m`. {#} is equivalent to `\u001b[m`
            "format": "{#90}┌{$1} Hardware {$1}{$1}┐{#}"
        },
        {
            "key": "CPU",
            "type": "cpu",
            "showPeCoreCount": true,
            "keyColor": "33"
        },
        {
            "key": "GPU",
            "type": "gpu",
            "keyColor": "32"
        },
        
        {
            "key": "Memory",
            "type": "memory",
            "keyColor": "31"
        },
        
        {
            "type": "custom", // InformationEnd
            "format": "{#90}└{$1}────────────────────────{$1}┘{#}"
        },
        {
            "type": "custom", // SoftwareStart
            // {#1} is equivalent to `\u001b[1m`. {#} is equivalent to `\u001b[m`
            "format": "{#90}┌{$1} Software {$1}{$1}┐{#}"
        },
        {
            "key": "OS",
            "type": "os",
            "keyColor": "33"
        },
        {
            "key": "Kernel",
            "type": "kernel",
            "keyColor": "93"
        },
        {
            "key": "DM",
            "type": "lm",
            "keyColor": "35"
        },
        {
            "key": "DE",
            "type": "de",
            "keyColor": "91"
        },
        {
            "key": "WM",
            "type": "wm",
            "keyColor": "32"
        },
        {
            "key": "Terminal",
            "type": "terminal",
            "keyColor": "94"
        },
                {
            "type": "custom", // InformationEnd
            "format": "{#90}└{$1}────────────────────────{$1}┘{#}"
        },
        {
            "type": "colors",
            "paddingLeft": 16,
            "symbol": "circle"
        }
    ]
}

