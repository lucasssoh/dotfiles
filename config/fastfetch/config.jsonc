{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // The photo is drawn by the terminal (WezTerm reads the iTerm image
    // protocol), not turned into characters. In grey, like the shell.
    "logo": {
        "source": "~/.config/fastfetch/rayponce.png",
        "type": "iterm",
        "width": 24,
        "height": 14,
        "padding": { "left": 1, "right": 4 }
    },
    // The terminal's own inks: keys dim, values plain, so it follows light
    // and dark mode without a colour of its own.
    "display": {
        "separator": "",
        "brightColor": false,
        "key": { "width": 12 },
        "color": { "keys": "2", "title": "1" },
        "percent": { "color": { "green": "default", "yellow": "default", "red": "default" }, "spaceBeforeUnit": "always" },
        "size": { "ndigits": 0, "binaryPrefix": "jedec", "spaceBeforeUnit": "always" },
        "duration": { "abbreviation": true, "spaceBeforeUnit": "always" }
    },
    "modules": [
        "break",
        "break",
        { "type": "custom", "format": "{#1}Coucou Shell{#}" },
        "break",
        { "type": "cpu", "key": "Processor", "format": "{name}" },
        { "type": "gpu", "key": "Graphics", "format": "{name}" },
        { "type": "memory", "key": "Memory", "format": "{used} of {total}" },
        "break",
        { "type": "os", "key": "System", "format": "{name} {version-id}" },
        { "type": "kernel", "key": "Kernel", "format": "{release}" },
        { "type": "wm", "key": "Desktop", "format": "{pretty-name} {version}" },
        { "type": "battery", "key": "Battery", "format": "{capacity}" },
        "break",
        // The package's version where it is installed (the release), the
        // checkout's otherwise.
        {
            "type": "command",
            "key": "cc-pkg-mng",
            "text": "v=$(rpm -q --qf '%{VERSION}' cc-pkg-mng 2>/dev/null) || v=$(cc-pkg-mng -V 2>/dev/null | grep -oE '[0-9]+[.][0-9]+[.][0-9]+' | head -n1); echo \"$v\""
        }
    ]
}
