{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/rayponce.jpg",
        "width": 35,
        "type":"chafa",
        "chafa": {
            "symbols": "ascii" // Force l'usage de caractères ASCII classiques
        },
        "height": 15,
        "padding": {
            "left": 1,
            "right": 2,
            "bottom": 1
        }
    },
    "display": {
        "separator": " ➜  ",
        "color": {
            "keys": "cyan",
            "title": "magenta"
        }
    },
    "modules": [
        "separator",
        { "type": "os", "key": "󰣛  " },
        { "type": "host", "key": "󰌢  " },
        { "type": "kernel", "key": "󰕮  " },
        { "type": "uptime", "key": "󰔚  " },
        { "type": "packages", "key": "󰏖  " },
        { "type": "shell", "key": "󱆃  " },
        { "type": "wm", "key": "  " },
        { "type": "terminal", "key": "  " },
        { "type": "cpu", "key": "󰻠  " },
        { "type": "gpu", "key": "󰢮  " },
        "separator",
        "colors",
        "break"
    ]
}
