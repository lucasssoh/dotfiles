[calendars]
[[personal]]
path = ~/.local/share/khal/calendars/personal
color = light blue

# Boussole's sessions and the timetable's courses, written by the boussole
# service (one .ics per event). Declared for everyone: the bar unit creates
# the folders, and an empty calendar costs nothing.
[[etude]]
path = ~/.local/share/khal/calendars/etude
color = light green

[[cours]]
path = ~/.local/share/khal/calendars/cours
color = light gray

[sqlite]
path = ~/.local/share/khal/khal.db

[locale]
timeformat = %H:%M
dateformat = %d/%m/%Y
longdateformat = %A %d %B %Y
datetimeformat = %d/%m/%Y %H:%M
longdatetimeformat = %A %d %B %Y %H:%M
firstweekday = 0

[view]
bold_for_light_color = false
