# ============================================================
# DUNSTRC — Ultra-compact & Discrete
# ============================================================

[global]
    monitor = 0
    follow = mouse

    # Positionnement discret en haut à droite
    origin = top-right
    offset = 12x48
    notification_limit = 3 # Limité à 3 pour éviter d'envahir l'écran

    # Géométrie compacte (Hauteur dynamique qui s'adapte au texte)
    width = (0, 280)       # Moins large (280px max au lieu de 360px)
    height = 60            # Moins haute (60px max au lieu de 120px)
    padding = 8            # Paddings réduits de moitié
    horizontal_padding = 12
    text_icon_padding = 10
    gap_size = 4           # Notifications plus serrées entre elles

    # Style épuré
    frame_width = 1
    frame_color = "#2c2c2e" # Bordure encore plus sombre pour se fondre dans le fond
    corner_radius = 8       # Arrondis plus discrets, calqués sur ton Hyprland
    transparency = 5

    sort = yes
    idle_threshold = 120

    # Typographie plus dense
    font = SF Pro Text, Inter, Noto Sans 10 # Taille descendue à 10
    line_height = 1
    markup = full
    format = "<b>%s</b> ⁃ %b" # Tout sur la même ligne si possible pour gagner de la hauteur
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ellipsize = end
    ignore_newline = yes    # Force le texte sur moins de lignes

    # Icônes plus petites pour fitter dans la petite boîte
    icon_theme = Papirus-Dark
    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 20      # Icônes compactes (style inline)
    max_icon_size = 24

    show_age_threshold = 60
    stack_duplicates = true
    hide_duplicate_count = true # Cache le compteur pour épurer le visuel
    show_indicators = no        # Vire les indicateurs (URLs, etc.) superflus
    sticky_history = no
    history_length = 10

    mouse_left_click  = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

    dmenu = rofi -dmenu -p dunst

[urgency_low]
    background = "#121214"   # Fond ultra sombre
    foreground = "#6e6e73"   # Texte très discret
    frame_color = "#222224"
    timeout = 3

[urgency_normal]
    background = "#121214"
    foreground = "#d1d1d6"
    frame_color = "#2c2c2e"
    timeout = 4              # Reste moins longtemps à l'écran

[urgency_critical]
    background = "#1c1c1e"
    foreground = "#ff453a"
    frame_color = "#ff453a"
    timeout = 0
