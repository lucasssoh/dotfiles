# hosts/default.env — the behaviour a normal laptop should have.
#
# This file is the NORM, not a machine. Every machine loads it first, and
# then its own hosts/<id>.env on top if it has one (see
# scripts/host-profile.sh for the full rationale). A laptop that has no
# file of its own -- a newly bought one, most importantly -- runs exactly
# what is written here, which is why this file has to describe a sane
# generic laptop rather than any particular one.
#
# Keep it free of anything model-specific. If a knob is only right for one
# machine, it belongs in that machine's file.

# ── Idle ladder ─────────────────────────────────────────────────────────
# Master switch, read by scripts/idle-action.sh. 0 makes every listener in
# hypridle.conf a no-op without having to edit that file or stop the
# daemon.
IDLE_ENABLED=1

# Actions this machine is allowed to perform at all, whatever the ladder
# in hypridle.conf asks for. Dropping "suspend" here is how a machine says
# "dim and lock me, but never put me to sleep" without a second conf file.
#
# undim and dpms-on are listed for completeness only: they are restore
# actions and idle-action.sh runs them unconditionally, precisely so a
# screen can never stay dark because of a policy decision.
IDLE_ALLOW="dim undim lock dpms-off dpms-on suspend"

# Refuse every idle action on a machine that reports no battery. This is
# the original capability guard and it stays: a machine with no battery
# has no battery life for an idle ladder to save, and this is what keeps
# a desktop that ever lands on the default profile from suspending itself.
IDLE_REQUIRE_BATTERY=1
