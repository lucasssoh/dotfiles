#!/usr/bin/env bash
# wallpaper-set — put a wallpaper on every connected screen.
#
#   wallpaper-set [--instant] NAME|PATH
#   wallpaper-set --resolve NAME|PATH   print the file that would be used
#
# Each screen gets the version fitted to its own resolution from the cache
# (~/.cache/filtered_wallpapers/<W>x<H>/NAME, written by wallpaper-filter),
# or the original when that version does not exist yet — awww then scales
# it, which is never worse than an image fitted for another screen.
#
# NAME is looked up in the wallpaper folder (prisme/wallpapers.conf, default
# ~/Images/Wallpapers). A PATH is used as the original; a path into the old
# flat cache (~/.cache/filtered_wallpapers/NAME, written by playlists before
# the cache was split per resolution) is mapped back to NAME.
#
# A light/dark pair is NAME.ext beside NAME-dark.ext (the extensions may
# differ). Either file of a pair stands for the pair: the one put on screen
# is the one matching the desktop's colour scheme (org.gnome.desktop.
# interface color-scheme, prefer-dark meaning dark). A file without its
# partner is used as it is, in both modes.
#
# The one place that talks to awww for a wallpaper: Prisme, the slideshow,
# the login restore and wallpaper-follow-scheme all go through here. Also
# refreshes the bar's tint, just before the image so the bar changes with it.
set -uo pipefail

instant=0 resolve=0
case "${1:-}" in
    --instant) instant=1; shift ;;
    --resolve) resolve=1; shift ;;
esac
arg="${1:-}"
[ -n "$arg" ] || { echo "usage: wallpaper-set [--instant|--resolve] NAME|PATH" >&2; exit 2; }

WALL_DIR="$HOME/Images/Wallpapers"
conf="$HOME/.config/prisme/wallpapers.conf"
if [ -f "$conf" ]; then
    configured="$(grep -vE '^[[:space:]]*(#|$)' "$conf" | head -n1)"
    [ -n "$configured" ] && WALL_DIR="${configured/#\~\//$HOME/}"
fi
CACHE_DIR="$HOME/.cache/filtered_wallpapers"

name="$(basename "$arg")"
case "$arg" in
    "$CACHE_DIR"/*) source="$WALL_DIR/$name" ;;   # a playlist from before the split
    */*)            source="$arg" ;;
    *)              source="$WALL_DIR/$name" ;;
esac

# DIR/STEM.<image extension>, if there is one.
image_named() {
    local f
    for f in "$1/$2".*; do
        [ -f "$f" ] && [ "${f%.*}" = "$1/$2" ] || continue
        case "${f##*.}" in
            [Jj][Pp][Gg]|[Jj][Pp][Ee][Gg]|[Pp][Nn][Gg]|[Ww][Ee][Bb][Pp]|[Jj][Xx][Ll]) printf '%s\n' "$f"; return 0 ;;
        esac
    done
    return 1
}

# The pair's light and dark files, then the one the colour scheme asks for.
dir="${source%/*}" stem="${name%.*}"
base="${stem%-dark}"
if light="$(image_named "$dir" "$base")" && dark="$(image_named "$dir" "$base-dark")"; then
    if gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | grep -q prefer-dark; then
        source="$dark"
    else
        source="$light"
    fi
    name="${source##*/}"
fi

[ -e "$source" ] || { echo "wallpaper-set: $source not found" >&2; exit 1; }
[ "$resolve" = 1 ] && { printf '%s\n' "$source"; exit 0; }

if ! pidof awww-daemon >/dev/null; then
    awww-daemon >/dev/null 2>&1 &
    sleep 0.5
fi

if [ "$instant" = 1 ]; then
    transition=(--transition-type none)
    transition_ms=0
else
    transition=(--transition-type fade --transition-bezier .4,0,.2,1
                --transition-fps 60 --transition-duration 1.5)
    transition_ms=1500
fi

# name<TAB>WxH per screen, rotated screens swapped to their real shape.
screens="$(hyprctl monitors -j 2>/dev/null | jq -r '.[] |
    (if (.transform % 2) == 1 then "\(.height)x\(.width)" else "\(.width)x\(.height)" end) as $res |
    "\(.name)\t\($res)"' 2>/dev/null)"

# Each screen's file first, so the tint can go out before the image does.
# The bar sits on every screen but reads one tint: the internal panel's
# image when there is one, else the first screen's.
tint_source="$source"
plan=()
if [ -n "$screens" ]; then
    first=1
    while IFS=$'\t' read -r output res; do
        file="$CACHE_DIR/$res/$name"
        [ -f "$file" ] || file="$source"
        plan+=("$output" "$file")
        if [ "$first" = 1 ] || [[ "$output" == eDP* || "$output" == LVDS* || "$output" == DSI* ]]; then
            tint_source="$file"; first=0
        fi
    done <<< "$screens"
fi

# The tint is sampled BEFORE the image (~0.25 s) into a side file, and
# published the moment awww has started: the bar eases its ink and veil
# over the transition's own length, on the same frame as the wallpaper.
# Sampled after awww, the bar lagged the fade; published before it, the
# bar moved ahead of the wallpaper.
tint_out="$HOME/.cache/bar-tint.json"
tint_next="$tint_out.next"
"$HOME/.config/hypr/scripts/bar-tint.py" --transition "$transition_ms" --out "$tint_next" "$tint_source" \
    >/dev/null 2>"$HOME/.cache/bar-tint.log"

if [ ${#plan[@]} -eq 0 ]; then
    # Outside a Hyprland session: one image for whatever awww drives.
    awww img "$source" "${transition[@]}"
else
    for ((i = 0; i < ${#plan[@]}; i += 2)); do
        awww img -o "${plan[i]}" "${plan[i+1]}" "${transition[@]}"
    done
fi

# Written in place, not renamed over: the bar watches this file, and a
# rename would hand it a new inode to lose track of.
if [ -s "$tint_next" ]; then
    cat "$tint_next" > "$tint_out"
    rm -f "$tint_next"
fi
