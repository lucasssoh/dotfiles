#!/usr/bin/env bash
# coucou-open — launch the application that fills a role, whatever it is.
#
#   coucou-open terminal [--class CLASS] [-- COMMAND...]
#   coucou-open browser [URL]
#   coucou-open files [DIR]
#   coucou-open --print ROLE ...    print the command instead of running it
#
# terminal  xdg-terminal-exec, which follows ~/.config/xdg-terminals.list
#           (one desktop id per line, e.g. kitty.desktop). With no such list,
#           WezTerm when installed.
#           --class sets the window class, for window rules (floating TUIs):
#           passed with each terminal's own flag, since most terminals'
#           desktop entries do not declare one for xdg-terminal-exec.
# browser   the default web browser (xdg-settings).
# files     the default handler of directories (xdg-mime inode/directory).
#
# Every role falls back to something that works when its standard piece is
# missing, so a key binding never does nothing.
set -uo pipefail

print=0
[ "${1:-}" = "--print" ] && { print=1; shift; }
role="${1:-}"; shift || true

run() {
    if [ "$print" = 1 ]; then printf '%q ' "$@"; echo; exit 0; fi
    exec "$@"
}
have() { command -v "$1" >/dev/null 2>&1; }

# Terminals this script knows, as desktop id → binary.
declare -A TERM_BIN=(
    [org.wezfurlong.wezterm.desktop]=wezterm
    [kitty.desktop]=kitty
    [foot.desktop]=foot
    [Alacritty.desktop]=alacritty
    [com.mitchellh.ghostty.desktop]=ghostty
    [org.gnome.Ptyxis.desktop]=ptyxis
)

# Has the user (or the admin) said which terminal they want? Only config
# dirs count, not the distro's own list under /usr/share, which orders nothing.
terminal_preference() {
    local dir desktop
    desktop="$(echo "${XDG_CURRENT_DESKTOP:-}" | tr '[:upper:]' '[:lower:]')"
    local dirs="${XDG_CONFIG_HOME:-$HOME/.config}:${XDG_CONFIG_DIRS:-/etc/xdg}"
    local IFS=:
    for dir in $dirs; do
        [ -f "$dir/xdg-terminals.list" ] && return 0
        [ -n "$desktop" ] && [ -f "$dir/$desktop-xdg-terminals.list" ] && return 0
    done
    return 1
}

terminal_id() {
    # No preference expressed: coucou-shell's own terminal when installed.
    if ! terminal_preference && have wezterm; then
        echo org.wezfurlong.wezterm.desktop
        return
    fi
    if have xdg-terminal-exec; then
        xdg-terminal-exec --print-id 2>/dev/null && return
    fi
    local id
    for id in org.wezfurlong.wezterm.desktop kitty.desktop foot.desktop Alacritty.desktop com.mitchellh.ghostty.desktop; do
        have "${TERM_BIN[$id]}" && { echo "$id"; return; }
    done
    return 1
}

case "$role" in
terminal)
    class=""
    if [ "${1:-}" = "--class" ]; then class="$2"; shift 2; fi
    [ "${1:-}" = "--" ] && shift
    id="$(terminal_id)" || { notify-send "coucou-open" "No terminal installed" 2>/dev/null; exit 1; }
    bin="${TERM_BIN[$id]:-}"

    # With a preference, xdg-terminal-exec honours it and the terminal's
    # own desktop entry; without one, the known binary is launched directly.
    if [ -z "$class" ] && have xdg-terminal-exec && terminal_preference; then
        run xdg-terminal-exec ${1:+--} "$@"
    fi
    case "$bin" in
        wezterm)   run wezterm start ${class:+--class "$class"} ${1:+--} "$@" ;;
        kitty)     run kitty ${class:+--class "$class"} "$@" ;;
        foot)      run foot ${class:+--app-id "$class"} "$@" ;;
        alacritty) run alacritty ${class:+--class "$class"} ${1:+-e} "$@" ;;
        ghostty)   run ghostty ${class:+--class="$class"} ${1:+-e} "$@" ;;
        *)         run xdg-terminal-exec ${class:+--app-id="$class"} ${1:+--} "$@" ;;
    esac
    ;;
browser)
    id="$(xdg-settings get default-web-browser 2>/dev/null)"
    if [ -n "$id" ] && have gtk-launch; then
        run gtk-launch "$id" "$@"
    fi
    for b in firefox brave-browser chromium; do
        have "$b" && run "$b" "$@"
    done
    notify-send "coucou-open" "No web browser installed" 2>/dev/null
    exit 1
    ;;
files)
    dir="${1:-$HOME}"
    id="$(xdg-mime query default inode/directory 2>/dev/null)"
    if [ -n "$id" ] && have gtk-launch; then
        run gtk-launch "$id" "$dir"
    fi
    have nemo && run nemo "$dir"
    run xdg-open "$dir"
    ;;
*)
    echo "usage: coucou-open [--print] terminal [--class CLASS] [-- COMMAND...] | browser [URL] | files [DIR]" >&2
    exit 2
    ;;
esac
