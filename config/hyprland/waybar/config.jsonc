{
    // ============================================================
    // BAR
    // ============================================================

    "layer": "top",
    "position": "top",
    "height": 24,
    "margin-top": 6,
    "margin-left": 6,
    "margin-right": 6,
    "spacing": 0,

    // ============================================================
    // MODULE LAYOUT
    // ============================================================

    "modules-left": [
        "clock",
        "hyprland/workspaces",
        "hyprland/window"
    ],

    "modules-center": [
        "mpris"
    ],

    "modules-right": [
        "custom/apps",
        "cpu",
        "temperature",
        "custom/fan",
        "memory",
        "custom/display",
        "custom/hdr",
        "network",
        "bluetooth",
        "pulseaudio#output",
        "pulseaudio#input",
        "battery",
        "custom/performance",
        "custom/power"
    ],

    // ============================================================
    // LEFT MODULES
    // ============================================================

    // -- Clock ------------------------------------------------------
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<big>{:%A, %d %B %Y - %H:%M}</big>"
    },

    // ── Workspaces ───────────────────────────────────────────────
    "hyprland/workspaces": {
        "format": "{id}",
        "all-outputs": false,
        "disable-scroll-wraparound": true
    },

    // ── Active Window ────────────────────────────────────────────
    "hyprland/window": {
        "format": "<span foreground='#4fefff'>{initialTitle}</span> <span foreground='#48484a'>·</span> <span foreground='#f2f2f7'>{title}</span>",
        "format-empty": "",
        "max-length": 45,
        "separate-outputs": true,
        "offscreen-css": true,
        "justify": "center"
    },

    // ============================================================
    // CENTER MODULES
    // ============================================================

    // ── Media ────────────────────────────────────────────────────
    // Just an indicator that something is playing -- full title/artist and
    // controls live in the notification center (quickshell's
    // NotificationCenter.qml).
    "mpris": {
        // Static truncation (native, no scroll -- a marquee needs a fast
        // poll loop even while idle, not worth the battery cost). "…"
        // ellipsis on overflow.
        "format": "{player_icon}  {title}",
        "format-paused": "{player_icon}  {title}",
        "title-len": 28,
        "ellipsis": "…",
        "max-length": 32,
        "player-icons": {
            "spotify": "󰓇",
            "firefox": "󰗃",
            "mpv*": "󰎁",
            "default": "󰎈"
        },
        "tooltip-format": "{title} · {artist}"
    },

    // ============================================================
    // RIGHT MODULES
    // ============================================================

    // ── Running Apps ─────────────────────────────────────────────
    "custom/apps": {
        "exec": "~/.config/waybar/scripts/apps.sh",
        "interval": 5,
        "tooltip": false
    },

    // ── CPU ──────────────────────────────────────────────────────
    "cpu": {
        "format": "  {usage:>3} {max_frequency:.1f}",
        "min-length": 10,
        "states": {
            "critical": 90
        }
    },

    // ── Temperature ──────────────────────────────────────────────
    "temperature": {
        "format": "󰔏 {temperatureC:>3}",
        "min-length": 5,
        "critical-threshold": 85
    },

    // ── Fans ─────────────────────────────────────────────────────
    "custom/fan": {
        "exec": "~/.config/waybar/scripts/fan.sh",
        "interval": 10,
        "min-length": 6
    },

    // ── Memory ───────────────────────────────────────────────────
    "memory": {
        "format": "󰘚 {used:0.1f}G",
        "min-length": 6,
        "states": {
            "critical": 90
        }
    },

    // ── Network ──────────────────────────────────────────────────
    "network": {
        "interval": 5,

        "format-wifi": "{icon}  {bandwidthDownOctets:4}",
        "format-ethernet": "󰈀  {bandwidthDownOctets:4}",

        // Fixed display when nothing is connected
        "format-disconnected": "󰤭  ----o/s",
        "format-disabled": "󰤭  ----o/s",

        "tooltip-format": "{essid} ({signalStrength}%)",
        "on-click": "~/.config/waybar/scripts/balise-toggle.sh wifi",
        "on-click-right": "wezterm start --class nm-tui-float -- nmtui",

        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],

        // Forces a minimum length so the bar doesn't shift
        "min-length": 10
    },

    // ── Bluetooth ────────────────────────────────────────────────
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱  {device_battery_percentage}%",

        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",

        "on-click": "~/.config/waybar/scripts/balise-toggle.sh bluetooth",
        "on-click-right": "blueman-manager"
    },

    // ── Audio Output ─────────────────────────────────────────────
    "pulseaudio#output": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 ",

        "format-icons": {
            "headphone": "󰋋 ",
            "default": ["󰕿", "󰖀", "󰕾"]
        },

        "on-click": "~/.config/waybar/scripts/audio.sh output",
        "on-click-right": "pavucontrol",
        "scroll-step": 5
    },

    // ── Audio Input ──────────────────────────────────────────────
    "pulseaudio#input": {
        "format": "{format_source}",
        "format-source": "󰍬 {volume}%",
        "format-source-muted": "󰍭 ---",

        // Mute stays on XF86AudioMicMute (keyboard); clicking opens the
        // default mic picker (right-click = advanced pavucontrol)
        "on-click": "~/.config/waybar/scripts/audio.sh input",
        "on-click-right": "pavucontrol",

        // Mic volume control
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",

        "scroll-step": 5
    },

    // ── Display layout ────────────────────────────────────
    "custom/display": {
        "exec": "~/.config/hypr/scripts/display-layout.sh status",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.config/hypr/scripts/display-layout.sh roue-gen && $HOME/.local/bin/roue display",
        "signal": 4
    },

    // ── HDR Toggle ───────────────────────────────────────────────
    "custom/hdr": {
        "exec": "~/.config/waybar/scripts/hdr.sh status",
        "return-type": "json",
        "interval": 3,
        "on-click": "~/.config/waybar/scripts/hdr.sh toggle",
        "on-click-right": "~/.config/waybar/scripts/hdr.sh menu",
        "signal": 3
    },

    // ── Performance Profile ──────────────────────────────────────
    "custom/performance": {
        "exec": "~/.config/waybar/scripts/performance.sh",
        "return-type": "json",
        "interval": 10,
        "on-click": "~/.config/waybar/scripts/performance.sh roue-gen && $HOME/.local/bin/roue powerprofile",
        "signal": 1
    },

    // ── Battery ──────────────────────────────────────────────────
    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": [
            "󰁺","󰁻","󰁼","󰁽","󰁾",
            "󰁿","󰂀","󰂁","󰂂","󰁹"
        ]
    },

    // Notifications used to live here (swaync's waybar module) -- gone
    // now that quickshell owns notifications natively (see
    // quickshell/bar/modules/NotificationBell.qml). This file is a
    // dormant fallback already (waybar isn't started, see
    // hypr/hyprland.lua), kept in sync mostly for hygiene.

    // ── Power ────────────────────────────────────────────────────
    "custom/power": {
        "format": "⏻",
        "on-click": "$HOME/.local/bin/roue power"
    }
}
