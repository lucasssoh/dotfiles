{
    "layer": "top",
    "position": "top",
    "height": 24,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 12,
    "spacing": 0,
    "modules-left": [
        "hyprland/window"
    ],
    "modules-center": [
        "mpris"
    ],
    "modules-right": [
        "hyprland/workspaces",
        "clock",
        "cpu",
        "temperature",
        "custom/fan",
        "memory",
        "network",
        "bluetooth",
        "pulseaudio#output",
        "pulseaudio#input",
        "custom/performance",
        "battery",
        "custom/power"
    ],

    "hyprland/window": {
        "format": "{initialTitle}:{title}",
        "max-length": 35,
        "separate-outputs": true,
        "offscreen-css": true,
        "rewrite": {
                "^:$": "", 
                "^:(.*)$": "$1",
                "(.*):$": "$1"
            }
    },

    // ── Performance Profile ────────────────────────
    "custom/performance": {
        "exec": "~/.config/waybar/scripts/performance.sh",
        "return-type": "json",
        "interval": 10,
        "on-click": "~/.config/waybar/scripts/rofi-performance.sh",
        "signal": 1
    },

    // ── Média ───────────────────────────────────────
    "mpris": {
        "format": "{player_icon}  {title} · {artist}",
        "format-paused": "-  {title} · {artist}",
        "player-icons": {
            "spotify": "󰓇",
            "firefox": "󰗃",
            "mpv": "󰎁",
            "default": "󰎈"
        },
        "max-length": 60
    },

    // ── Workspaces ─────────────────────────────────────────────────────
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "active": "●",
            "default": "●",
            "empty": "○"
        },
        "persistent-workspaces": { "*": 5 }
    },


    // ── WiFi ───────────────────────────────────────────────────────────
    "network": {
        "interval": 5,
        // :4 force une largeur de 4 caractères pour éviter que la barre bouge
        "format-wifi": "󰤨 {bandwidthDownOctets:4}",
        "format-ethernet": "󰈀 {bandwidthDownOctets:4}",
        // Affichage fixe quand rien n'est connecté
        "format-disconnected": "󰤭 ----o/s", 
        "format-disabled": "󰤭 ----o/s",
        "tooltip-format": "{essid}",
        "on-click": "wezterm start --class nm-tui-float -- nmtui",
        "min-length": 10, // Force une longueur minimale de caractères
        "fixed-width": true
    },

    // ── Bluetooth ──────────────────────────────────────────────────────
    "bluetooth": {
        "format": "󰂯", // Icône de déconnexion (quand BT est ON mais rien n'est lié)
        "format-disabled": "󰂲", // Icône quand le BT est éteint logiciellement
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱 {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "wezterm start --class bt-tui-float -- bluetuith" 
    },

    // ── Batterie ───────────────────────────────────────────────────────
    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"]
    },

    // ── Horloge ────────────────────────────────────────────────────────
    "clock": {
        "format": "{:%d/%m %H:%M}"
    },

    // ── Sortie Audio (Haut-parleurs/Casque) ──────────────────────────
    "pulseaudio#output": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 ",

        "format-icons": {
            "headphone": "󰋋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },

        "on-click": "wezterm start --class audio-tui-float -- wiremix",
        "on-click-right": "pavucontrol",
        "scroll-step": 5
    },

    // ── Entrée Audio (Microphone) ────────────────────────────────────
    "pulseaudio#input": {
        "format": "{format_source}",
        "format-source": "󰍬 {volume}%",
        "format-source-muted": "󰍭 ---",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-click-right": "pavucontrol",
        
        // Gestion du volume du micro au scroll
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
        "scroll-step": 5
    },

    // ── System ─────────────────────────────────────────────────────────
    "cpu": {
        "format": "cpu {usage:02}% {max_frequency:.2f}Ghz"
    },
    "temperature": {
        "format": "tmp {temperatureC}°"
    },
    "memory": {
        "format": "ram {percentage:02}%"
    },

    // ── Fans (Corrigé : 2 -> 10) ───────────────────────────────────────
    "custom/fan": {
        "exec": "~/.config/waybar/scripts/fan.sh",
        "interval": 10
    },

    // ── Power ──────────────────────────────────────────────────────────
    "custom/power": {
        "format": "⏻",
        "on-click": "~/.config/waybar/scripts/rofi-power.sh"
    }
}
