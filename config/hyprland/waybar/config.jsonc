{
    "layer": "top",
    "position": "top",
    "height": 24,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 12,
    "spacing": 0,
    "modules-left": [
        "custom/window"
    ],
    "modules-center": [
        "custom/media"
    ],
    "modules-right": [
        "hyprland/workspaces",
        "clock",
        "custom/netspeed",
        "cpu",
        "temperature",
        "custom/fan",
        "memory",
        "network",
        "bluetooth",
        "pulseaudio",
        "custom/mic",
        "custom/performance",
        "battery",
        "custom/power"
    ],

    // ── Fenêtre Active (Corrigé : interval 0 -> 1 pour stopper le spam) ─
    "custom/window": {
        "exec": "~/.config/waybar/scripts/window.sh",
        "return-type": "json",
        "interval": 1,
        "on-click": "~/.config/waybar/scripts/rofi-launcher.sh"
    },

    // ── Performance Profile (Corrigé : 5 -> 10) ────────────────────────
    "custom/performance": {
        "exec": "~/.config/waybar/scripts/performance.sh",
        "return-type": "json",
        "interval": 10,
        "on-click": "~/.config/waybar/scripts/rofi-performance.sh",
        "signal": 1
    },

    // ── Microphone (Corrigé : interval 5 + signal instantané au clic) ──
    "custom/mic": {
        "exec": "~/.config/waybar/scripts/mic-status.sh",
        "return-type": "json",
        "interval": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle && pkill -RTMIN+10 waybar",
        "signal": 10,
        "tooltip": false
    },

    // ── Média (Corrigé : 1 -> 3) ───────────────────────────────────────
    "custom/media": {
        "exec": "~/.config/waybar/scripts/media.sh",
        "return-type": "json",
        "max-length": 60,
        "interval": 3,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous"
    },

    // ── Workspaces ─────────────────────────────────────────────────────
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "active": "●",
            "default": "●",
            "empty": "○"
        },
        "persistent-workspaces": { "*": 5 }
    },

    // ── Réseau vitesse (Corrigé : 2 -> 5) ──────────────────────────────
    "custom/netspeed": {
        "exec": "~/.config/waybar/scripts/netspeed.sh",
        "interval": 5,
        "format": "{}",
        "max-length": 15,
        "min-length": 15
    },

    // ── WiFi ───────────────────────────────────────────────────────────
    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-disconnected": "󰤭 off",
        "on-click": "~/.config/waybar/scripts/rofi-wifi.sh"
    },

    // ── Bluetooth ──────────────────────────────────────────────────────
    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱 {device_battery_percentage}%",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "~/.config/waybar/scripts/rofi-bluetooth.sh"
    },

    // ── Batterie ───────────────────────────────────────────────────────
    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"]
    },

    // ── Horloge ────────────────────────────────────────────────────────
    "clock": {
        "format": "{:%d/%m  |  %H:%M}"
    },

    // ── Audio ──────────────────────────────────────────────────────────
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 muet",
        "format-icons": {
            "default": ["󰕿","󰖀","󰕾"]
        },
        "on-click": "~/.config/waybar/scripts/rofi-audio.sh",
        "on-click-right": "pavucontrol"
    },

    // ── System ─────────────────────────────────────────────────────────
    "cpu": {
        "format": "cpu {usage:02}% {max_frequency:.1f}Ghz"
    },
    "temperature": {
        "format": "tmp {temperatureC}°"
    },
    "memory": {
        "format": "ram {percentage:02}%"
    },

    // ── Fans (Corrigé : 2 -> 10) ───────────────────────────────────────
    "custom/fan": {
        "exec": "~/.config/waybar/scripts/fan.sh",
        "interval": 10
    },

    // ── Power ──────────────────────────────────────────────────────────
    "custom/power": {
        "format": "⏻",
        "on-click": "~/.config/waybar/scripts/rofi-power.sh"
    }
}
