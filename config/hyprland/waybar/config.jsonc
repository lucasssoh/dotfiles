{
    // ============================================================
    // BAR
    // ============================================================

    "layer": "top",
    "position": "top",
    "height": 24,
    "margin-top": 8,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 0,

    // ============================================================
    // MODULE LAYOUT
    // ============================================================

    "modules-left": [
        "custom/logo",
        "hyprland/workspaces",
        "custom/gap",
        "hyprland/window"
    ],

    "modules-center": [
        "mpris"
    ],

    "modules-right": [
        "custom/apps",
        "clock",
        "cpu",
        "temperature",
        "custom/fan",
        "memory",
        "network",
        "bluetooth",
        "pulseaudio#output",
        "pulseaudio#input",
        "custom/hdr",
        "custom/performance",
        "battery",
        "custom/power"
    ],

    // ============================================================
    // LEFT MODULES
    // ============================================================

    //--- lock waybar ---------------------------------------------
    "custom/logo": {
        "format": "",
        "tooltip": false
    },
    


    // ── Workspaces ───────────────────────────────────────────────
    "hyprland/workspaces": {
        "format": "{id}",
        "all-outputs": false,
        "disable-scroll-wraparound": true
    },

    // --- Gap -----------------------------------------------------
    "custom/gap": {
        "format": " " // <-- Modifié ici (vide pour être invisible, sert uniquement de bordure droite)
    },

    // ── Active Window ────────────────────────────────────────────
    "hyprland/window": {
        "format": "<span foreground='#4fefff'>{initialTitle}</span> <span foreground='#48484a'>·</span> <span foreground='#f2f2f7'>{title}</span>",
        "format-empty": "",
        "max-length": 35,
        "separate-outputs": true,
        "offscreen-css": true,
        "justify": "center"
    },

    // ============================================================
    // CENTER MODULES
    // ============================================================

    // ── Media ────────────────────────────────────────────────────
    "mpris": {
        "format": "{player_icon}  {title} · {artist}",
        "format-paused": "-  {title} · {artist}",
        "player-icons": {
            "spotify": "󰓇",
            "firefox": "󰗃",
            "mpv*": "󰎁",
            "default": "󰎈"
        },
        "max-length": 60
    },

    // ============================================================
    // RIGHT MODULES
    // ============================================================

    // ── Running Apps ─────────────────────────────────────────────
    "custom/apps": {
        "exec": "~/.config/waybar/scripts/apps.sh",
        "interval": 5,
        "tooltip": false
    },

    // ── Clock ────────────────────────────────────────────────────
    "clock": {
        "format": "{:%d/%m/%y  %H:%M}",
        "tooltip-format": "<big>{:%A, %d %B %Y - %H:%M}</big>"
    },

    // ── CPU ──────────────────────────────────────────────────────
    "cpu": {
        "format": "  cpu {usage:02}% - {max_frequency:.2f}Ghz"
    },

    // ── Temperature ──────────────────────────────────────────────
    "temperature": {
        "format": "󰔏 tmp {temperatureC}°"
    },

    // ── Fans ─────────────────────────────────────────────────────
    "custom/fan": {
        "exec": "~/.config/waybar/scripts/fan.sh",
        "interval": 10
    },

    // ── Memory ───────────────────────────────────────────────────
    "memory": {
        "format": "󰘚  ram {percentage:02}%"
    },

    // ── Network ──────────────────────────────────────────────────
    "network": {
        "interval": 5,

        "format-wifi": "{icon}  {bandwidthDownOctets:4}",
        "format-ethernet": "󰈀  {bandwidthDownOctets:4}",

        // Affichage fixe quand rien n'est connecté
        "format-disconnected": "󰤭  ----o/s",
        "format-disabled": "󰤭  ----o/s",

        "tooltip-format": "{essid} ({signalStrength}%)",
        "on-click": "wezterm start --class nm-tui-float -- nmtui",

        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],

        // Force une longueur minimale pour éviter que la barre bouge
        "min-length": 10,
        "fixed-width": true
    },

    // ── Bluetooth ────────────────────────────────────────────────
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱  {device_battery_percentage}%",

        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",

        "on-click": "wezterm start --class bt-tui-float -- bluetuith"
    },

    // ── Audio Output ─────────────────────────────────────────────
    "pulseaudio#output": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 ",

        "format-icons": {
            "headphone": "󰋋 ",
            "default": ["󰕿", "󰖀", "󰕾"]
        },

        "on-click": "wezterm start --class audio-tui-float -- wiremix",
        "on-click-right": "pavucontrol",
        "scroll-step": 5
    },

    // ── Audio Input ──────────────────────────────────────────────
    "pulseaudio#input": {
        "format": "{format_source}",
        "format-source": "󰍬 {volume}%",
        "format-source-muted": "󰍭 ---",

        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-click-right": "pavucontrol",

        // Gestion du volume du micro
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",

        "scroll-step": 5
    },

    // ── HDR Toggle ───────────────────────────────────────────────
    "custom/hdr": {
        "exec": "~/.config/waybar/scripts/hdr.sh status",
        "return-type": "json",
        "interval": 3,
        "on-click": "~/.config/waybar/scripts/hdr.sh toggle",
        "on-click-right": "~/.config/waybar/scripts/hdr.sh menu",
        "signal": 3
    },

    // ── Performance Profile ──────────────────────────────────────
    "custom/performance": {
        "exec": "~/.config/waybar/scripts/performance.sh",
        "return-type": "json",
        "interval": 10,
        "on-click": "~/.config/waybar/scripts/rofi-performance.sh",
        "signal": 1
    },

    // ── Battery ──────────────────────────────────────────────────
    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": [
            "󰁺","󰁻","󰁼","󰁽","󰁾",
            "󰁿","󰂀","󰂁","󰂂","󰁹"
        ]
    },

    // ── Power ────────────────────────────────────────────────────
    "custom/power": {
        "format": "⏻",
        "on-click": "~/.config/waybar/scripts/rofi-power.sh"
    }
}
