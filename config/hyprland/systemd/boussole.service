# Boussole: the study planner behind the bar's Boussole drawer. Plans from
# the course folder and the timetable, rings the session alerts and follows
# sessions through Liseuse; talks to the bar over
# $XDG_RUNTIME_DIR/boussole.sock. Idle, it sleeps in poll(2) until the next
# alert, timetable download or file change.
[Unit]
Description=Boussole — study planner behind the bar's Boussole drawer
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/boussole daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
