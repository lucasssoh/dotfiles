[Unit]
Description=Workspace Dashboard (fastfetch + clock on empty workspaces)
After=graphical-session.target

[Service]
Type=simple
ExecStartPre=/bin/sleep 3
ExecStart=%h/.config/hypr/scripts/workspace-dashboard.sh
Restart=on-failure
RestartSec=3
PassEnvironment=WAYLAND_DISPLAY DISPLAY XDG_RUNTIME_DIR HYPRLAND_INSTANCE_SIGNATURE DBUS_SESSION_BUS_ADDRESS

[Install]
WantedBy=default.target
