[Unit]
Description=Workspace Dashboard (fastfetch + clock on empty workspaces)
After=graphical-session.target

[Service]
Type=simple
ExecStartPre=/bin/sleep 3
ExecStart=%h/.config/hypr/scripts/workspace-dashboard.sh
Restart=on-failure
RestartSec=3
PassEnvironment=WAYLAND_DISPLAY DISPLAY XDG_RUNTIME_DIR HYPRLAND_INSTANCE_SIGNATURE DBUS_SESSION_BUS_ADDRESS

# Disabled on purpose: no [Install] section, so install.sh's blanket
# `systemctl --user enable` over systemd/*.service is a no-op for this
# unit instead of silently turning the dashboard back on. To bring it
# back: restore the two lines below and `systemctl --user enable --now`.
# [Install]
# WantedBy=default.target
