# Balise's BACKEND only: NetworkManager/BlueZ logic behind a Unix socket
# at $XDG_RUNTIME_DIR/balise.sock. It draws nothing -- the panel is QML,
# in quickshell/bar/modules/balise/, and reads that socket directly (see
# quickshell/bar/services/BaliseState.qml). The same binary's `toggle`
# subcommand opens a legacy GTK window that nothing here starts.
[Unit]
Description=Balise — démon WiFi/Bluetooth/Ethernet (backend du panneau QML)
After=graphical-session.target

[Service]
Type=simple
ExecStartPre=/bin/sleep 3
ExecStart=%h/.local/bin/balise daemon
Restart=on-failure
RestartSec=3
PassEnvironment=WAYLAND_DISPLAY DISPLAY XDG_RUNTIME_DIR HYPRLAND_INSTANCE_SIGNATURE DBUS_SESSION_BUS_ADDRESS

[Install]
WantedBy=graphical-session.target
