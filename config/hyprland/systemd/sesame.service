# Sésame: the session's polkit agent, and the daemon behind the bar's
# password card for ssh, git and gpg. Talks to the bar over
# $XDG_RUNTIME_DIR/sesame.sock. Idle, it sleeps in poll(2).
[Unit]
Description=Sésame — password prompts behind the bar's card
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/sesame
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
