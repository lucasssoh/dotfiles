{
    "enabled": true,
    "language": "fr",

    "monitor": "",

    "showSeconds": true,
    "showDate": false,

    "messageIntervalMinutes": 20,
    "messageHoldSeconds": 25,
    "curatedRatio": 0.35,

    "pulse": { "leadSeconds": 3, "durationSeconds": 30 },

    "muteWhileGaming": false,
    "respectZenMode": true,

    "thresholds": {
        "dayStart": "05:00",
        "normal": "22:00",
        "late": "23:00",
        "midnight": "00:00",
        "veryLate": "01:00"
    },

    "phases": {
        "day": { "visible": false },
        "evening": { "visible": true },
        "late": { "visible": true },
        "midnight": { "visible": true },
        "veryLate": { "visible": true }
    },

    "appFamilies": {
        "ide": ["^jetbrains-", "^com\\.jetbrains\\."],
        "editor": ["^[Cc]ode$", "^codium$", "^dev\\.zed\\.Zed$"],
        "terminal": ["wezterm", "^kitty$", "^Alacritty$"],
        "browser": ["firefox", "brave-browser", "chromium", "google-chrome"],
        "reader": ["zathura", "evince", "okular"],
        "media": ["^mpv$", "^vlc$"],
        "chat": ["discord", "vesktop", "[Ss]lack"],
        "game": ["gamescope", "steam", "lutris", "heroic"]
    },

    "tokenPatterns": {
        "ide": ["[–-]\\s*([^/\\\\]+\\.[A-Za-z0-9]+)\\s*$"],
        "editor": ["^([^/\\\\]+\\.[A-Za-z0-9]+)\\b"],
        "terminal": ["^([^/\\\\]+\\.[A-Za-z0-9]+)\\s*[–-]\\s*NVIM\\b"],
        "reader": ["^([^/\\\\]+\\.pdf)$"]
    },

    "debug": false
}
