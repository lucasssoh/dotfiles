/* ~/.config/rofi/wallpaper.rasi — wallpaper icon grid.
 * Colors and selection style inherited from share.rasi; layout only here. */
@import "share.rasi"

configuration {
    show-icons: true;
}

window {
    width:   820px;
    height:  700px;
    padding: 18px;
}

mainbox {
    spacing:  14px;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 12px 16px;
}

entry {
    placeholder: "Search wallpaper...";
}

listview {
    columns:       3;
    lines:         2;
    flow:          horizontal;
    fixed-height:  true;
    fixed-columns: true;
    cycle:         false;
    spacing:       16px;
}

element {
    orientation: vertical;
    padding:      10px;
    spacing:      10px;
}

element-icon {
    size:             210px;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    border-radius:    14px;
}

element-text {
    horizontal-align: 0.5;
}
