@import "theme"

/* password.rasi — invite de mot de passe (lock screen). Police/couleurs de
 * base héritées de share.rasi ; seule la bordure d'inputbar est mise en
 * valeur (accent cyan) pour indiquer la saisie. */

mainbox {
  children: [inputbar];
}

inputbar {
  border:        2px;
  border-color:  @active;
  padding:       6px;
  border-radius: 6px;
}

entry {
  text-color: @active;
}
