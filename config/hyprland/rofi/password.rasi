@import "theme"

/* password.rasi — password prompt (lock screen). Base font/colors
 * inherited from share.rasi; only the inputbar border is highlighted
 * (cyan accent) to indicate input. */

mainbox {
  children: [inputbar];
}

inputbar {
  border:        2px;
  border-color:  @active;
  padding:       6px;
  border-radius: 6px;
}

entry {
  text-color: @active;
}
