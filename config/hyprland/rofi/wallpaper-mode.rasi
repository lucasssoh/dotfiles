/* wallpaper-mode.rasi — compact 2-column menu (wallpaper mode, external
 * position, alignment, display layout…). Colors/selection inherited from
 * share.rasi; layout only here. No inputbar (fixed choices, -no-custom)
 * -> the title goes through the "message" widget (-mesg on the script side). */
@import "share.rasi"

window {
    width:  400px;
    height: 160px;
}

mainbox {
    spacing:  10px;
    children: [ message, listview ];
}

listview {
    columns: 2;
    lines:   1;
    spacing: 10px;
}

element {
    padding:     16px;
    orientation: horizontal;
}

element-text {
    horizontal-align: 0.5;
}
