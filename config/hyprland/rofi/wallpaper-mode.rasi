/* wallpaper-mode.rasi — menu compact 2 colonnes (mode wallpaper, position
 * externe, alignement, disposition d'écrans…). Couleurs/sélection héritées
 * de share.rasi ; structure seule ici. Pas d'inputbar (choix fixes,
 * -no-custom) -> le titre passe par le widget "message" (-mesg côté script). */
@import "share.rasi"

window {
    width:  400px;
    height: 160px;
}

mainbox {
    spacing:  10px;
    children: [ message, listview ];
}

listview {
    columns: 2;
    lines:   1;
    spacing: 10px;
}

element {
    padding:     16px;
    orientation: horizontal;
}

element-text {
    horizontal-align: 0.5;
}
