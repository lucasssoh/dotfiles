* {
  border: 0;
  margin: 0;
  padding: 0;
  spacing: 0;

  urgent: #b0b0b0;
  active: #d0d0d0;

  bg: #111111;
  bg-alt: #1b1b1b;

  fg: #8a8a8a;
  fg-alt: #f0f0f0;
  selected: @fg-alt;
  background-color: @bg;
  text-color: @fg;
}
configuration {
  font: "Iosevka Nerd Font 12";
  terminal: "wezterm";

  combi {
    display-name: "󰍜";
  }

  drun {
    display-name: "󱓞";
  }

  run {
    display-name: "";
  }

  window {
    display-name: "";
  }

  microphone {
    display-name: "󰍬";
  }

  timeout {
    delay: 10;
    action: "kb-cancel";
  }

  filebrowser {
    display-name: "";
  }

  display-drun: "Application:";
  display-window: "Window:";
  display-filebrowser: "Files:";
  case-sensitive: false;
  sort: true;
  sorting-method: "fzf";
  modi: [
    "run",
    "drun",
    "window",
    "filebrowser"
  ];
  show-icons: true;
  terminal: "alacritty";
}

window {
    /* properties for window widget */
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       600px;
    x-offset:                    0px;
    y-offset:                    0px;

    /* properties for all widgets */
    font:                        "Iosevka Nerd Font 12";
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @selected;
    cursor:                      "default";
    background-color:            @bg;
}
