/* ~/.config/rofi/share.rasi
 *
 * Palette + base widgets SHARED BY ALL ROFI MENUS IN THE SYSTEM.
 * Reuses waybar's colors (style.css) exactly, so the bar and menus form a
 * single, consistent visual language: same background, same text, same
 * cyan highlight (the one used for the active workspace / HDR-on / etc.).
 * Every leaf theme (theme, common, wallpaper, launcher, …) imports this
 * file and should never redefine colors, only its own structure (width,
 * columns, lines). */

* {
  border:  0;
  margin:  0;
  padding: 0;
  spacing: 0;

  /* --- System palette (= waybar/style.css) --- */
  bg:      #141414;    /* background -> Main background (= waybar) */
  bg-alt:  #1e1e20;    /* surface    -> Inputbar/element fill (= waybar) */

  fg:      #8e8e93;    /* subtle     -> Unselected text / placeholder */
  fg-alt:  #f2f2f7;    /* text       -> Focused / main text (= waybar) */
  muted:   #48484a;    /* muted      -> Dimmed secondary text (= waybar) */

  border-color-base: #505050; /* overlay2 -> window border (= waybar) */
  blue:    #4f9eff;    /* blue accent -> prompts / titles (= waybar) */
  urgent:  #ff453a;    /* urgent     -> Errors/Urgent (red) */
  active:  #4fefff;    /* cyan accent -> system highlight (= waybar) */

  /* --- Agnostic variables --- */
  selected:         @active;
  background-color: @bg;
  text-color:       @fg;
}

configuration {
  font: "Iosevka Nerd Font 12";
  terminal: "wezterm";

  combi {
    display-name: "󰍜";
  }

  drun {
    display-name: "󱓞";
  }

  run {
    display-name: "";
  }

  window {
    display-name: "";
  }

  microphone {
    display-name: "󰍬";
  }

  timeout {
    delay: 10;
    action: "kb-cancel";
  }

  filebrowser {
    display-name: "";
  }

  display-drun: "Application:";
  display-window: "Window:";
  display-filebrowser: "Files:";
  case-sensitive: false;
  sort: true;
  sorting-method: "fzf";
  modi: [
    "run",
    "drun",
    "window",
    "filebrowser"
  ];
  show-icons: true;
  terminal: "alacritty";
}

window {
    /* properties for window widget */
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       600px;
    x-offset:                    0px;
    y-offset:                    0px;

    /* properties for all widgets */
    font:                        "Iosevka Nerd Font 12";
    enabled:                     true;
    margin:                      0px;
    padding:                     12px;
    border:                      1px solid;
    border-radius:                6px;
    border-color:                @border-color-base;
    cursor:                      "default";
    background-color:            @bg;
}

/* ── Base widgets: layout/colors shared by ALL menus ──
   Leaf themes only override columns/rows/width, never the colors or the
   selection style defined here. */

mainbox {
    background-color: transparent;
}

inputbar {
    background-color: @bg-alt;
    border-radius:    6px;
    padding:           10px 12px;
    spacing:           8px;
    children:          [ prompt, entry ];
}

prompt {
    background-color: inherit;
    text-color:        @blue;
}

entry {
    background-color:  inherit;
    text-color:         @fg-alt;
    placeholder-color:  @fg;
}

listview {
    background-color: transparent;
    spacing:            8px;
    scrollbar:          false;
}

element {
    background-color: transparent;
    text-color:         @fg;
    border-radius:      6px;
    padding:            8px 10px;
    spacing:            10px;
    cursor:             pointer;
}

element-icon {
    background-color: transparent;
    size:                20px;
    vertical-align:      0.5;
}

element-text {
    background-color: inherit;
    text-color:          inherit;
    vertical-align:      0.5;
    horizontal-align:    0.0;
}

/* ── Selection: single recipe for the whole system ──
   ~10% cyan-tinted background + left accent bar + cyan text. */
element selected {
    background-color: #4fefff1a;
    border:            0px 0px 0px 2px;
    border-color:       @active;
    text-color:         @active;
}

/* ── Title ("message"): for menus WITHOUT a search bar
   (fixed-choice grids: power/performance/confirm/wallpaper-mode/…).
   These menus have no inputbar, so -p has nowhere to render; the scripts
   pass the title through -mesg instead. */
message {
    enabled:           true;
    padding:            10px;
    border-radius:      6px;
    background-color:  @bg-alt;
    text-color:         @fg-alt;
}

textbox {
    background-color: inherit;
    text-color:         inherit;
    vertical-align:     0.5;
    horizontal-align:   0.5;
    placeholder-color:  @fg;
    blink:              true;
    markup:             true;
}

error-message {
    padding:            12px;
    border-radius:      6px;
    background-color:  @bg;
    text-color:         @fg-alt;
}
