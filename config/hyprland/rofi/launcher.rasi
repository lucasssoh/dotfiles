/* rofi/launcher.rasi — search bar (drun / launcher, powermenu…).
 * Colors and selection style inherited from share.rasi; layout only here. */
@import "share"

window {
    width: 520px;
}

inputbar {
    margin: 0px 0px 10px 0px;
}

prompt {
    margin: 0px 8px 0px 0px;
}

entry {
    placeholder: "Search...";
}

listview {
    lines:         8;
    fixed-columns: true;
}

element-icon {
    size:           24px;
    vertical-align: 0.5;
}

element urgent {
    text-color: @urgent;
}

element normal.urgent {
    text-color: @urgent;
}
