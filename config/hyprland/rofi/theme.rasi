@import "share"

/* theme.rasi — menus "liste avec recherche" (hdr, scale, wifi, mic,
 * password, launcher…). Couleurs et style de sélection hérités de
 * share.rasi ; ce fichier ne pose que la structure (largeur, lignes). */

window {
  transparency: "real";
  width: 700px;
}

mainbox {
  children: [inputbar, listview];
}

inputbar {
  children: [prompt, entry];
}

entry {
  padding: 12px 3px;
}

prompt {
  padding: 12px;
}

listview {
  lines: 8;
}

element {
  children: [element-icon, element-text];
}

element-icon {
  padding: 10px 10px;
  size: 20px;
}

element-text {
  padding: 10px 0;
}
