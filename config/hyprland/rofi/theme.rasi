@import "share"

/* theme.rasi — "list with search" menus (hdr, scale, wifi, mic,
 * password, launcher…). Colors and selection style inherited from
 * share.rasi; this file only sets the structure (width, lines). */

window {
  transparency: "real";
  width: 700px;
}

mainbox {
  children: [inputbar, listview];
}

inputbar {
  children: [prompt, entry];
}

entry {
  padding: 12px 3px;
}

prompt {
  padding: 12px;
}

listview {
  lines: 8;
}

element {
  children: [element-icon, element-text];
}

element-icon {
  padding: 10px 10px;
  size: 20px;
}

element-text {
  padding: 10px 0;
}
