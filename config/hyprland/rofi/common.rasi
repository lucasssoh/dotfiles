@import                         "share"

/* common.rasi — base des menus "grille de boutons" (performance/power/confirm).
 * Couleurs, sélection et style du titre ("message") hérités de share.rasi ;
 * ce fichier ne pose que la disposition (grille, espacements). */

configuration {
    show-icons:                 false;
}

/*
USE_BUTTONS=YES
*/

mainbox {
    enabled:                     true;
    spacing:                     0px;
    padding:                     0px;
    background-color:            transparent;
    children:                    [ "message", "listview" ];
}

listview {
    enabled:                     true;
    columns:                     5;
    lines:                       1;
    cycle:                       true;
    dynamic:                     true;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    padding:                     10px;
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    horizontal-align:            0.5;
    padding:                     16px 8px;
}

element-text {
    horizontal-align:            0.5;
}
