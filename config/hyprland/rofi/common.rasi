@import                         "share"

/* common.rasi — base for "button grid" menus (performance/power/confirm).
 * Colors, selection, and title ("message") style inherited from
 * share.rasi; this file only sets the layout (grid, spacing). */

configuration {
    show-icons:                 false;
}

/*
USE_BUTTONS=YES
*/

mainbox {
    enabled:                     true;
    spacing:                     0px;
    padding:                     0px;
    background-color:            transparent;
    children:                    [ "message", "listview" ];
}

listview {
    enabled:                     true;
    columns:                     5;
    lines:                       1;
    cycle:                       true;
    dynamic:                     true;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    padding:                     10px;
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    horizontal-align:            0.5;
    padding:                     16px 8px;
}

element-text {
    horizontal-align:            0.5;
}
