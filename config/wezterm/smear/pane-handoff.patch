+    /// Ranks the corners by how aligned they are with the travel direction
+    /// (`move_dx`, `move_dy` in pixels) and gives the leading ones a shorter
+    /// duration, so they race ahead while the trailing ones lag behind.
+    fn assign_corner_speeds(&mut self, move_dx: f32, move_dy: f32, anim_length: f32, trail_size: f32) {
+        let move_dist = move_dx.hypot(move_dy);
+        if move_dist <= 0.0 {
+            return;
+        }
+        let travel_x = move_dx / move_dist;
+        let travel_y = move_dy / move_dist;
+
+        // alignment[i] = dot(corner_dir[i], travel_dir): +1 = fully leading.
+        let alignments: [f32; 4] =
+            std::array::from_fn(|i| CORNER_DIR[i].0 * travel_x + CORNER_DIR[i].1 * travel_y);
+
+        // Sort by descending alignment to assign ranks 0 (trailing) – 3 (leading).
+        let mut order = [0usize, 1, 2, 3];
+        order.sort_by(|&a, &b| {
+            alignments[b]
+                .partial_cmp(&alignments[a])
+                .unwrap_or(std::cmp::Ordering::Equal)
+        });
+        let mut ranks = [0usize; 4];
+        for (rank_from_back, &idx) in order.iter().rev().enumerate() {
+            ranks[idx] = rank_from_back;
+        }
+
+        // Duration per rank (matching Neovide's jump() logic).
+        let leading_dur = (anim_length * (1.0 - trail_size).max(0.05)).max(0.005);
+        let trailing_dur = anim_length.max(0.005);
+        for (i, corner) in self.smear_corners.iter_mut().enumerate() {
+            let dur = match ranks[i] {
+                3 | 2 => leading_dur,
+                1 => (leading_dur + trailing_dur) * 0.5,
+                _ => trailing_dur,
+            };
+            corner.speed = 0.3 / dur;
+        }
+    }
+
+    /// Starts a smear from corners drawn by *another* pane (a pane or tab
+    /// switch), given in this pane's stable pixel space.
+    ///
+    /// Leaves the state as if the cursor had always been at `current`, so the
+    /// following `update()` just ticks the corners towards it: no deferral,
+    /// no bogus jump from this pane's stale position.
+    pub fn hand_off(
+        &mut self,
+        from_corners: [(f32, f32); 4],
+        current: &StableCursorPosition,
+        cell_width: f32,
+        cell_height: f32,
+        anim_length: f32,
+        trail_size: f32,
+        cursor_shape: CursorShape,
+        now: Instant,
+    ) {
+        self.cached_corner_offsets = shape_corner_offsets(cursor_shape, cell_width, cell_height);
+        self.cached_corner_key = (cursor_shape, cell_width.to_bits(), cell_height.to_bits());
+        for (corner, (x, y)) in self.smear_corners.iter_mut().zip(from_corners) {
+            corner.snap_to(x, y);
+        }
+
+        // Travel between the centroids, which also covers a shape change
+        // (bar in one pane, block in the other).
+        let offsets = self.cached_corner_offsets;
+        let target_x = current.x as f32 * cell_width;
+        let target_y = current.y as f32 * cell_height;
+        let (mut move_dx, mut move_dy) = (0.0, 0.0);
+        for (i, (x, y)) in from_corners.iter().enumerate() {
+            move_dx += (target_x + offsets[i].0 * cell_width - x) * 0.25;
+            move_dy += (target_y + offsets[i].1 * cell_height - y) * 0.25;
+        }
+        self.assign_corner_speeds(move_dx, move_dy, anim_length, trail_size);
+
+        self.pending_jump = None;
+        self.prev_pos = *current;
+        self.prev_initialized = true;
+        self.last_tick = now;
+    }
+
     // ── Particle spawning ─────────────────────────────────────────────────────
 
     fn spawn_trail_particles(
