#!/usr/bin/env bash
# ============================================================
# liseuse — the library half of Liseuse
# ============================================================
# zathura renders pages (see zathurarc next to this file); this script is
# everything zathura deliberately doesn't do: find the books, rank them
# so the one you're in the middle of is the first thing you see, and
# bracket the session with the distraction-free state.
#
# Bound to SUPER+F (hypr/keybinds.lua). One key, three outcomes,
# depending on what's already on screen:
#
#   nothing open          -> the picker
#   a book open elsewhere -> focus it (you meant "back to my book")
#   a book already focused-> the picker (you're looking at it, so you
#                            must be after a DIFFERENT one)
#
# ---- Why there is no library database ------------------------------
# zathura already keeps one, at ~/.local/share/zathura/bookmarks.sqlite
# (see zathurarc's `database "sqlite"`). Its `fileinfo` table holds one
# row per document with the three columns this script needs -- file,
# page, and a `time` timestamp of the last open -- so Liseuse keeps NO
# state of its own about books at all.
#
# That is not just less code, it is more correct: zathura writes that row
# whether the book was opened from SUPER+F, from nemo, from Firefox's
# download list or from a terminal, and none of those go through this
# script. A private history here would have been a second copy of the
# same fact, wrong every time a book was opened any other way.
#
# So there is nothing to rebuild and nothing to go stale: every
# invocation reads the filesystem and that table, and that is all.
# ============================================================
set -Eeuo pipefail

LIBRARY_ROOT="${LISEUSE_LIBRARY:-$HOME/Livres}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/liseuse"
SOURCES_CONF="$CONFIG_DIR/sources.conf"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/liseuse"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/liseuse"
PAGES_CACHE="$CACHE_DIR/pages"
# Rendered Markdown. md2pdf.py writes <sha1-of-abspath>/<name>.pdf in
# here -- the hash is a DIRECTORY, not the filename. It is derived from
# the source path rather than its contents so the PDF stays put across
# edits, because zathura keys the reading position on the filename and a
# per-render name would reset it every time the document changed. The
# document keeps its own name inside that directory because zathura
# titles its window after the basename, and the bar shows that title.
MD_CACHE="$CACHE_DIR/md"
SESSIONS="$STATE_DIR/sessions"
LOCK="$STATE_DIR/focus.lock"
PREV_STATE="$STATE_DIR/focus.prev"
ZATHURA_DB="${XDG_DATA_HOME:-$HOME/.local/share}/zathura/bookmarks.sqlite"

# zathura's Wayland app-id. Also hardcoded in hypr/windowrules.lua --
# both have to move together if a future zathura ever renames it.
ZATHURA_CLASS="org.pwmt.zathura"

# Everything zathura can open here: zathura-pdf-mupdf covers pdf/epub/
# mobi/fb2/oxps, zathura-cb covers cbz/cbr, zathura-djvu covers djvu.
# azw3 is MOBI8 and the mupdf plugin takes it under the same handler.
EXTENSIONS=(pdf epub mobi azw3 fb2 cbz cbr djvu xps oxps md markdown)

# Markdown is the one format zathura cannot open: mupdf has no parser
# for it. md2pdf.py (next to this script) renders it to a PDF first, so
# everything downstream -- theme, position, ranking, F1 -- is unchanged
# because what reaches zathura is an ordinary document.
MD_EXTENSIONS=" md markdown "
MD2PDF="$(dirname -- "$(readlink -f -- "$0")")/md2pdf.py"
ZATHURARC="$(dirname -- "$(readlink -f -- "$0")")/zathurarc"
# Where the themed copy of zathurarc is assembled. Not ~/.config/zathura,
# which stays a plain symlink to the repo file so that a PDF opened from
# nemo still gets the (dark) reader.
ZATHURA_CFG="$CACHE_DIR/zathura"

# Formats where a page COUNT is a fixed property of the file. The
# reflowable ones (epub, mobi, azw3, fb2) are deliberately excluded: they
# have no intrinsic pagination, mutool would report the count for its own
# default layout box, and that number has nothing to do with the one
# zathura shows at your font size and window width. A wrong "/312" is
# worse than no total at all, so those show a bare page number.
FIXED_LAYOUT=" pdf cbz cbr xps oxps md markdown "

mkdir -p "$STATE_DIR" "$CACHE_DIR" "$SESSIONS" "$MD_CACHE" "$ZATHURA_CFG"

# ============================================================
# Light / dark
# ============================================================
# The desktop already has one switch for this -- the gsettings key
# quickshell's AppearanceState.qml reads and writes, which its bar toggle
# drives -- so Liseuse follows it rather than adding a second one.
# Anything that is not exactly 'prefer-dark' means light: the same
# two-state reading AppearanceState documents, and the safe one for a
# value some future GNOME adds.
desktop_is_dark() {
    case "$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)" in
        *prefer-dark*) return 0 ;;
        *) return 1 ;;
    esac
}

# Assembles the config zathura will actually run with, and prints its
# directory.
#
# Why a generated copy rather than editing zathurarc in place: the file
# in the repo is the dark reader, and `recolor` -- the setting that
# inverts a white PDF page onto a dark ground -- is exactly wrong when
# the desktop is in light mode, where the document's own colours ARE the
# right ones. zathura has no conditional in its config language and no
# usable include (`:source` takes a config DIRECTORY, not a file, so it
# cannot layer), and no command-line flag for setting an option. So the
# layering is done here, by appending: zathura applies settings in file
# order, so the last `set` wins.
#
# Regenerated on every open rather than cached against a state file. It
# is one read and one printf of a few kB -- cheaper than the code that
# would decide whether it is stale, and it cannot drift.
# "landscape" or "portrait", from the first page of the document.
#
# The distinction is real and not cosmetic: a 16:9 slide fits a screen
# whole, so one page IS one screenful and paging is the only motion that
# makes sense. An A4 page is taller than it is wide, so at any zoom that
# makes its text comfortable it overflows the screen and wants to be
# scrolled through -- and forcing it back to whole-page on every turn
# fights the reader.
#
# Page 1 decides for the whole document. A file that changes orientation
# halfway is rare enough not to pay for, and mutool being absent or the
# file being unreadable falls back to landscape, which is this module's
# existing behaviour.
document_orientation() {
    local o
    o="$(mutool pages -- "$1" 1 2>/dev/null \
         | awk -F'"' '/MediaBox/ { w = $6 - $2; h = $8 - $4;
                                   print (w > h) ? "landscape" : "portrait"; exit }')"
    printf '%s' "${o:-landscape}"
}

zathura_config_dir() {
    local out="$ZATHURA_CFG/zathurarc"
    local doc="${1:-}"
    if desktop_is_dark; then
        # The repo file IS the dark configuration; nothing to add.
        cat -- "$ZATHURARC" > "$out" 2>/dev/null || return 1
    else
        {
            cat -- "$ZATHURARC" 2>/dev/null
            cat <<'LIGHT'

# ---- appended by liseuse: the desktop is in light mode -------------
# recolor off is the whole point. A PDF is black ink on white paper and
# in light mode that is already what you want to look at; inverting it
# would produce a dark page on a light desktop, which is the one
# combination nobody asked for. Everything below just moves the window's
# own chrome -- the letterbox around the page, the loading placeholder --
# to the light end of the same palette.
set recolor false
set default-bg "#f7f7f9"
set default-fg "#1c1c1e"
set statusbar-bg "#f7f7f9"
set statusbar-fg "#636366"
set inputbar-bg  "#f7f7f9"
set inputbar-fg  "#1c1c1e"
set notification-bg         "#ececf0"
set notification-fg         "#1c1c1e"
set notification-error-bg   "#ececf0"
set notification-warning-bg "#ececf0"
set completion-bg           "#ececf0"
set completion-fg           "#1c1c1e"
set completion-highlight-bg "#d1d1d6"
set completion-highlight-fg "#000000"
set completion-group-bg     "#f7f7f9"
set completion-group-fg     "#2f5d8a"
set render-loading-bg "#f7f7f9"
set render-loading-fg "#8e8e93"
LIGHT
        } > "$out" || return 1
    fi

    # ---- orientation ------------------------------------------------
    # Appended last, so it wins over the base file (zathura applies
    # settings in order).
    if [ -n "$doc" ] && [ "$(document_orientation "$doc")" = "portrait" ]; then
        cat >> "$out" <<'PORTRAIT'

# ---- appended by liseuse: this document is portrait ----------------
# single-page-mode off, so the view is one continuous strip and j/k,
# Ctrl+d and Ctrl+f carry on across a page boundary instead of stopping
# dead at it. That is how a book or a handout is read.
set single-page-mode false

# And the page turn drops the `a` the landscape bindings carry. On a
# slide, re-fitting is the point -- the next slide must arrive whole. On
# a portrait page it is the opposite: you have chosen a zoom that makes
# the text readable (often `s`, fit-width), and forcing whole-page on
# every turn throws that away.
#
# `J`/`K` alone still frame the new page properly rather than dumping you
# at an arbitrary offset: sc_navigate ends in position_set, and with
# vertical-center set it puts the page mid-point at the viewport
# mid-point -- centred on the page you asked for, at the zoom you chose.
map <Space> feedkeys "J"
map <S-Space> feedkeys "K"
map <Return> feedkeys "J"
map <S-Return> feedkeys "K"
PORTRAIT
    fi

    printf '%s' "$ZATHURA_CFG"
}

# True for a path this script has to render before zathura can open it.
is_markdown() {
    local ext="${1##*.}"
    case "$MD_EXTENSIONS" in *" ${ext,,} "*) return 0 ;; *) return 1 ;; esac
}

# Renders if needed (md2pdf.py decides, from the mtimes of the source
# AND of markdown.css) and prints the PDF to open. Empty on failure --
# every caller treats that as "leave the .md alone", so a missing python
# dependency degrades to zathura refusing the file rather than to
# Liseuse breaking.
md_pdf() {
    python3 "$MD2PDF" "$1" "$MD_CACHE" 2>/dev/null || true
}

# ============================================================
# Library roots
# ============================================================
# ~/Livres plus whatever sources.conf adds -- the point of the extra
# roots being that course PDFs stay in ~/courses next to the rest of the
# course and still show up here (same motivation and same file format as
# prisme/wallpapers-extra.conf).
roots() {
    [ -d "$LIBRARY_ROOT" ] && printf '%s\n' "$LIBRARY_ROOT"
    [ -f "$SOURCES_CONF" ] || return 0
    local line
    while IFS= read -r line; do
        line="${line%%#*}"
        line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        [ -z "$line" ] && continue
        case "$line" in "~/"*) line="$HOME/${line#\~/}" ;; esac
        # A root that doesn't exist on this machine is skipped in
        # silence, so one sources.conf can serve several machines.
        [ -d "$line" ] && printf '%s\n' "$line"
    done < "$SOURCES_CONF"
}

# `mtime<TAB>path` for every readable book under every root.
#
# -prune on hidden directories and on the two build-output names that
# turn a scan of ~/code into a scan of a package cache. Roots can nest or
# repeat (~/Livres symlinked into ~/courses, say), so the result is
# deduplicated on the resolved path.
scan() {
    local -a roots_arr find_expr
    mapfile -t roots_arr < <(roots)
    [ "${#roots_arr[@]}" -eq 0 ] && return 0

    local ext first=1
    for ext in "${EXTENSIONS[@]}"; do
        [ "$first" -eq 1 ] || find_expr+=(-o)
        find_expr+=(-iname "*.${ext}")
        first=0
    done

    find -L "${roots_arr[@]}" \
        \( -name '.*' -o -name node_modules -o -name target \) -prune -o \
        -type f \( "${find_expr[@]}" \) -readable \
        -printf '%T@\t%p\n' 2>/dev/null \
      | awk -F'\t' '!seen[$2]++ { printf "%d\t%s\n", $1, $2 }'
}

# ============================================================
# Ranking
# ============================================================
# Two groups, and that ordering is the whole product decision: a reader
# nearly always wants the book they are currently in, and only
# occasionally wants to start a new one.
#
#   group 2 — "en cours": zathura's history has a page > 0 for it
#   group 1 — everything else
#
# Within a group, most recent first: the timestamp is zathura's own
# `fileinfo.time` for anything ever opened, otherwise the file's mtime,
# which puts a book downloaded five minutes ago at the top of group 1
# where you'd reach for it.
#
# The sort key is a zero-padded fixed-width number so a plain
# lexicographic `sort -r` orders it correctly.
#
# ---- Why the display label is built HERE, in awk --------------------
# It used to be a `label_for` shell function called per row, and that one
# decision cost more than everything else in this script put together:
# 348ms for a 400-book library, of which the find|awk|sort pipeline below
# was 10ms. The other 338 were 400 command substitutions -- 400 fork()s
# -- and nothing else. Building the label inside the pass that is already
# reading every row makes the same 400 books 12ms.
#
# So: one row out per book, `sortkey \t path \t page \t label`, with the
# label complete EXCEPT for the "/380" total. That part alone stays in
# the shell, because it needs mutool and a cache lookup -- but it is only
# ever needed for the handful of books that are actually in progress, so
# it costs a few forks, not one per book.
# One sqlite3 call, not one per book: the whole fileinfo table comes out
# as `path \t page \t epoch` and is joined against the scan inside the
# same awk pass. sqlite3's own startup is ~3ms, against ~30ms for a
# python3 that could read the same table -- which would have cost more
# than everything else in this script combined.
#
# strftime('%s', time) reads zathura's stored local-time string as if it
# were UTC, so these epochs are off by the timezone offset. That is fine
# and deliberate: they are only ever compared against each other, and the
# error is the same constant on every row.
# `<cached pdf>\t<source .md>` for every markdown document ever
# rendered, read from the sidecars md2pdf.py leaves next to each PDF.
# One awk over the whole directory rather than a `cat` per file, for the
# same fork reason `ranked` builds its labels in awk.
md_map() {
    awk 'FNR == 1 { pdf = FILENAME; sub(/\.src$/, ".pdf", pdf); print pdf "\t" $0 }' \
        "$MD_CACHE"/*/*.src 2>/dev/null || true
}

zathura_state() {
    [ -s "$ZATHURA_DB" ] || return 0
    sqlite3 -readonly -separator "$(printf '\t')" "$ZATHURA_DB" \
        "SELECT file, page, CAST(strftime('%s', time) AS INTEGER) FROM fileinfo;" \
        2>/dev/null || true
}

ranked() {
    { md_map; printf '\034\n'; zathura_state; printf '\034\n'; scan; } \
      | awk -F'\t' -v lib="$LIBRARY_ROOT" -v mdcache="$MD_CACHE" -v home="$HOME" '
        # Title: basename, extension dropped, underscores back to spaces.
        # A book under ~/Livres shows that alone; one pulled in from an
        # extra root (sources.conf) is prefixed with its own folder, so a
        # course PDF reads "ACL · DPatterns Intro" instead of competing
        # on filename alone.
        # What the picker SEARCHES, as opposed to what it shows.
        #
        # fuzzel already does fzf-style matching (its default match-mode),
        # so the gap was never the matching -- it was the haystack. The
        # label shows a title and at most its immediate parent, so
        # ~/code/dotfiles/docs/modules.md reads "docs · modules" and
        # typing "dotfiles" found nothing, though that is exactly the word
        # you remember when you do not remember the filename.
        #
        # So the whole path below $HOME goes in, twice: once as written,
        # so "docs/modules" matches with the slash typed, and once with
        # every separator flattened to a space, so "dotfiles modules" also
        # matches as two independent fzf tokens. Flattening puts the
        # extension in as a bare word too, which makes typing "md" a
        # type filter for free.
        #
        # None of this is displayed -- fuzzel is given the label in column
        # 1 and this in column 2, with --with-nth=1 --match-nth=2.
        function haystack(path,    rel, norm) {
            rel = path
            if (index(rel, home "/") == 1) rel = substr(rel, length(home) + 2)
            norm = rel
            gsub(/[\/_.-]+/, " ", norm)
            return rel " " norm
        }
        # The format, as a leading icon. A title alone never says which
        # of two things you are about to open -- the .md notes of a course
        # and its .pdf slides both render as "RESEAUX · Routage" -- and
        # this is what the eye scans a 51-row list by.
        #
        # All five glyphs come from ONE Nerd Font set (Material Design),
        # which is the only reason they sit together: mixing a Font
        # Awesome page with an Octicons M-mark puts two different weights
        # and two different optical sizes in the same column. They also
        # share one advance width, so every title starts at the same x --
        # which the "PDF"/"MD" text tags this replaced could not do, the
        # UI font of the picker being proportional.
        #
        # fuzzel draws them through fontconfig fallback (MiSans has no
        # such glyph); fuzzel.ini leans on the same mechanism and says so.
        # Presence verified with `fc-list :charset=f0226`.
        #
        # NOTE: no apostrophes anywhere in this awk program. It is held in
        # a single-quoted shell string, so one would end it -- which is
        # exactly how this block first failed to parse.
        function typeicon(path,    e) {
            e = path
            sub(/^.*\./, "", e)
            e = tolower(e)
            if (e == "pdf") return "󰈦"
            if (e == "md" || e == "markdown") return "󰍔"
            if (e == "epub" || e == "mobi" || e == "azw3" || e == "fb2") return "󰂽"
            if (e == "cbz" || e == "cbr") return "󰋩"
            return "󰈙"
        }
        function label(path,    n, parts, base) {
            n = split(path, parts, "/")
            base = parts[n]
            sub(/\.[^.]*$/, "", base)
            gsub(/_/, " ", base)
            if (index(path, lib "/") != 1 && n > 1) base = parts[n-1] " · " base
            return typeicon(path) "  " base
        }
        # Three \034-separated sections arrive on stdin, in order:
        # the rendered-markdown map, zathura'\''s fileinfo table, then the
        # filesystem scan.
        $0 == "\034" { section++; next }

        # 0. <cached pdf> -> <source .md>
        section == 0 { src[$1] = $2; next }

        # 1. zathura'\''s history, re-keyed onto the source. A markdown
        # document is recorded against the PDF it was rendered to, so
        # without this translation its page and timestamp would attach to
        # a cache filename that appears in no listing, and the document
        # would look untouched forever.
        section == 1 {
            key = ($1 in src) ? src[$1] : $1
            page[key] = $2 + 0; opened[key] = $3 + 0
            next
        }

        # 2. the files on disk.
        {
            mtime = $1 + 0; path = $2
            inprog = (path in page && page[path] > 0)
            ts = (path in opened && opened[path] > 0) ? opened[path] : mtime
            # What to measure a page count against: a markdown file has
            # none of its own, its rendered PDF does.
            #
            # It falls back to `path` rather than to an empty string, and
            # that is not cosmetic: TAB is an IFS *whitespace* character,
            # so bash'\''s `read` collapses a run of them into one
            # separator and an empty field simply vanishes, shifting every
            # column after it. An un-rendered .md then arrived with its
            # label in the render slot and no label at all. Nothing
            # downstream needs the distinction anyway -- page_total
            # refuses a markdown extension outright.
            render = path
            if (path ~ /\.(md|markdown)$/)
                for (p in src) if (src[p] == path) { render = p; break }
            printf "%d%012d\t%s\t%d\t%s\t%s\t%s\n", (inprog ? 2 : 1), ts, path,
                   (inprog ? page[path] : -1), render, haystack(path), label(path)
        }
    ' | sort -r
}

# Total pages, cached by (path, mtime) so mutool runs once per file ever
# and never again until the file itself changes. Only ever called for the
# handful of books that are actually in progress, so a 400-book library
# costs at most a few mutool calls on the first run and none after.
page_total() {
    local path="$1" ext mt n
    ext="${path##*.}"
    case "$FIXED_LAYOUT" in *" ${ext,,} "*) ;; *) printf '0'; return ;; esac
    # A markdown path reaching here means it was never rendered, so there
    # is no PDF to count and no honest total to show.
    case "$MD_EXTENSIONS" in *" ${ext,,} "*) printf '0'; return ;; esac
    mt="$(stat -c %Y -- "$path" 2>/dev/null)" || { printf '0'; return; }

    n="$(awk -F'\t' -v p="$path" -v m="$mt" '$3 == p && $1 == m { print $2; exit }' \
            "$PAGES_CACHE" 2>/dev/null || true)"
    if [ -z "$n" ]; then
        n="$(mutool info -- "$path" 2>/dev/null | awk '/^Pages:/ { print $2; exit }' || true)"
        [ -z "$n" ] && n=0
        printf '%s\t%s\t%s\n' "$mt" "$n" "$path" >> "$PAGES_CACHE"
    fi
    printf '%s' "$n"
}

# The only part of the label awk can't build: the reading position.
#
# Result goes into the global $LABEL rather than stdout, and that is the
# same fork question as `ranked`'s, one level down: `x="$(decorate ...)"`
# is a command substitution, so writing this the obvious way would have
# put back exactly the per-book fork that moving the label into awk just
# removed. Assigning a global costs nothing, and the only two callers are
# right below.
LABEL=""
decorate() {
    local path="$1" page="$2" render="$3" total
    LABEL="$4"
    [ "$page" -ge 0 ] || return 0
    # zathura stores a 0-based page index; humans count from 1. The page
    # TOTAL is measured on the render path, which differs from `path`
    # only for markdown -- where the pages belong to the generated PDF,
    # the .md having none of its own.
    total="$(page_total "${render:-$path}")"
    if [ "$total" -gt 0 ]; then
        LABEL="$LABEL   —   p. $((page + 1))/$total"
    else
        LABEL="$LABEL   —   p. $((page + 1))"
    fi
}

# ============================================================
# Reading mode — the distraction-free half
# ============================================================
# Three things interrupt reading on this machine, and none of them is
# zathura's to fix:
#
#   notifications  -> shell.qml's setDnd (quieted, not blocked -- they
#                     still land in the centre, they just don't pop)
#   hypridle       -> 5 min to lock on battery, 15 on mains, and reading
#                     is the one activity that produces NO input for
#                     minutes at a time. Handled by launching zathura
#                     under systemd-inhibit rather than from here:
#                     hypridle.conf keeps ignore_dbus_inhibit = false
#                     precisely so a D-Bus inhibitor is honoured, the
#                     same mechanism mpv and Firefox already use.
#
# The bar is NOT in that list, and used to be: this hid it with setZen
# on the way in and showed it again on the way out. That was redundant
# and, worse, wrong. Redundant because a fullscreen window already covers
# the bar -- verified with zen off throughout: tiled, the bar reads
# "Liseuse [154/293] Platon-so..."; fullscreen, the page covers that
# strip completely. Wrong because zen is a state and fullscreen is a
# state, and they came apart the moment you left fullscreen with
# SUPER+SHIFT+F while still reading: the window shrank, the bar stayed
# hidden, and you had to bring it back by hand every time.
#
# Hiding the bar was also never what stopped the interruptions. That is
# DND, which is a separate quickshell switch and the one thing kept here.
#
# setDnd is an idempotent SETTER, not a toggle, because this has to
# restore what it found: entering with notifications already quieted must
# not un-quiet them on the way out. $PREV_STATE holds that snapshot.
#
# Two books open at once is a normal thing to do, so the enter/leave is
# reference-counted: one file per session PID under $SESSIONS, and only
# the first in and the last out touch the bar. flock serialises the
# check-and-act, since otherwise two sessions starting together can both
# read an empty directory and both snapshot a state the other has
# already changed.
focus_enter() {
    (
        flock 9
        # Drop sessions whose process is gone (SIGKILL, a crash, a
        # reboot with $SESSIONS on a persistent filesystem). Without
        # this, one killed reader leaves the count stuck above zero and
        # the bar hidden forever.
        local pidfile pid crashed=0
        for pidfile in "$SESSIONS"/*; do
            [ -e "$pidfile" ] || continue
            pid="${pidfile##*/}"
            kill -0 "$pid" 2>/dev/null || { rm -f "$pidfile"; crashed=1; }
        done

        # Whether this session is the only one, which decides both halves
        # of "immersive or side by side" below.
        #
        # PRINTED, not assigned to a global: everything here runs inside
        # `( flock 9 ... )`, which is a subshell, so a variable set here
        # is gone by the time the caller reads it -- which is exactly how
        # the first version of this failed, silently, with the first book
        # never going fullscreen. stdout crosses that boundary; a
        # variable does not.
        local alone=0
        if [ -z "$(ls -A "$SESSIONS" 2>/dev/null)" ]; then
            alone=1
        fi
        if [ "$alone" = "1" ]; then
            # Snapshot what to restore to -- but ONLY on a genuinely cold
            # start. If the directory is empty because a session was just
            # pruned, notifications are still quieted by that dead
            # session, and snapshotting NOW would record "DND was already
            # on" and make that permanent: this session would faithfully
            # restore the wrong thing on its way out, and so would every
            # session after it. The $PREV_STATE that dead session wrote is
            # still on disk and is still the right answer, so it is kept.
            if [ "$crashed" -eq 0 ] || [ ! -s "$PREV_STATE" ]; then
                qs -c bar ipc call bar focusState > "$PREV_STATE" 2>/dev/null || \
                    printf 'zen=0 dnd=0\n' > "$PREV_STATE"
            fi
            qs -c bar ipc call bar setDnd true >/dev/null 2>&1 || true
        else
            # A second document: drop the first one out of fullscreen so
            # the two tile side by side. That also brings the bar back on
            # its own, which is the case where you most need it -- it is
            # the only thing saying which of the two has focus and what
            # page it is on (quickshell ActiveWindow.qml shows
            # "Liseuse  [12/340] name"). Notifications stay quiet: that
            # part of not being disturbed still holds.
            local a
            for a in $(zathura_addrs); do set_fullscreen "$a" off; done
        fi
        : > "$SESSIONS/$$"
        printf '%s' "$alone"
    ) 9>"$LOCK"
}

focus_leave() {
    (
        flock 9
        rm -f "$SESSIONS/$$"
        if [ -z "$(ls -A "$SESSIONS" 2>/dev/null)" ]; then
            local prev dnd
            prev="$(cat "$PREV_STATE" 2>/dev/null || echo 'zen=0 dnd=0')"
            case "$prev" in *dnd=1*) dnd=true ;; *) dnd=false ;; esac
            qs -c bar ipc call bar setDnd "$dnd" >/dev/null 2>&1 || true
        fi
    ) 9>"$LOCK"
}

# ============================================================
# Opening
# ============================================================
open_book() {
    local path="$1" target
    [ -f "$path" ] || { notify "Not found" "$(basename -- "$path")"; return 1; }

    # Markdown is rendered to a PDF first (md2pdf.py), because mupdf has
    # no markdown parser. Done BEFORE focus_enter so that the ~450ms of
    # a first render happens on the normal desktop rather than behind an
    # already-hidden bar -- and so a render that fails leaves nothing to
    # restore.
    target="$path"
    if is_markdown "$path"; then
        target="$(md_pdf "$path")"
        if [ -z "$target" ] || [ ! -f "$target" ]; then
            notify "Cannot render" "$(basename -- "$path") — is python3-weasyprint installed?"
            return 1
        fi
    fi

    # Nothing recorded here: zathura writes its own fileinfo row (path,
    # page, time) the moment it opens the file, and that row is what
    # ranked() reads back. See the header.
    local alone
    alone="$(focus_enter)"

    # Fullscreen only when this is the only book open, and done here
    # rather than by a window rule because a rule cannot count windows
    # (see hypr/windowrules.lua). The wait is for the window to exist:
    # zathura has not been launched yet at this point, so the address is
    # found by polling for one that was not there before. Backgrounded,
    # so a window that never appears costs five seconds of a detached
    # subshell and nothing else.
    if [ "$alone" = "1" ]; then
        local before
        before="$(zathura_addrs | tr '\n' ' ')"
        (
            for _ in $(seq 1 100); do
                for a in $(zathura_addrs); do
                    case " $before " in
                        *" $a "*) ;;
                        *) set_fullscreen "$a" on; exit 0 ;;
                    esac
                done
                sleep 0.05
            done
        ) >/dev/null 2>&1 &
    fi

    # EXIT alone isn't enough: `set -e` plus a signal from the session
    # ending (logout, a killed terminal) would skip the restore and leave
    # the bar hidden with no window on screen to explain why.
    trap focus_leave EXIT INT TERM HUP
    local cfg
    cfg="$(zathura_config_dir "$target")" || cfg=""
    systemd-inhibit --what=idle \
                    --who=Liseuse \
                    --why="Reading a book" \
                    zathura ${cfg:+--config-dir "$cfg"} -- "$target" || true
    focus_leave
    trap - EXIT INT TERM HUP
}

notify() {
    notify-send -a Liseuse "$1" "${2:-}" 2>/dev/null || true
}

# ============================================================
# The manual — what to do once a book is open
# ============================================================
# The reading window has no menu, no statusbar and no chrome at all (see
# zathurarc's `guioptions ""`), which is the point of it and also means
# nothing on screen can teach you that `m` sets a mark or that `42G`
# jumps to page 42. This is that missing affordance, on F1 from inside
# the book (zathurarc maps it) and as `liseuse touches` from a terminal.
#
# Every key below was read out of zathura 2026.07.18's own default table
# (config.c, ~150 girara_shortcut_add calls) rather than recalled, after
# an earlier pass at this file remapped seven keys on the assumption the
# defaults were thin and destroyed the jumplist, rotation, double-page
# and Escape-to-cancel in the process.
touches() {
    cat <<'FIN'
  SCROLL
    j  k              line by line (15 px — see scroll-step)
    h  l              sideways, when the page overflows
    arrow keys        same
    two fingers       continuous, pixel by pixel
    Ctrl+d  Ctrl+u    half a screen
    Ctrl+f  Ctrl+b    a full screen, vim-style
    H  L              top / bottom of the current page
    Alt+j  Alt+k      partial scroll

  TURN PAGES
    Space  Return              next page
    Shift+Space  Shift+Return  previous page
    J  K                       same, always keeping your zoom
    PgDn  PgUp                 same
    Alt+→  Alt+←               same

    What a page turn does depends on the shape of the document, and
    Liseuse picks that from its first page:

      landscape (slides)  the next one arrives whole, re-fitted to the
                          screen — so zooming in on a detail does not
                          leave the following slide cropped
      portrait  (books)   the document scrolls as one continuous strip,
                          j/k and Ctrl+d carry on across a page break,
                          and a page turn centres the new page WITHOUT
                          touching the zoom you chose

  GO SOMEWHERE
    42G               jump to page 42
    gg                start of the book
    G                 end of the book
    Home  End         same
    Tab               the PDF's outline, if it has one
                      inside: j k to move, l h to expand/collapse,
                      Enter to go there, Esc to close
    Ctrl+o            back to where you came from (jumplist)
    Ctrl+i            forward again

  MARK YOUR PLACE
    Your position is already saved on every page turn: reopening the
    book puts you back. These are for landmarks inside a book.

    ma                set mark "a" here (any letter)
    'a                jump to mark "a"
    :mark a           same, as a command
    :delmarks a       drop it

    :bmark chapter3   NAMED bookmark here (any name)
    :blist            list this book's bookmarks
    :bjump chapter3   go to it
    :bdelete chapter3

  SEARCH
    /word   Enter     search forward
    ?word   Enter     search backward
    n  N              next / previous hit
    :nohlsearch       stop highlighting

  SEE IT DIFFERENTLY
    a                 fit the whole page (what Space does for you)
    s                 fit the width (bigger text, you scroll)
    +  -              zoom in / out      (also zi / zo)
    =  zz             zoom to a value    z0: original zoom
    d                 two pages side by side, like an open book
    D                 shift which page sits on the left
    r                 rotate 90°
    Ctrl+r            restore the document's own colours — for a
                      figure a dark background makes unreadable.
                      The reader already follows the desktop's
                      light/dark switch, so this is a per-document
                      override, not the way to change theme
    F5                presentation mode
    F11               leave / enter fullscreen

  ODDS AND ENDS
    f                 show link numbers, then type one to follow it
    c                 copy a link
    Ctrl+p            print
    :info             file metadata
    :exec <command>   run a command

  TWO AT ONCE
    Opening a second book from SUPER+F drops the first out of fullscreen
    and puts the two side by side, which brings the bar back -- it is
    what tells you which of them has focus and what page it is on. One
    book on its own stays fullscreen, which hides the bar by covering it.
    SUPER+SHIFT+F leaves fullscreen at any time and the bar returns.

  LEAVE
    q                 close the book (notifications come back, the
                      idle lock re-arms). The bar needs nothing: a
                      fullscreen window covers it and leaving
                      fullscreen brings it back by itself
    Esc               CANCEL — a search, the outline, a half-typed
                      command. Does not close the book.
    F1                this manual
FIN
}

# F1 goes through zathura's `:exec`, a foreground spawn, so this hands the
# window off and returns rather than blocking the reader behind fuzzel.
#
# The text reaches fuzzel through a TEMP FILE, and that is not an
# arbitrary choice -- the obvious `"$0" touches | fuzzel` is a trap this
# file already fell into once, and it fed a self-replicating loop:
#
#   `"$0" touches` re-enters the script, whose stdout is now a PIPE, so
#   `[ -t 1 ]` is false, so it takes this branch again -- spawning
#   another background fuzzel and printing NOTHING into the pipe. The
#   fuzzel actually on screen therefore showed an empty list, and killing
#   it only let the next one through. Fuzzel also keeps a single-instance
#   lock in $XDG_RUNTIME_DIR, so the loop could wedge SUPER+Space too.
#
# A file has none of that: no re-entry, no pipe, and stdin is at EOF the
# moment fuzzel opens it. `touches` is called directly, as a function.
touches_afficher() {
    if [ -t 1 ]; then
        touches
        return
    fi
    local tmp
    tmp="$(mktemp -t liseuse-touches.XXXXXX)" || return 0
    touches > "$tmp"
    setsid nohup sh -c '
        fuzzel --dmenu --lines 22 --width 64 --prompt="" \
               --placeholder="Reading manual — Esc to close" \
               < "$1" >/dev/null 2>&1
        rm -f "$1"
    ' sh "$tmp" >/dev/null 2>&1 </dev/null &
}

# ============================================================
# Converting what nothing here can render
# ============================================================
# Word, PowerPoint and their open equivalents are not readable by mupdf
# and never will be. Unlike Markdown, they are NOT rendered transparently
# on open: LibreOffice headless takes seconds per document and the suite
# is several hundred megabytes, so making every SUPER+F depend on it
# would be the wrong trade for a format that shows up twice in this
# library. It is an explicit command instead, and the PDF it produces
# lands NEXT TO the source -- which is the whole trick, because the next
# scan then finds that PDF like any other book, with no special case
# anywhere else in this script.
CONVERTIBLE=" doc docx odt rtf ppt pptx odp xls xlsx ods "

is_convertible() {
    local ext="${1##*.}"
    case "$CONVERTIBLE" in *" ${ext,,} "*) return 0 ;; *) return 1 ;; esac
}

soffice_bin() {
    command -v soffice 2>/dev/null || command -v libreoffice 2>/dev/null || true
}

# One document -> one PDF beside it. Returns 0 when a PDF is in place.
convert_one() {
    local src="$1" out dir bin
    out="${src%.*}.pdf"
    dir="$(dirname -- "$src")"

    # Already converted and still current. Same freshness rule as the
    # Markdown cache: a source edited after its PDF gets redone, one that
    # has not been touched is left alone. This matters here because the
    # PDF sits beside the source rather than in a cache, so blindly
    # overwriting could destroy a PDF that was never generated from it.
    if [ -f "$out" ] && [ ! "$src" -nt "$out" ]; then
        printf 'unchanged  %s\n' "${out#"$HOME"/}"
        return 0
    fi

    bin="$(soffice_bin)"
    if [ -z "$bin" ]; then
        echo "liseuse convert: LibreOffice is not installed." >&2
        echo "  sudo dnf install libreoffice-writer libreoffice-impress libreoffice-calc" >&2
        return 3
    fi

    # A private profile under the cache, for one reason: headless
    # LibreOffice refuses to start against a profile an interactive
    # LibreOffice already holds, so without this the command fails
    # whenever the suite happens to be open.
    "$bin" --headless --norestore \
           -env:UserInstallation="file://$CACHE_DIR/soffice" \
           --convert-to pdf --outdir "$dir" -- "$src" >/dev/null 2>&1

    if [ -f "$out" ]; then
        printf 'converted  %s\n' "${out#"$HOME"/}"
        return 0
    fi
    echo "liseuse convert: failed on ${src#"$HOME"/}" >&2
    return 1
}

# Everything convertible under the library roots, newest first, as
# `path` lines. Used when `liseuse convert` is called with no argument.
convertible_docs() {
    local -a roots_arr find_expr
    mapfile -t roots_arr < <(roots)
    [ "${#roots_arr[@]}" -eq 0 ] && return 0
    local ext first=1
    for ext in $CONVERTIBLE; do
        [ "$first" -eq 1 ] || find_expr+=(-o)
        find_expr+=(-iname "*.${ext}")
        first=0
    done
    find -L "${roots_arr[@]}" \
        \( -name '.*' -o -name node_modules -o -name target \) -prune -o \
        -type f \( "${find_expr[@]}" \) -readable -printf '%T@\t%p\n' 2>/dev/null \
      | sort -rn | cut -f2-
}

convert() {
    local f rc=0
    if [ "$#" -gt 0 ]; then
        for f in "$@"; do
            if [ ! -f "$f" ]; then
                echo "liseuse convert: no such file: $f" >&2; rc=1; continue
            fi
            is_convertible "$f" || { echo "liseuse convert: not an office document: $f" >&2; rc=1; continue; }
            convert_one "$f" || rc=$?
        done
        return "$rc"
    fi

    # No argument: pick one, the same way everything else here is picked.
    # The label says whether a PDF is already sitting beside it, because
    # that is the only thing you need to know before choosing.
    local -a docs=() labels=()
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        docs+=("$f")
        if [ -f "${f%.*}.pdf" ] && [ ! "$f" -nt "${f%.*}.pdf" ]; then
            labels+=("done   ${f#"$HOME"/}")
        else
            labels+=("       ${f#"$HOME"/}")
        fi
    done < <(convertible_docs)

    if [ "${#docs[@]}" -eq 0 ]; then
        notify "Nothing to convert" "No .doc/.docx/.pptx/... under the library roots"
        return 0
    fi

    local idx
    idx="$(printf '%s\n' "${labels[@]}" \
            | fuzzel --dmenu --index --lines 14 --width 70 \
                     --prompt='' --placeholder='Convert to PDF…' --counter \
            || true)"
    [ -n "$idx" ] || return 0
    convert_one "${docs[$idx]}"
}

# ============================================================
# Picker
# ============================================================
pick() {
    local -a paths=() labels=() hays=()
    local key path page render hay label idx i

    while IFS=$'\t' read -r key path page render hay label; do
        [ -n "$path" ] || continue
        paths+=("$path")
        hays+=("$hay")
        decorate "$path" "$page" "$render" "$label"
        labels+=("$LABEL")
    done < <(ranked)

    if [ "${#paths[@]}" -eq 0 ]; then
        notify "Empty library" "Nothing under $LIBRARY_ROOT or in sources.conf"
        return 1
    fi

    # Two columns per line: what to show, and what to search.
    #
    # fuzzel has done fzf-style matching all along (that is its default
    # match-mode), so nothing here is adding fuzzy search -- it is giving
    # that search something worth matching against. --with-nth=1 displays
    # the title, --match-nth=2 matches the hidden path haystack, so typing
    # "dotfiles keybind", "courses reseaux" or just "md" finds documents
    # whose displayed title contains none of those words.
    #
    # --index rather than matching the chosen line back against the list:
    # titles are derived (extension stripped, underscores replaced, a
    # folder prefix added) and two files can legitimately produce the same
    # label, so the index is the only unambiguous way back to a path.
    # Width/lines override fuzzel.ini's launcher geometry -- book titles
    # are much longer than command names.
    #
    # The loop below is printf-only: no forks, for the reason `ranked`'s
    # own header explains at length.
    #
    # --prompt='' and NOT --prompt-only=''. They read as the same thing
    # and are not: per fuzzel's man page, --prompt-only in dmenu mode
    # "does not read anything from STDIN" and "sets --lines to 0". This
    # picker carried it from its first version, which meant every SUPER+F
    # opened an empty one-line box that had never read the library at
    # all -- the ranking, the page numbers and the search haystack were
    # all computed correctly and then thrown away, unseen.
    idx="$(for i in "${!paths[@]}"; do
               printf '%s\t%s\n' "${labels[$i]}" "${hays[$i]}"
           done \
            | fuzzel --dmenu --index --with-nth=1 --match-nth=2 \
                     --lines 14 --width 60 \
                     --prompt='' --placeholder='Read…' --counter \
            || true)"
    [ -n "$idx" ] || return 0            # cancelled with Escape
    open_book "${paths[$idx]}"
}

# ============================================================
# What's on screen
# ============================================================
# ---- Talking to the compositor -------------------------------------
# Every dispatch below goes through hl.dsp.*, and that is not a style
# choice. This Hyprland is configured in Lua (hypr/*.lua), so `hyprctl
# dispatch` evaluates its argument AS LUA: the classic
# `hyprctl dispatch focuswindow address:0x...` does not merely misbehave,
# it fails to parse --
#
#   error: return hl.dispatch(focuswindow address:0x...):1: ) expected
#
# which is exactly what this script used to send, with stderr discarded.
# The "return to the book you were reading" half of SUPER+F therefore
# never once worked. The Lua API surface was found by enumerating
# `pairs(hl.dsp)` through an exec_cmd dispatch; note it has window.close
# and window.fullscreen but NO window.focus -- focusing lives one level
# up, on hl.dsp.focus.
zathura_addrs() {  # every zathura window address, newest last
    hyprctl -j clients 2>/dev/null \
        | jq -r --arg c "$ZATHURA_CLASS" 'map(select(.class == $c)) | .[].address' \
        2>/dev/null || true
}

zathura_addr() {   # address of any zathura window, empty if none
    zathura_addrs | head -1
}

focus_window() {
    [ -n "${1:-}" ] || return 0
    hyprctl dispatch "hl.dsp.focus({ window = 'address:$1' })" >/dev/null 2>&1 || true
}

# SET fullscreen, rather than toggle it. hl.dsp.window.fullscreen is a
# toggle, so firing it blind would undo the state it was asked to
# establish half the time; the current state is read back first and the
# dispatch only happens when it actually differs. Hyprland reports 0 for
# "not fullscreen" and a non-zero mode otherwise.
set_fullscreen() {
    local addr="$1" want="$2" cur
    [ -n "$addr" ] || return 0
    cur="$(hyprctl -j clients 2>/dev/null \
            | jq -r --arg a "$addr" 'map(select(.address == $a)) | .[0].fullscreen // 0' \
            2>/dev/null || echo 0)"
    if [ "$want" = "on" ] && [ "$cur" = "0" ]; then
        hyprctl dispatch "hl.dsp.window.fullscreen({ mode = 0, window = 'address:$addr' })" >/dev/null 2>&1 || true
    elif [ "$want" = "off" ] && [ "$cur" != "0" ]; then
        hyprctl dispatch "hl.dsp.window.fullscreen({ mode = 0, window = 'address:$addr' })" >/dev/null 2>&1 || true
    fi
}

zathura_focused() {
    [ "$(hyprctl -j activewindow 2>/dev/null | jq -r '.class // empty' 2>/dev/null)" = "$ZATHURA_CLASS" ]
}

# ============================================================
# Entry point
# ============================================================
case "${1-}" in
    -h|--help)
        cat <<EOF
liseuse — reading library (zathura)

  liseuse              SUPER+F. Resume the open book, or pick one.
  liseuse pick         Force the picker even with a book already open.
  liseuse open FILE    Open that file as a reading session.
  liseuse list         Print the ranked library on stdout.
  liseuse keys         The manual: what to do once a book is open.
                       From inside the book itself, that is F1.
  liseuse convert [F]  Render .doc/.docx/.odt/.ppt/.pptx/.xls... to a PDF
                       beside the original, so the library picks it up.
                       With no argument, pick one. Needs LibreOffice.

Library root : $LIBRARY_ROOT   (\$LISEUSE_LIBRARY)
Extra sources: $SOURCES_CONF
EOF
        ;;
    keys|touches|help)
        touches_afficher
        ;;
    pick)
        pick
        ;;
    convert)
        shift
        convert "$@"
        ;;
    open)
        [ -n "${2-}" ] || { echo "liseuse open: missing file" >&2; exit 2; }
        open_book "$2"
        ;;
    list)
        while IFS=$'\t' read -r _ path page render _hay label; do
            [ -n "$path" ] || continue
            decorate "$path" "$page" "$render" "$label"
            printf '%s\t%s\n' "$LABEL" "$path"
        done < <(ranked)
        ;;
    "")
        # The three-outcome behaviour described at the top of this file.
        addr="$(zathura_addr)"
        if [ -n "$addr" ] && ! zathura_focused; then
            focus_window "$addr"
        else
            pick
        fi
        ;;
    *)
        # A bare path, so this can also serve as the MIME handler.
        open_book "$1"
        ;;
esac
