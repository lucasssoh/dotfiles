#!/usr/bin/env python3
"""Pellicule: retakes the documentation's screenshots, in light and dark.

    scripts/pellicule                  every scene in docs/screenshots/scenes.toml
    scripts/pellicule balise mixer     only these scenes
    scripts/pellicule --mode dark      only one mode
    scripts/pellicule --scale 1.25     only if the screen is at that scale
    scripts/pellicule --out DIR        write elsewhere than docs/screenshots
    scripts/pellicule --video hero     records a [[video]] instead: the site's WebM, and the exports
    scripts/pellicule --video hero --encode   encodes its last recording again
    scripts/pellicule showcase         puts the [[showcase]] pictures together again
    scripts/pellicule check            check the scenes against the running shell
    scripts/pellicule list             the scenes, with their docs

A scene is a list of steps run on an empty workspace, then a screenshot,
cropped and saved as NAME.webp (light) and NAME-dark.webp; the whole
screen is kept in the cache for the showcase pictures.

The scale is yours to set before the run, never changed by it (a scale
change under WezTerm closes every one of its windows): the scale nearest
the frame keeps the shell the same size in every picture, at the screen's
full resolution (2560x1440 at 1.25 shows 2048x1152, 2560x1600 at 1.333
shows 1920x1200). `--scale 1.25` checks the screen is at it before
anything is taken; without it, the run says which scale would fit. HDR
is off for the run, and back at the end.

Any screen and any scale will do. The crops are written in the shell's
pixels on the `size` frame of scenes.toml (F = 1920 x 1200). On a screen of
M physical pixels at scale k, the shell's pixels are S = M / k, and a crop
[x, y, w, h] of the frame lands, along each axis, at

    x' = 0,  w' = S            if it touches both edges (a band across)
    x' = x                     if it touches the frame's start edge (x <= 0)
    x' = S - w                 if it touches the far edge (x + w >= F)
    x' = x + (S - F) / 2       otherwise (it stays where it was, centred)

clamped to [0, S - w], with w' = min(w, S) but for a band; then everything is multiplied
by k, so the picture keeps the screen's full resolution. A drawer on the
right stays on the right, a card in the middle stays in the middle. The shell runs
in demo mode the whole time (made-up time, battery, figures), and
everything is put back at the end, Ctrl+C included: the colour scheme, the
wallpaper, the workspace, demo mode, the windows a scene opened.

Steps, one string each:
    ipc TARGET FUNCTION [ARGS...]   qs -c bar ipc call TARGET FUNCTION ARGS
                                    ({library}: the made-up games, see [[settings.game]])
    wait SECONDS
    run COMMAND...                  started in the background, killed at the end of the scene
    close CLASS [last]              closes the windows of that class on the workspace, as Super+Q
                                    (last: only the newest)
    key KEY                         types a key into the app in front (Right, c, Return),
                                    on a keyboard of its own; a combination with + is a
                                    shortcut, as Hyprland gets it (super+Return, super+shift+s)
    down KEY / up KEY               holds a key, lets it go (down super: the key sheet)
    scheme light|dark               switches the colour scheme, as the bar's toggle
    notify APP | SUMMARY | BODY [| OPTIONS]
                                    a notification (closed when demo mode ends); OPTIONS,
                                    space-separated: entry=DESKTOP_ID (the app's icon),
                                    icon=NAME, image=PATH ({repo}; a .webp is handed over
                                    as PNG), urgency=low|normal|critical

A [[video]] may set its own `wallpaper`, and `repeat = [RATE, DELAY]`:
the key repeat for the run (keys a second, ms before it starts), so a
held key runs through a known number of cards; yours comes back at the
end. `wallpapers = ["coucou-*", "gnome-*"]` keeps Prisme to the
wallpapers that match for the run.

In a video, the keys typed show at the bottom right, white on dark grey
squares, put on the picture when it is encoded ([[video]] `keys = false`
leaves them out).

The pointer is hidden for the whole run, and parked out of the way for
every scene (settings `pointer`), then shown and put back at the end: under it, a pop-up lightens, shows its x and
holds its timer.

The calls this file makes to the shell, Hyprland and gsettings are the
ones its users can break. `check` compares every `ipc` step with what the
shell exposes and every `run` with the commands installed; run it after
changing an IpcHandler or a command a scene uses (AGENTS.md says so).
"""

import argparse
import json
import os
import shlex
import signal
import subprocess
import sys
import tempfile
import time
import tomllib
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
SCENES = REPO / "docs" / "screenshots" / "scenes.toml"

# The colour scheme as the bar's own toggle sets it (AppearanceState.qml).
SCHEMES = {
    "light": ("prefer-light", "Adwaita-light"),
    "dark": ("prefer-dark", "Adwaita-dark"),
}


def say(msg):
    print(msg, flush=True)


def fail(msg):
    print(f"pellicule: {msg}", file=sys.stderr)
    sys.exit(1)


def sh(*args, check=True, capture=True):
    r = subprocess.run(args, text=True, capture_output=capture)
    if check and r.returncode != 0:
        raise RuntimeError(f"{' '.join(args)}: {(r.stderr or r.stdout).strip()}")
    return r.stdout.strip() if capture else ""


# ---- the shell, Hyprland, gsettings ----------------------------------------

def ipc(target, function, *args):
    return sh("qs", "-c", "bar", "ipc", "call", target, function, *args)


def ipc_surface():
    """{target: {function: number of arguments}} from the running shell.
    Waits up to 10 s for it: while the bar reloads after an edit, its
    targets come back one by one."""
    for _ in range(10):
        surface = _ipc_surface()
        if "bar" in surface:
            return surface
        time.sleep(1)
    return surface


def _ipc_surface():
    out = sh("qs", "-c", "bar", "ipc", "show")
    surface, target = {}, None
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("target "):
            target = line.split()[1]
            surface[target] = {}
        elif line.startswith("function ") and target:
            name, _, rest = line[len("function "):].partition("(")
            params = rest.split(")")[0].strip()
            surface[target][name] = 0 if not params else params.count(",") + 1
    return surface


def scheme_get():
    return (sh("gsettings", "get", "org.gnome.desktop.interface", "color-scheme").strip("'"),
            sh("gsettings", "get", "org.gnome.desktop.interface", "gtk-theme").strip("'"))


def scheme_set(scheme, theme):
    sh("gsettings", "set", "org.gnome.desktop.interface", "color-scheme", scheme)
    sh("gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", theme)


def workspace_get():
    import json
    return str(json.loads(sh("hyprctl", "-j", "activeworkspace"))["id"])


def pointer_get():
    pos = json.loads(sh("hyprctl", "-j", "cursorpos"))
    return pos["x"], pos["y"]


def pointer_go(x, y):
    sh("hyprctl", "eval", f"hl.dispatch(hl.dsp.cursor.move({{ x = {int(x)}, y = {int(y)} }}))")


def cursor_hidden_get():
    return json.loads(sh("hyprctl", "-j", "getoption", "cursor:invisible")).get("bool") is True


def cursor_hide(on):
    sh("hyprctl", "eval", f"hl.config({{ cursor = {{ invisible = {'true' if on else 'false'} }} }})")


def workspace_go(ws):
    sh("hyprctl", "eval", f'hl.dispatch(hl.dsp.focus({{ workspace = "{ws}" }}))')


# ---- keys -------------------------------------------------------------------
# A key step types one key into the app in front (Prisme has no other
# way in), on a keyboard of its own (uinput). Keys are keysym names, found
# in Hyprland's layout: c is c wherever the layout puts it.

def keymap_codes(names):
    """The evdev keycode of each keysym name in Hyprland's layout, through
    libxkbcommon. A name the layout cannot type is left out."""
    import ctypes
    xkb = ctypes.CDLL("libxkbcommon.so.0")
    xkb.xkb_context_new.restype = ctypes.c_void_p
    xkb.xkb_keymap_new_from_names.restype = ctypes.c_void_p
    xkb.xkb_keymap_new_from_names.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int]
    xkb.xkb_keymap_key_get_syms_by_level.argtypes = [
        ctypes.c_void_p, ctypes.c_uint32, ctypes.c_uint32, ctypes.c_uint32,
        ctypes.POINTER(ctypes.POINTER(ctypes.c_uint32))]
    xkb.xkb_keysym_from_name.restype = ctypes.c_uint32
    xkb.xkb_keymap_unref.argtypes = [ctypes.c_void_p]
    xkb.xkb_context_unref.argtypes = [ctypes.c_void_p]

    def option(name):
        out = json.loads(sh("hyprctl", "-j", "getoption", f"input:{name}")).get("str", "")
        return out.encode() if out and out != "[[EMPTY]]" else None

    class Names(ctypes.Structure):
        _fields_ = [(f, ctypes.c_char_p) for f in ("rules", "model", "layout", "variant", "options")]

    rmlvo = Names(option("kb_rules"), option("kb_model"), option("kb_layout"),
                  option("kb_variant"), option("kb_options"))
    ctx = xkb.xkb_context_new(0)
    keymap = xkb.xkb_keymap_new_from_names(ctx, ctypes.byref(rmlvo), 0)
    if not keymap:
        xkb.xkb_context_unref(ctx)
        raise RuntimeError("libxkbcommon could not build Hyprland's keymap")
    wanted = {xkb.xkb_keysym_from_name(n.encode(), 0): n for n in names}
    found = {}
    syms = ctypes.POINTER(ctypes.c_uint32)()
    for code in range(8, 256):
        # Level 0 only: a key typed without Shift.
        for i in range(xkb.xkb_keymap_key_get_syms_by_level(keymap, code, 0, 0, ctypes.byref(syms))):
            name = wanted.get(syms[i])
            if name and name not in found:
                found[name] = code - 8
    xkb.xkb_keymap_unref(keymap)
    xkb.xkb_context_unref(ctx)
    return found


class Keyboard:
    """A virtual keyboard on /dev/uinput, made at the first key step."""

    EV_SYN, EV_KEY = 0, 1
    UI_SET_EVBIT, UI_SET_KEYBIT = 0x40045564, 0x40045565
    UI_DEV_SETUP, UI_DEV_CREATE, UI_DEV_DESTROY = 0x405C5503, 0x5501, 0x5502

    def __init__(self):
        import fcntl
        import struct
        self.fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
        fcntl.ioctl(self.fd, self.UI_SET_EVBIT, self.EV_KEY)
        for code in range(1, 256):
            fcntl.ioctl(self.fd, self.UI_SET_KEYBIT, code)
        fcntl.ioctl(self.fd, self.UI_DEV_SETUP, struct.pack("4H80sI", 0x06, 1, 1, 1, b"pellicule", 0))
        fcntl.ioctl(self.fd, self.UI_DEV_CREATE)
        # Hyprland has to see the new keyboard before its first key.
        time.sleep(0.6)

    def send(self, code, value):
        import struct
        os.write(self.fd, struct.pack("llHHi", 0, 0, self.EV_KEY, code, value))
        os.write(self.fd, struct.pack("llHHi", 0, 0, self.EV_SYN, 0, 0))
        time.sleep(0.04)

    def press(self, code):
        self.send(code, 1)
        self.send(code, 0)

    def close(self):
        import fcntl
        try:
            fcntl.ioctl(self.fd, self.UI_DEV_DESTROY)
        finally:
            os.close(self.fd)


# Modifiers by their evdev code: the layout does not move them.
MODIFIERS = {"super": 125, "shift": 42, "ctrl": 29, "alt": 56}
# What a key's square shows; a letter shows upper case.
KEY_LABELS = {"super": "Super", "shift": "Shift", "ctrl": "Ctrl", "alt": "Alt",
              "Return": "Enter", "Escape": "Esc", "Delete": "Del", "BackSpace": "⌫",
              "Tab": "Tab", "space": "Space", "Left": "←", "Right": "→", "Up": "↑", "Down": "↓",
              "Prior": "PgUp", "Next": "PgDn", "Home": "Home", "End": "End"}


def key_label(name):
    return KEY_LABELS.get(name, name.upper() if len(name) == 1 else name)


def key_parts(spec):
    """super+shift+s: the modifiers, then the key (a modifier alone is a key too)."""
    parts = spec.split("+")
    return parts[:-1], parts[-1]


WALLPAPER_SET = Path.home() / ".config/hypr/scripts/wallpaper-set"
# Prisme opens on the playlist's `last_static`, your own choice.
PLAYLIST = Path.home() / ".config/hypr/wallpaper-playlist.json"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "pellicule"
# The wallpaper folder Prisme and wallpaper-set read, one line.
PRISME_DIR_CONF = Path.home() / ".config/prisme/wallpapers.conf"


def wallpapers_dir():
    """The wallpaper folder, as Prisme reads it: the first line of its
    wallpapers.conf that isn't a comment, ~/Images/Wallpapers otherwise."""
    try:
        for line in PRISME_DIR_CONF.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#"):
                return Path(os.path.expanduser(line))
    except OSError:
        pass
    return Path.home() / "Images/Wallpapers"
STEAM_ART = "https://cdn.cloudflare.steamstatic.com/steam/apps/{id}/{file}"


def library(settings):
    """The made-up game library's JSON file, for `ipc controller library
    {library}`: the [[game]] list of scenes.toml, with Steam's public
    artwork downloaded once into the cache (never into the repository)."""
    import json
    import urllib.request
    games, now = [], int(time.time())
    for i, g in enumerate(settings.get("game", [])):
        art = CACHE / "steam" / str(g["steam"])
        art.mkdir(parents=True, exist_ok=True)
        files = {}
        for key, name in (("cover", "library_600x900.jpg"), ("hero", "library_hero.jpg")):
            path = art / name
            if not path.exists():
                urllib.request.urlretrieve(STEAM_ART.format(id=g["steam"], file=name), path)
            files[key] = str(path)
        # Played an hour, then a day, then more ago: the first one is
        # the menu's "Continue".
        games.append({"title": g["title"], "source": "Steam",
                      "last": now - 3600 * (1 + 20 * i), **files})
    path = CACHE / "library.json"
    path.write_text(json.dumps(games))
    return path


def wallpaper_get():
    """The name of the wallpaper on screen (awww shows a fitted copy of it)."""
    for line in sh("awww", "query").splitlines():
        if "image: " in line:
            return Path(line.split("image: ", 1)[1]).name
    return None


def wallpaper_set(name):
    sh(str(WALLPAPER_SET), "--instant", name)


def clients():
    import json
    return json.loads(sh("hyprctl", "-j", "clients"))


def monitor():
    """The focused screen: its name, its size in the shell's pixels, its scale."""
    import json
    ms = json.loads(sh("hyprctl", "-j", "monitors"))
    m = next((m for m in ms if m.get("focused")), ms[0])
    scale = float(m.get("scale", 1)) or 1.0
    # a rotated screen is taller than wide
    w, h = (m["height"], m["width"]) if m.get("transform", 0) % 2 else (m["width"], m["height"])
    return {"name": m["name"], "x": m["x"], "y": m["y"], "size": (round(w / scale), round(h / scale)), "scale": scale}


# Set once the run starts: where the frame's crops land on this screen.
SCREEN = {"frame": (1920, 1200), "size": (1920, 1200), "scale": 1.0, "x": 0, "y": 0, "name": ""}


WORKSPACE_MANAGER = Path.home() / ".config/hypr/scripts/workspace-manager.sh"


def monitor_raw():
    ms = json.loads(sh("hyprctl", "-j", "monitors"))
    return next((m for m in ms if m.get("focused")), ms[0])


def take_scale(width, height, frame):
    """The scale nearest to the one that brings the screen to the frame:
    a multiple of 1/120 (what Wayland's fractional scaling speaks) that
    divides the screen into whole pixels, so nothing is resampled."""
    fw, fh = frame
    want = max(1.0, min(width / fw, height / fh))
    fits = [n / 120 for n in range(120, 481)
            if (width * 120) % n == 0 and (height * 120) % n == 0]
    return min(fits, key=lambda k: (abs(k - want), -k)) if fits else 1.0


def screen_prepare(settings, scale=None):
    """SDR for the run, the scale as it is. With `scale`, stops before
    anything changes if the screen is not at it. Returns whether the screen
    was changed, so the end puts it back."""
    m = monitor_raw()
    w, h = (m["height"], m["width"]) if m.get("transform", 0) % 2 else (m["width"], m["height"])
    now = float(m.get("scale", 1))
    best = take_scale(w, h, tuple(settings.get("size", [1920, 1200])))
    if scale is not None and abs(now - scale) > 0.001:
        fail(f"{m['name']} is at scale {now:g}, not {scale:g}: set it in the display settings, then run again")
    if scale is None and abs(now - best) > 0.001:
        say(f"{m['name']} is at scale {now:g}; {best:g} keeps the shell the size of the frame (--scale {best:g})")
    if "2101010" not in str(m.get("currentFormat", "")):
        return False
    rule = (f'hl.monitor({{ output = "{m["name"]}", disabled = false, '
            f'mode = "{m["width"]}x{m["height"]}@{m["refreshRate"]:.3f}", position = "{m["x"]}x{m["y"]}", '
            f'scale = {now:.6f}, transform = {m.get("transform", 0)}, bitdepth = 8, cm = "auto" }})')
    sh("hyprctl", "eval", rule)
    # the bar, the wallpaper and the windows settle in SDR
    time.sleep(2)
    return True


def repeat_get():
    get = lambda o: json.loads(sh("hyprctl", "-j", "getoption", f"input:{o}"))["int"]
    return get("repeat_rate"), get("repeat_delay")


def repeat_set(rate, delay):
    sh("hyprctl", "eval", f"hl.config({{ input = {{ repeat_rate = {int(rate)}, repeat_delay = {int(delay)} }} }})")


def screen_restore():
    """The screens as their settings say, as on any change of screens."""
    if WORKSPACE_MANAGER.exists():
        subprocess.run([str(WORKSPACE_MANAGER)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        sh("hyprctl", "reload", check=False)
    time.sleep(1.5)


def screen_set(settings):
    """Reads the focused screen once, before the first take."""
    m = monitor()
    SCREEN.update(m, frame=tuple(settings.get("size", [1920, 1200])))
    # the showcase lays its crops on these captures later, on this screen's terms
    SCREEN_FILE.parent.mkdir(parents=True, exist_ok=True)
    SCREEN_FILE.write_text(json.dumps({k: SCREEN[k] for k in ("size", "scale", "frame")}))
    if SCREEN["size"] != SCREEN["frame"] or SCREEN["scale"] != 1:
        w, h = SCREEN["size"]
        say(f"{m['name']}, {w}x{h} at scale {SCREEN['scale']:g}: the crops follow the screen")


def place(crop):
    """A crop of the frame, on the screen: the same size, along the edges it
    touches (in the middle when it touches neither), in the picture's pixels."""
    fw, fh = SCREEN["frame"]
    sw, sh_ = SCREEN["size"]
    k = SCREEN["scale"]
    x, y, w, h = crop
    def along(pos, size, frame, screen):
        if pos <= 0 and pos + size >= frame:
            return 0, screen
        size = min(size, screen)
        if pos <= 0:
            return 0, size
        if pos + size >= frame:
            return screen - size, size
        return max(0, min(screen - size, pos + (screen - frame) // 2)), size
    (x, w), (y, h) = along(x, w, fw, sw), along(y, h, fh, sh_)
    return [round(v * k) for v in (x, y, w, h)]


def place_point(x, y):
    """A point of the frame (the parked pointer), on the screen, in its own coordinates."""
    fw, fh = SCREEN["frame"]
    sw, sh_ = SCREEN["size"]
    return SCREEN["x"] + x + (sw - fw) // 2, SCREEN["y"] + y + (sh_ - fh)


# ---- scenes -----------------------------------------------------------------

def load(path):
    with open(path, "rb") as f:
        data = tomllib.load(f)
    settings = data.get("settings", {})
    scenes = data.get("scene", [])
    videos = data.get("video", [])
    showcases = data.get("showcase", [])
    return settings, scenes, videos, showcases


def check(settings, scenes, surface=None):
    """Problems, as "scene: what" lines. Empty when everything holds."""
    problems = []
    seen = set()
    if surface is None:
        try:
            surface = ipc_surface()
        except Exception as e:
            return [f"the shell does not answer ({e}); is the bar running?"]
    w, h = settings.get("size", [1920, 1200])
    wp = settings.get("wallpaper")
    if wp and subprocess.run([str(WALLPAPER_SET), "--resolve", wp], capture_output=True).returncode != 0:
        problems.append(f"settings: wallpaper {wp!r} is not in the wallpaper folder")
    for s in scenes:
        name = s.get("name", "?")
        where = f"{name}"
        if name in seen:
            problems.append(f"{where}: two scenes have this name")
        seen.add(name)
        crop = s.get("crop", "full")
        if crop != "full":
            if len(crop) != 4:
                problems.append(f"{where}: crop is [x, y, width, height] or \"full\"")
            else:
                x, y, cw, ch = crop
                if x < 0 or y < 0 or x + cw > w or y + ch > h:
                    problems.append(f"{where}: crop {crop} leaves the {w}x{h} screen")
        for mode in s.get("modes", ["light", "dark"]):
            if mode not in SCHEMES:
                problems.append(f"{where}: unknown mode {mode!r}")
        audio = s.get("audio")
        if audio and not Path(audio).expanduser().is_file():
            problems.append(f"{where}: no audio file at {audio}")
        doc = s.get("doc")
        if doc and not (REPO / doc).exists():
            problems.append(f"{where}: {doc} does not exist")
        for step in s.get("steps", []) + s.get("after", []):
            problems += [f"{where}: {p}" for p in check_step(step, surface)]
    return problems


def check_step(step, surface):
    try:
        words = shlex.split(step)
    except ValueError as e:
        return [f"{step!r}: {e}"]
    if not words:
        return ["an empty step"]
    verb, args = words[0], words[1:]
    if verb == "ipc":
        if len(args) < 2:
            return [f"{step!r}: ipc TARGET FUNCTION [ARGS...]"]
        target, function, rest = args[0], args[1], args[2:]
        if target not in surface:
            return [f"{step!r}: the shell has no ipc target {target!r}"]
        if function not in surface[target]:
            return [f"{step!r}: {target} has no function {function!r}"]
        want = surface[target][function]
        if len(rest) != want:
            return [f"{step!r}: {target} {function} takes {want} argument(s), not {len(rest)}"]
        return []
    if verb == "wait":
        try:
            float(args[0])
            return []
        except (IndexError, ValueError):
            return [f"{step!r}: wait SECONDS"]
    if verb == "run":
        if not args:
            return [f"{step!r}: run COMMAND..."]
        cmd = os.path.expanduser(args[0].replace("{repo}", str(REPO)))
        found = os.access(cmd, os.X_OK) if "/" in cmd else subprocess.run(
            ["sh", "-c", f"command -v {shlex.quote(cmd)}"], capture_output=True).returncode == 0
        return [] if found else [f"{step!r}: {args[0]} is not installed"]
    if verb == "close":
        return [] if len(args) == 1 or args[1:] == ["last"] else [f"{step!r}: close CLASS [last]"]
    if verb in ("key", "down", "up"):
        if len(args) != 1:
            return [f"{step!r}: {verb} KEY"]
        mods, key = key_parts(args[0])
        if verb != "key" and mods:
            return [f"{step!r}: {verb} takes one key"]
        bad = [m for m in mods if m not in MODIFIERS]
        if bad:
            return [f"{step!r}: {bad[0]!r} is not super, shift, ctrl or alt"]
        if key in MODIFIERS:
            return []
        codes = KEY_CODES.setdefault("codes", {})
        if key not in codes:
            codes.update(keymap_codes([key]))
        return [] if key in codes else [f"{step!r}: the keyboard layout has no key {key!r}"]
    if verb == "scheme":
        return [] if args in (["light"], ["dark"]) else [f"{step!r}: scheme light|dark"]
    if verb == "notify":
        parts = " ".join(args).split("|")
        if len(parts) not in (3, 4):
            return [f"{step!r}: notify APP | SUMMARY | BODY [| OPTIONS]"]
        problems = []
        for opt in (parts[3].split() if len(parts) == 4 else []):
            key, _, value = opt.partition("=")
            if key not in NOTIFY_OPTIONS or not value:
                problems.append(f"{step!r}: {opt!r} is not entry=, icon=, image= or urgency=")
            elif key == "urgency" and value not in ("low", "normal", "critical"):
                problems.append(f"{step!r}: urgency is low, normal or critical")
            elif key == "image" and not Path(value.replace("{repo}", str(REPO))).expanduser().is_file():
                problems.append(f"{step!r}: no image at {value}")
        return problems
    return [f"{step!r}: unknown step {verb!r}"]


NOTIFY_OPTIONS = ("entry", "icon", "image", "urgency")
# The keymap's codes, looked up once per run by the key steps.
KEY_CODES = {}


def notify_args(options):
    """notify-send's arguments for a notify step's OPTIONS. Qt reads no
    WebP here, so a .webp image goes over as a PNG copy in the cache."""
    out = []
    for opt in options.split():
        key, _, value = opt.partition("=")
        if key == "entry":
            out += ["-h", f"string:desktop-entry:{value}"]
        elif key == "icon":
            out += ["-i", value]
        elif key == "urgency":
            out += ["-u", value]
        elif key == "image":
            path = Path(value.replace("{repo}", str(REPO))).expanduser()
            if path.suffix.lower() == ".webp":
                from PIL import Image
                png = CACHE / "notify" / (path.stem + ".png")
                png.parent.mkdir(parents=True, exist_ok=True)
                if not png.exists() or png.stat().st_mtime < path.stat().st_mtime:
                    Image.open(path).save(png)
                path = png
            out += ["-h", f"string:image-path:{path}"]
    return out


class Take:
    """One run: what to put back, and the windows to close."""

    def __init__(self, settings):
        self.ws = str(settings.get("workspace", "9"))
        self.saved_scheme = scheme_get()
        self.saved_ws = workspace_get()
        self.saved_demo = ipc("demo", "status") == "on"
        self.settings = settings
        self._library = None
        self.wallpaper = settings.get("wallpaper")
        self.saved_wallpaper = wallpaper_get() if self.wallpaper else None
        self.saved_playlist = PLAYLIST.read_bytes() if self.wallpaper and PLAYLIST.exists() else None
        # Only these wallpapers in Prisme for the run (patterns, `gnome-*`):
        # its cards show their neighbours, and yours may not be free to film.
        self.wallpapers = settings.get("wallpapers")
        self.saved_dir_conf = None
        self.dir_conf_changed = False
        self.procs = []
        self.notes = []
        self.pointer = tuple(settings.get("pointer", [960, 1100]))
        self.saved_pointer = pointer_get()
        self.keyboard = None
        self.keylog = None
        self.t0 = 0.0
        self.screen_changed = False
        self.saved_repeat = None
        self.saved_cursor_hidden = cursor_hidden_get()

    def park(self):
        pointer_go(*place_point(*self.pointer))

    def start(self):
        busy = [c for c in clients() if str(c["workspace"]["id"]) == self.ws]
        if busy:
            fail(f"workspace {self.ws} is not empty ({busy[0]['class']}); "
                 "close its windows or set another one in scenes.toml")
        self.screen_changed = screen_prepare(self.settings, self.settings.get("_scale"))
        screen_set(self.settings)
        if self.settings.get("repeat"):
            self.saved_repeat = repeat_get()
            repeat_set(*self.settings["repeat"])
        ipc("demo", "on")
        # Out of every picture and video; still parked, for what it hovers.
        cursor_hide(True)
        if self.wallpapers:
            self.narrow_wallpapers()
        if self.wallpaper:
            # One file of a light/dark pair stands for both: the scheme
            # changes below bring the other half.
            wallpaper_set(self.wallpaper)
            # So Prisme opens on it too.
            try:
                playlist = json.loads(self.saved_playlist or b"{}")
            except ValueError:
                playlist = {}
            playlist["last_static"] = self.wallpaper
            PLAYLIST.write_text(json.dumps(playlist))
        workspace_go(self.ws)
        time.sleep(0.8)

    def narrow_wallpapers(self):
        """A folder of links to the wallpapers the run may show, named as
        the originals so Prisme finds its thumbnails, set as the folder."""
        src = wallpapers_dir()
        box = CACHE / "wallpapers"
        if box.exists():
            for f in box.iterdir():
                f.unlink()
        box.mkdir(parents=True, exist_ok=True)
        for pattern in self.wallpapers:
            for f in sorted(src.glob(pattern)):
                (box / f.name).symlink_to(f.resolve())
        if PRISME_DIR_CONF.is_symlink():
            self.saved_dir_conf = Path(os.readlink(PRISME_DIR_CONF))
        elif PRISME_DIR_CONF.exists():
            self.saved_dir_conf = PRISME_DIR_CONF.read_bytes()
        PRISME_DIR_CONF.parent.mkdir(parents=True, exist_ok=True)
        PRISME_DIR_CONF.unlink(missing_ok=True)   # a link to the repo stays untouched
        PRISME_DIR_CONF.write_text(f"{box}\n")
        self.dir_conf_changed = True

    def step(self, step):
        words = shlex.split(step)
        verb, args = words[0], words[1:]
        if verb == "ipc":
            if "{library}" in args:
                self._library = self._library or library(self.settings)
                args = [str(self._library) if a == "{library}" else a for a in args]
            ipc(*args)
        elif verb == "wait":
            time.sleep(float(args[0]))
        elif verb == "run":
            cmd = [os.path.expanduser(a.replace("{repo}", str(REPO))) for a in args]
            self.procs.append(subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                                               stderr=subprocess.DEVNULL, start_new_session=True))
        elif verb == "close":
            self.close(args[0], last=args[1:] == ["last"])
        elif verb in ("key", "down", "up"):
            mods, key = key_parts(args[0])
            codes = KEY_CODES.setdefault("codes", {})
            if key not in MODIFIERS and key not in codes:
                codes.update(keymap_codes([key]))
            code = MODIFIERS.get(key) or codes[key]
            self.keyboard = self.keyboard or Keyboard()
            # in a video, when: for the squares put on it at the end
            if self.keylog is not None:
                self.keylog.append([round(time.monotonic() - self.t0, 3), verb,
                                    [key_label(m) for m in mods] + [key_label(key)]])
            if verb == "down":
                self.keyboard.send(code, 1)
            elif verb == "up":
                self.keyboard.send(code, 0)
            else:
                for m in mods:
                    self.keyboard.send(MODIFIERS[m], 1)
                self.keyboard.press(code)
                for m in reversed(mods):
                    self.keyboard.send(MODIFIERS[m], 0)
        elif verb == "scheme":
            scheme_set(*SCHEMES[args[0]])
        elif verb == "notify":
            parts = [p.strip() for p in " ".join(args).split("|")]
            app, summary, body = parts[:3]
            extra = notify_args(parts[3]) if len(parts) == 4 else []
            nid = subprocess.run(["notify-send", "-p", "-a", app, *extra, summary, body],
                                 capture_output=True, text=True, check=True).stdout.strip()
            self.notes.append(nid)

    def close(self, cls=None, last=False):
        """Closes the workspace's windows (of that class) as Super+Q does,
        so a browser quits cleanly and does not offer to restore its pages
        next time. A program still there after 2 s is ended, unless it also
        has windows elsewhere (your browser, say). `last`: only the newest
        one, Hyprland listing its windows in the order they opened."""
        def mine():
            return [c for c in clients() if str(c["workspace"]["id"]) == self.ws
                    and (not cls or c["class"] == cls)]
        targets = mine()[-1:] if last else mine()
        gone = {c["address"] for c in targets}
        for c in targets:
            sh("hyprctl", "eval",
               f'hl.dispatch(hl.dsp.window.close({{ window = "address:{c["address"]}" }}))')
        deadline = time.time() + 2
        while targets and time.time() < deadline:
            time.sleep(0.1)
            targets = [c for c in mine() if c["address"] in gone]
        elsewhere = {c["pid"] for c in clients() if str(c["workspace"]["id"]) != self.ws}
        for c in targets:
            if c["pid"] not in elsewhere:
                try:
                    os.kill(c["pid"], signal.SIGTERM)
                except ProcessLookupError:
                    pass

    def end_scene(self):
        for p in self.procs:
            if p.poll() is None:
                try:
                    os.killpg(p.pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
        self.procs = []
        # The scene's notifications go with it, or the next mode's take of
        # the centre shows them twice.
        for nid in self.notes:
            subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
                            "--object-path", "/org/freedesktop/Notifications",
                            "--method", "org.freedesktop.Notifications.CloseNotification", nid],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.notes = []
        self.close()

    def restore(self):
        try:
            self.end_scene()
        finally:
            if self.keyboard:
                self.keyboard.close()
            if self._library:
                ipc("controller", "reset")
            if not self.saved_demo:
                ipc("demo", "off")
            scheme_set(*self.saved_scheme)
            if self.saved_playlist is not None:
                PLAYLIST.write_bytes(self.saved_playlist)
            elif self.wallpaper:
                PLAYLIST.unlink(missing_ok=True)
            if self.dir_conf_changed:
                # Before your wallpaper comes back: it may be one the run left out.
                PRISME_DIR_CONF.unlink(missing_ok=True)
                if isinstance(self.saved_dir_conf, Path):
                    PRISME_DIR_CONF.symlink_to(self.saved_dir_conf)
                elif self.saved_dir_conf is not None:
                    PRISME_DIR_CONF.write_bytes(self.saved_dir_conf)
            if self.saved_wallpaper:
                time.sleep(1)   # after the scheme's own swap, not raced by it
                wallpaper_set(self.saved_wallpaper)
            if self.saved_repeat:
                repeat_set(*self.saved_repeat)
            if self.screen_changed:
                screen_restore()
            workspace_go(self.saved_ws)
            pointer_go(*self.saved_pointer)
            cursor_hide(self.saved_cursor_hidden)


def shoot(scene, mode, take, out, settings):
    from PIL import Image
    take.park()
    for step in scene.get("steps", []):
        take.step(step)
    with tempfile.NamedTemporaryFile(suffix=".png") as raw:
        sh("grim", "-o", SCREEN["name"], raw.name)
        img = Image.open(raw.name).convert("RGB")
    # The whole screen too, for the showcase pictures.
    full = full_path(scene["name"], mode)
    full.parent.mkdir(parents=True, exist_ok=True)
    img.save(full)
    for step in scene.get("after", []):
        take.step(step)
    take.end_scene()
    crop = scene.get("crop", "full")
    if crop != "full":
        x, y, w, h = place(crop)
        img = img.crop((x, y, x + w, y + h))
    width = scene.get("width", settings.get("width"))
    if width and img.width > width:
        img = img.resize((width, round(img.height * width / img.width)), Image.LANCZOS)
    name = scene["name"] + ("" if mode == "light" else "-dark")
    path = out / f"{name}.webp"
    img.save(path, quality=settings.get("quality", 85), method=6)
    return path


def full_path(name, mode):
    return CACHE / "full" / (name + ("" if mode == "light" else "-dark") + ".png")


SHOWCASE = REPO / "docs" / "screenshots" / "showcase.html"
# The screen the full captures were taken on.
SCREEN_FILE = CACHE / "full" / "screen.json"


def check_showcases(showcases, scenes):
    problems = []
    modes = {s["name"]: s.get("modes", ["light", "dark"]) for s in scenes}
    crops = {s["name"]: s.get("crop", "full") for s in scenes}
    for sc in showcases:
        where = f"showcase {sc.get('name')}"
        mode = sc.get("mode", "light")
        names = sc.get("back", []) + sc.get("front", []) + ([sc["blank"]] if sc.get("blank") else [])
        if not sc.get("back") or not sc.get("front"):
            problems.append(f"{where}: needs a back and a front screen")
        for name in names:
            if name not in modes:
                problems.append(f"{where}: no scene called {name}")
            elif mode not in modes[name]:
                problems.append(f"{where}: {name} is not taken in {mode} mode")
        for name in sc.get("back", [])[1:] + sc.get("front", [])[1:]:
            if crops.get(name) == "full":
                problems.append(f"{where}: {name} has no crop to lay on the screen")
    return problems


def screen(names, mode, blank, crops):
    """One screen of a showcase: the first scene's whole screen, with the
    others' crops laid on it. They all share the same frozen desktop, so
    there is no seam. With `blank` (the empty desktop's scene), only what
    each one adds to it is laid, so its crop's margins cover nothing."""
    from PIL import Image, ImageChops
    img = Image.open(full_path(names[0], mode)).convert("RGB")
    for n in names[1:]:
        x, y, w, h = place(crops[n])
        box = (x, y, x + w, y + h)
        part = Image.open(full_path(n, mode)).convert("RGB")
        if blank:
            base = Image.open(full_path(blank, mode)).convert("RGB")
            bb = ImageChops.difference(part.crop(box), base.crop(box)).convert("L") \
                .point(lambda v: 255 if v > 18 else 0).getbbox()
            if bb:
                pad = round(40 * SCREEN["scale"])
                box = (max(x, x + bb[0] - pad), max(y, y + bb[1] - pad),
                       min(x + w, x + bb[2] + pad), min(y + h, y + bb[3] + pad))
        img.paste(part.crop(box), box[:2])
    return img


def compose(sc, out, settings, scenes):
    """The showcase picture: two screens in cascade, drawn by
    showcase.html and rendered by Firefox. NAME.webp here, NAME.png at full
    size in the cache, for other uses (a portfolio)."""
    from PIL import Image
    from urllib.parse import urlencode
    mode = sc.get("mode", "light")
    blank = sc.get("blank")
    needed = [full_path(n, mode) for n in sc["back"] + sc["front"] + ([blank] if blank else [])]
    missing = [f.name for f in needed if not f.exists()]
    if missing:
        fail(f"showcase {sc['name']}: take {', '.join(missing)} first")
    crops = {s["name"]: s.get("crop") for s in scenes}
    parts = CACHE / "showcase" / "parts"
    parts.mkdir(parents=True, exist_ok=True)
    urls = {}
    for key in ("back", "front"):
        path = parts / f"{sc['name']}-{key}.png"
        screen(sc[key], mode, blank, crops).save(path)
        urls[key] = path.as_uri()
    w, h = sc.get("size", [2560, 1600])
    png = CACHE / "showcase" / f"{sc['name']}.png"
    url = SHOWCASE.as_uri() + "?" + urlencode({**urls, "mode": mode})
    with tempfile.TemporaryDirectory(prefix="pellicule-firefox-") as profile:
        sh("firefox", "--headless", "--no-remote", "--profile", profile,
           f"--window-size={w},{h}", "--screenshot", str(png), url)
    img = Image.open(png).convert("RGB")
    width = sc.get("width", 1600)
    small = img.resize((width, round(img.height * width / img.width)), Image.LANCZOS)
    webp = out / f"{sc['name']}.webp"
    small.save(webp, quality=settings.get("quality", 85), method=6)
    return webp, png


def raw_path(video):
    return CACHE / f"{video['name']}.mkv"


def keys_path(video):
    """The keys typed during the recording, with their time from the first step."""
    return CACHE / f"{video['name']}.keys.json"


def key_spans(log, length, offset, linger=1.2, tap=0.18):
    """[(start, end, labels, pressed)]: what the keys show, in the video's
    time, and which of them are down. A shortcut shows for `linger` seconds,
    pressed for the first `tap` of them, with the keys held under it; a key
    held shows, pressed, until it is let go."""
    held, flash = [], None
    points = []
    for t, verb, labels in log:
        t += offset
        if verb == "down":
            held = held + [l for l in labels if l not in held]
            flash = None
        elif verb == "up":
            held = [l for l in held if l not in labels]
            flash = None
        else:
            flash = (held + [l for l in labels if l not in held], t + linger)
        points.append((t, list(held), flash))
    spans = []
    for i, (t, held_now, fl) in enumerate(points):
        nxt = points[i + 1][0] if i + 1 < len(points) else length
        if fl:
            end = min(fl[1], nxt)
            spans.append((t, min(t + tap, end), fl[0], fl[0]))
            spans.append((min(t + tap, end), end, fl[0], held_now))
            if fl[1] < nxt and held_now:
                spans.append((fl[1], nxt, held_now, held_now))
        elif held_now:
            spans.append((t, nxt, held_now, held_now))
    out = []
    for a, b, labels, down in spans:
        a, b = max(0.0, a), min(length, b)
        if b - a < 0.04:
            continue
        if out and out[-1][2:] == (labels, down) and abs(out[-1][1] - a) < 0.01:
            out[-1] = (out[-1][0], b, labels, down)
        else:
            out.append((a, b, labels, down))
    return out


# How each key is drawn: (kind, symbol). Graphite for the modifiers and the
# keys around them, cream for letters, digits and Space, as coucou's two inks.
KEYCAPS = {"Super": ("mod", "❖"), "Shift": ("mod", "⇧"), "Ctrl": ("mod", "⌃"), "Alt": ("mod", "⎇"),
           "Tab": ("mod", "⇥"), "Enter": ("mod", "↵"), "⌫": ("sym", "⌫"), "Space": ("space", "␣"),
           "←": ("sym", "←"), "→": ("sym", "→"), "↑": ("sym", "↑"), "↓": ("sym", "↓")}
CREAM = ((0xe6, 0xe0, 0xd2), (0xc9, 0xc1, 0xae), (0xfb, 0xf8, 0xf0), (0xee, 0xe8, 0xda), (0x2a, 0x28, 0x24))
GRAPHITE = ((0x2a, 0x2a, 0x2e), (0x14, 0x14, 0x16), (0x4a, 0x4a, 0x50), (0x33, 0x33, 0x38), (0xec, 0xec, 0xf0))


def key_picture(labels, height, path, pressed=()):
    """Keycaps, one per key, as a keyboard's: the walls, a dished top, the
    legend where a keyboard puts it. A key in `pressed` sits lower."""
    from PIL import Image, ImageDraw, ImageFilter, ImageFont, ImageOps
    k = height / 1440
    u = 92 * k                       # a unit key
    gap, pad, travel = round(10 * k), round(22 * k), round(6 * k)
    mi = Path.home() / ".local/share/fonts/MiSansLatin/MiSansLatin-Semibold.ttf"
    dejavu = "/usr/share/fonts/dejavu-sans-fonts/DejaVuSans.ttf"
    def font(size, symbol=False):
        for name in ([dejavu, "DejaVuSans.ttf"] if symbol else [str(mi), dejavu, "DejaVuSans.ttf"]):
            try:
                return ImageFont.truetype(name, round(size))
            except OSError:
                pass
        return ImageFont.load_default()

    def gradient(size, top, bottom):
        g = Image.linear_gradient("L").resize(size)
        return ImageOps.colorize(g, top, bottom).convert("RGBA")

    def dish(size, centre, edge):
        w, h = size
        g = Image.radial_gradient("L").resize((round(w * 1.7), round(h * 2.2)))
        g = g.crop((round(w * 0.35), round(h * 0.55), round(w * 0.35) + w, round(h * 0.55) + h))
        g = g.point(lambda v: min(255, int(v * 1.39)))   # the edge colour at 72 %
        return ImageOps.colorize(g, centre, edge).convert("RGBA")

    def rounded(im, r):
        m = Image.new("L", im.size, 0)
        ImageDraw.Draw(m).rounded_rectangle((0, 0, im.width - 1, im.height - 1), radius=r, fill=255)
        im.putalpha(m)
        return im

    caps = []
    for text in labels:
        kind, sym = KEYCAPS.get(text, ("letter" if len(text) == 1 else "word", None))
        units = {"mod": 1.5, "space": 3.25, "word": 1.25}.get(kind, 1)
        caps.append((text, kind, sym, round(u * units)))
    width = sum(c[3] for c in caps) + gap * (len(caps) - 1) + 2 * pad
    img = Image.new("RGBA", (width, round(u) + 2 * pad + travel), (0, 0, 0, 0))
    x = pad
    for text, kind, sym, w in caps:
        h = round(u)
        down = text in pressed
        y = pad + (travel if down else 0)
        wall_t, wall_b, face_c, face_e, ink = GRAPHITE if kind in ("mod", "sym", "word") else CREAM
        # the shadow on the screen, shorter when the key is down
        sh_im = Image.new("RGBA", img.size, (0, 0, 0, 0))
        drop = round((4 if down else 12) * k)
        ImageDraw.Draw(sh_im).rounded_rectangle((x, y + drop, x + w, y + h + drop), radius=round(0.17 * u),
                                                fill=(0, 0, 0, 90))
        img.alpha_composite(sh_im.filter(ImageFilter.GaussianBlur(round(12 * k))))
        line = Image.new("RGBA", img.size, (0, 0, 0, 0))
        ImageDraw.Draw(line).rounded_rectangle((x, y + round(2 * k), x + w - 1, y + h - 1 + round(2 * k)),
                                               radius=round(0.17 * u), fill=(0, 0, 0, 80))
        img.alpha_composite(line)
        # the walls, then the top set inside them
        img.alpha_composite(rounded(gradient((w, h), wall_t, wall_b), round(0.17 * u)), (x, y))
        fx, fy = round(0.087 * u), round(0.064 * u)
        fw, fh = w - 2 * fx, h - fy - round(0.157 * u)
        face = rounded(dish((fw, fh), face_c, face_e), round(0.128 * u))
        rim = Image.new("RGBA", (fw, fh), (0, 0, 0, 0))
        ImageDraw.Draw(rim).rounded_rectangle((0, 0, fw - 1, fh - 1), radius=round(0.128 * u),
                                              outline=(255, 255, 255, 70 if kind in ("mod", "sym", "word") else 150),
                                              width=max(1, round(1.5 * k)))
        rim.putalpha(Image.composite(rim.getchannel("A"), Image.new("L", rim.size, 0),
                                     Image.linear_gradient("L").rotate(180).resize(rim.size)))
        face.alpha_composite(rim)
        img.alpha_composite(face, (x + fx, y + fy))
        d = ImageDraw.Draw(img)
        left, top, bottom = x + fx + 0.12 * u, y + fy + 0.10 * u, y + fy + fh - 0.10 * u
        if kind == "mod":
            d.text((left, top), sym, font=font(0.27 * u, True), fill=ink, anchor="lt")
            d.text((left, bottom), text, font=font(0.19 * u), fill=ink, anchor="ls")
        elif kind == "space":
            # ␣ sits on the baseline: drawn larger, and raised to the middle
            d.text((x + w / 2, y + fy + fh / 2 - 0.05 * u), sym, font=font(0.5 * u, True), fill=ink + (215,), anchor="mm")
        elif kind == "sym":
            d.text((x + w / 2, y + fy + fh / 2), sym, font=font(0.34 * u, True), fill=ink, anchor="mm")
        else:
            size = 0.36 * u if kind == "letter" else 0.22 * u
            d.text((x + w / 2, y + fy + fh / 2), text, font=font(size), fill=ink, anchor="mm")
        x += w + gap
    img.save(path)
    return img.size


def record(video, take):
    """Runs the video's steps while wf-recorder films the screen, without
    loss, into the cache: encode() can then be rerun without filming again."""
    raw = raw_path(video)
    raw.parent.mkdir(parents=True, exist_ok=True)
    take.park()
    rec = subprocess.Popen(["wf-recorder", "-y", "-o", SCREEN["name"], "-f", str(raw), "-c", "libx264",
                            "-x", "yuv444p", "-p", "preset=ultrafast", "-p", "qp=0"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(1)
    take.keylog, take.t0 = [], time.monotonic()
    try:
        for step in video.get("steps", []):
            take.step(step)
    finally:
        rec.send_signal(signal.SIGINT)
        rec.wait(timeout=60)
        keys_path(video).write_text(json.dumps(take.keylog))
        take.keylog = None
    take.end_scene()


def duration(path):
    """How long the picture lasts: the container's own duration can run past it,
    and the first frame is not always at 0."""
    out = sh("ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries", "packet=pts_time",
             "-of", "csv=p=0", str(path))
    stamps = [float(x.split(",")[0]) for x in out.split() if x.strip(",") not in ("", "N/A")]
    return max(stamps) - min(stamps)


def encode(video, out):
    """NAME.webm for the site, next to the scenes, and the exports for
    elsewhere in `exports` (default ~/Videos/coucou-shell), which is not in
    the repository: the master, a version without music, and 16:9, square
    and vertical cuts for social networks.

    The music is the source file, mixed in here, never a recording of the
    speakers: `audio` starts `audio_delay` seconds after the first frame
    (the step that starts the player comes first), and picture and sound
    fade out together over `fade`."""
    raw = raw_path(video)
    if not raw.exists():
        fail(f"no recording of {video['name']} yet: scripts/pellicule --video {video['name']}")
    name = video["name"]
    lead = 0.8                      # the recorder's first second, before the steps start
    length = duration(raw) - lead
    fps = video.get("fps", 60)
    fade = video.get("fade", 2.5)
    fade_v = f"fade=t=out:st={length - fade:.3f}:d={fade}"
    audio = Path(video["audio"]).expanduser() if video.get("audio") else None
    if audio and not audio.is_file():
        fail(f"{name}: no audio file at {audio}")

    src = ["-i", str(raw)]
    # Constant frame rate first (the recorder only writes a frame when the
    # screen changes), then the cut: the first frame is held, not lost.
    head = f"[0:v]fps={fps},trim=start={lead},setpts=PTS-STARTPTS"
    # The keys typed, bottom right, clear of a bar along the bottom; their
    # times count from the first step, which comes 1 s after the recorder
    # starts, `lead` of which is cut.
    spans = []
    if video.get("keys", True) and keys_path(video).exists():
        spans = key_spans(json.loads(keys_path(video).read_text()), length,
                          video.get("keys_offset", 1.0 - lead))
    if spans:
        W, H = (int(v) for v in sh("ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
                                   "stream=width,height", "-of", "csv=p=0", str(raw)).strip().split(","))
        k = H / 1440
        pics = CACHE / "keys"
        pics.mkdir(parents=True, exist_ok=True)
        head += "[k0]"
        for i, (a, b, labels, down) in enumerate(spans):
            png = pics / f"{name}-{i}.png"
            w, h = key_picture(labels, H, png, down)
            src += ["-i", str(png)]
            # the picture holds a margin for the shadow and the travel
            x, y = W - w - round(10 * k), H - h - round(68 * k)
            head += f";[k{i}][{i + 1}:v]overlay={x}:{y}:enable='between(t,{a:.3f},{b:.3f})'[k{i + 1}]"
        head += f";[k{len(spans)}]null"
    head += f",{fade_v}"
    snd, snd_map = [], ["-an"]
    if audio:
        delay = int(video.get("audio_delay", 0.4) * 1000)
        snd = ["-i", str(audio)]
        snd_filter = (f"[{len(spans) + 1}:a]atrim=0:{length:.3f},adelay={delay}:all=1,"
                      f"afade=t=out:st={length - fade:.3f}:d={fade},apad=whole_dur={length:.3f}[a]")
        snd_map = ["-map", "[a]"]

    def run(target, picture, video_codec, audio_codec, music=True):
        """`picture` is a filter chain from [0:v] to [v]."""
        graph = picture + (";" + snd_filter if audio and music else "")
        sh("ffmpeg", "-y", "-loglevel", "error", *src, *(snd if audio and music else []),
           "-filter_complex", graph, "-map", "[v]", *(snd_map if audio and music else ["-an"]),
           *video_codec, *(audio_codec if audio and music else []),
           "-t", f"{length:.3f}", str(target))

    def framed(w, h):
        """The screen whole, on a blurred, darkened copy of itself."""
        return (f"{head},split[x][y];"
                f"[x]scale={w}:{h}:force_original_aspect_ratio=increase,crop={w}:{h},boxblur=40:2,eq=brightness=-0.18[bg];"
                f"[y]scale={w}:{h}:force_original_aspect_ratio=decrease:flags=lanczos[fg];"
                f"[bg][fg]overlay=(W-w)/2:(H-h)/2,format=yuv420p[v]")

    plain = f"{head},format=yuv420p[v]"
    h264 = ["-c:v", "libx264", "-preset", "slow", "-crf", str(video.get("master_crf", 15)),
            "-pix_fmt", "yuv420p", "-movflags", "+faststart"]
    aac = ["-c:a", "aac", "-b:a", "256k"]

    # The site: smaller, same picture; the page starts it without sound.
    webm = out / f"{name}.webm"
    site = plain if "width" not in video else plain.replace(
        ",format=yuv420p", f",scale={video['width']}:-2:flags=lanczos,format=yuv420p")
    run(webm, site, ["-c:v", "libvpx-vp9", "-b:v", "0", "-crf", str(video.get("crf", 30)),
                     "-deadline", "good", "-cpu-used", "1", "-row-mt", "1", "-tile-columns", "2",
                     "-g", str(fps * 5)], ["-c:a", "libopus", "-b:a", "112k"])

    exports = Path(video.get("exports", "~/Videos/coucou-shell")).expanduser()
    exports.mkdir(parents=True, exist_ok=True)
    made = [webm]
    for suffix, picture, music in (("master", plain, True), ("silent", plain, False),
                                   ("16x9", framed(1920, 1080), True),
                                   ("square", framed(1080, 1080), True),
                                   ("vertical", framed(1080, 1920), True)):
        target = exports / f"{name}-{suffix}.mp4"
        run(target, picture, h264, aac, music)
        made.append(target)
    return made


def main():
    ap = argparse.ArgumentParser(prog="pellicule", description="Retakes the documentation's screenshots.")
    ap.add_argument("scenes", nargs="*", help="scene names, or check / list")
    ap.add_argument("--mode", choices=list(SCHEMES), help="only this mode")
    ap.add_argument("--scale", type=float, help="stop unless the screen is at this scale (set it yourself first)")
    ap.add_argument("--out", type=Path, help="where to write (default: next to scenes.toml)")
    ap.add_argument("--video", metavar="NAME", help="record this [[video]] instead of screenshots")
    ap.add_argument("--encode", action="store_true",
                    help="with --video: encode the last recording again, without filming")
    ap.add_argument("--scenes-file", type=Path, default=SCENES)
    a = ap.parse_args()

    settings, scenes, videos, showcases = load(a.scenes_file)
    all_scenes = scenes

    if a.scenes[:1] == ["list"]:
        for s in scenes:
            say(f"{s['name']:<28} {', '.join(s.get('modes', ['light', 'dark'])):<12} {s.get('doc', '')}")
        for v in videos:
            say(f"{v['name']:<28} {'video, ' + v.get('mode', 'dark'):<12} {v.get('doc', '')}")
        for sc in showcases:
            say(f"{sc['name']:<28} {'showcase':<12} {sc.get('doc', '')}")
        return
    if a.scenes[:1] == ["check"]:
        problems = check(settings, scenes + videos) + check_showcases(showcases, scenes)
        if showcases and subprocess.run(["sh", "-c", "command -v firefox"], capture_output=True).returncode:
            problems.append("showcase: Firefox renders it, and it is not installed")
        for p in problems:
            print(p, file=sys.stderr)
        if problems:
            sys.exit(1)
        say(f"{len(scenes)} scenes, all in step with the shell")
        return

    if a.scenes[:1] == ["showcase"]:
        # Recomposed from the last full-screen captures, without taking any.
        if SCREEN_FILE.exists():
            SCREEN.update({k: tuple(v) if isinstance(v, list) else v
                           for k, v in json.loads(SCREEN_FILE.read_text()).items()})
        out = a.out or a.scenes_file.parent
        for sc in showcases:
            for path in compose(sc, out, settings, all_scenes):
                say(f"{sc['name']:<16} {path}")
        return

    if a.video:
        found = [v for v in videos if v["name"] == a.video]
        if not found:
            fail(f"no video called {a.video} (scripts/pellicule list)")
        if subprocess.run(["sh", "-c", "command -v wf-recorder"], capture_output=True).returncode:
            fail("wf-recorder is not installed: sudo dnf install wf-recorder")
        video = found[0]
        out = a.out or a.scenes_file.parent
        out.mkdir(parents=True, exist_ok=True)
        if a.encode:
            for path in encode(video, out):
                say(f"{path} ({path.stat().st_size // 1024} KiB)")
            return
        problems = check(settings, [video])
        if problems:
            for p in problems:
                print(p, file=sys.stderr)
            fail("the video is out of step with the shell; nothing recorded")
        # the video's own wallpaper and key repeat, for this run
        take = Take({**settings, **{k: video[k] for k in ("wallpaper", "wallpapers", "repeat") if k in video},
                     "_scale": a.scale})
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(130))
        # its terminal closing under it: put everything back all the same
        signal.signal(signal.SIGHUP, lambda *_: sys.exit(129))
        try:
            take.start()
            scheme_set(*SCHEMES[video.get("mode", "dark")])
            time.sleep(settings.get("scheme_wait", 3))
            record(video, take)
        except KeyboardInterrupt:
            say("interrupted, putting everything back")
            return
        finally:
            take.restore()
        for path in encode(video, out):
            say(f"{path} ({path.stat().st_size // 1024} KiB)")
        return

    if a.scenes:
        names = {s["name"] for s in scenes}
        unknown = [n for n in a.scenes if n not in names]
        if unknown:
            fail(f"no scene called {', '.join(unknown)} (scripts/pellicule list)")
        scenes = [s for s in scenes if s["name"] in a.scenes]

    problems = check(settings, scenes)
    if problems:
        for p in problems:
            print(p, file=sys.stderr)
        fail("scenes.toml is out of step with the shell; nothing taken")

    out = a.out or a.scenes_file.parent
    out.mkdir(parents=True, exist_ok=True)
    modes = [a.mode] if a.mode else list(SCHEMES)

    take = Take({**settings, "_scale": a.scale})
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(130))
    # its terminal closing under it: put everything back all the same
    signal.signal(signal.SIGHUP, lambda *_: sys.exit(129))
    taken = 0
    try:
        take.start()
        for mode in modes:
            todo = [s for s in scenes if mode in s.get("modes", ["light", "dark"])]
            if not todo:
                continue
            scheme_set(*SCHEMES[mode])
            time.sleep(settings.get("scheme_wait", 3))
            for s in todo:
                path = shoot(s, mode, take, out, settings)
                taken += 1
                say(f"{mode:<5} {s['name']:<16} {path.relative_to(REPO) if path.is_relative_to(REPO) else path}")
    except KeyboardInterrupt:
        say("interrupted, putting everything back")
    finally:
        take.restore()
    say(f"{taken} screenshot(s)")
    # The showcases built on what was just taken.
    done = {(s["name"], m) for s in scenes for m in modes}
    for sc in showcases:
        if any((n, sc.get("mode", "light")) in done for n in sc["back"] + sc["front"]):
            for path in compose(sc, out, settings, all_scenes):
                say(f"{'':<5} {sc['name']:<16} {path.relative_to(REPO) if path.is_relative_to(REPO) else path}")


if __name__ == "__main__":
    main()
