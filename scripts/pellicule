#!/usr/bin/env python3
"""Pellicule: retakes the documentation's screenshots, in light and dark.

    scripts/pellicule                  every scene in docs/screenshots/scenes.toml
    scripts/pellicule balise mixer     only these scenes
    scripts/pellicule --mode dark      only one mode
    scripts/pellicule --out DIR        write elsewhere than docs/screenshots
    scripts/pellicule --video hero     records a [[video]] instead (WebM + animated WebP)
    scripts/pellicule --video hero --encode   encodes its last recording again
    scripts/pellicule showcase         puts the [[showcase]] pictures together again
    scripts/pellicule check            check the scenes against the running shell
    scripts/pellicule list             the scenes, with their docs

A scene is a list of steps run on an empty workspace, then a screenshot,
cropped and saved as NAME.webp (light) and NAME-dark.webp; the whole
screen is kept in the cache for the showcase pictures. The shell runs
in demo mode the whole time (made-up time, battery, figures), and
everything is put back at the end, Ctrl+C included: the colour scheme, the
wallpaper, the workspace, demo mode, the windows a scene opened.

Steps, one string each:
    ipc TARGET FUNCTION [ARGS...]   qs -c bar ipc call TARGET FUNCTION ARGS
                                    ({library}: the made-up games, see [[settings.game]])
    wait SECONDS
    run COMMAND...                  started in the background, killed at the end of the scene
    close CLASS                     closes the windows of that class on the workspace
    notify APP | SUMMARY | BODY [| OPTIONS]
                                    a notification (closed when demo mode ends); OPTIONS,
                                    space-separated: entry=DESKTOP_ID (the app's icon),
                                    icon=NAME, image=PATH ({repo}; a .webp is handed over
                                    as PNG), urgency=low|normal|critical

The pointer is parked out of the way for every scene (settings `pointer`)
and put back at the end: under it, a pop-up lightens, shows its x and
holds its timer.

The calls this file makes to the shell, Hyprland and gsettings are the
ones its users can break. `check` compares every `ipc` step with what the
shell exposes and every `run` with the commands installed; run it after
changing an IpcHandler or a command a scene uses (AGENTS.md says so).
"""

import argparse
import json
import os
import shlex
import signal
import subprocess
import sys
import tempfile
import time
import tomllib
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
SCENES = REPO / "docs" / "screenshots" / "scenes.toml"

# The colour scheme as the bar's own toggle sets it (AppearanceState.qml).
SCHEMES = {
    "light": ("prefer-light", "Adwaita"),
    "dark": ("prefer-dark", "Adwaita-dark"),
}


def say(msg):
    print(msg, flush=True)


def fail(msg):
    print(f"pellicule: {msg}", file=sys.stderr)
    sys.exit(1)


def sh(*args, check=True, capture=True):
    r = subprocess.run(args, text=True, capture_output=capture)
    if check and r.returncode != 0:
        raise RuntimeError(f"{' '.join(args)}: {(r.stderr or r.stdout).strip()}")
    return r.stdout.strip() if capture else ""


# ---- the shell, Hyprland, gsettings ----------------------------------------

def ipc(target, function, *args):
    return sh("qs", "-c", "bar", "ipc", "call", target, function, *args)


def ipc_surface():
    """{target: {function: number of arguments}} from the running shell.
    Waits up to 10 s for it: while the bar reloads after an edit, its
    targets come back one by one."""
    for _ in range(10):
        surface = _ipc_surface()
        if "bar" in surface:
            return surface
        time.sleep(1)
    return surface


def _ipc_surface():
    out = sh("qs", "-c", "bar", "ipc", "show")
    surface, target = {}, None
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("target "):
            target = line.split()[1]
            surface[target] = {}
        elif line.startswith("function ") and target:
            name, _, rest = line[len("function "):].partition("(")
            params = rest.split(")")[0].strip()
            surface[target][name] = 0 if not params else params.count(",") + 1
    return surface


def scheme_get():
    return (sh("gsettings", "get", "org.gnome.desktop.interface", "color-scheme").strip("'"),
            sh("gsettings", "get", "org.gnome.desktop.interface", "gtk-theme").strip("'"))


def scheme_set(scheme, theme):
    sh("gsettings", "set", "org.gnome.desktop.interface", "color-scheme", scheme)
    sh("gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", theme)


def workspace_get():
    import json
    return str(json.loads(sh("hyprctl", "-j", "activeworkspace"))["id"])


def pointer_get():
    pos = json.loads(sh("hyprctl", "-j", "cursorpos"))
    return pos["x"], pos["y"]


def pointer_go(x, y):
    sh("hyprctl", "eval", f"hl.dispatch(hl.dsp.cursor.move({{ x = {int(x)}, y = {int(y)} }}))")


def workspace_go(ws):
    sh("hyprctl", "eval", f'hl.dispatch(hl.dsp.focus({{ workspace = "{ws}" }}))')


WALLPAPER_SET = Path.home() / ".config/hypr/scripts/wallpaper-set"
# Prisme opens on the playlist's `last_static`, your own choice.
PLAYLIST = Path.home() / ".config/hypr/wallpaper-playlist.json"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "pellicule"
STEAM_ART = "https://cdn.cloudflare.steamstatic.com/steam/apps/{id}/{file}"


def library(settings):
    """The made-up game library's JSON file, for `ipc controller library
    {library}`: the [[game]] list of scenes.toml, with Steam's public
    artwork downloaded once into the cache (never into the repository)."""
    import json
    import urllib.request
    games, now = [], int(time.time())
    for i, g in enumerate(settings.get("game", [])):
        art = CACHE / "steam" / str(g["steam"])
        art.mkdir(parents=True, exist_ok=True)
        files = {}
        for key, name in (("cover", "library_600x900.jpg"), ("hero", "library_hero.jpg")):
            path = art / name
            if not path.exists():
                urllib.request.urlretrieve(STEAM_ART.format(id=g["steam"], file=name), path)
            files[key] = str(path)
        # Played an hour, then a day, then more ago: the first one is
        # the menu's "Continue".
        games.append({"title": g["title"], "source": "Steam",
                      "last": now - 3600 * (1 + 20 * i), **files})
    path = CACHE / "library.json"
    path.write_text(json.dumps(games))
    return path


def wallpaper_get():
    """The name of the wallpaper on screen (awww shows a fitted copy of it)."""
    for line in sh("awww", "query").splitlines():
        if "image: " in line:
            return Path(line.split("image: ", 1)[1]).name
    return None


def wallpaper_set(name):
    sh(str(WALLPAPER_SET), "--instant", name)


def clients():
    import json
    return json.loads(sh("hyprctl", "-j", "clients"))


def monitor_size():
    import json
    m = json.loads(sh("hyprctl", "-j", "monitors"))[0]
    return m["width"], m["height"]


# ---- scenes -----------------------------------------------------------------

def load(path):
    with open(path, "rb") as f:
        data = tomllib.load(f)
    settings = data.get("settings", {})
    scenes = data.get("scene", [])
    videos = data.get("video", [])
    showcases = data.get("showcase", [])
    return settings, scenes, videos, showcases


def check(settings, scenes, surface=None):
    """Problems, as "scene: what" lines. Empty when everything holds."""
    problems = []
    seen = set()
    if surface is None:
        try:
            surface = ipc_surface()
        except Exception as e:
            return [f"the shell does not answer ({e}); is the bar running?"]
    w, h = settings.get("size", [1920, 1200])
    wp = settings.get("wallpaper")
    if wp and subprocess.run([str(WALLPAPER_SET), "--resolve", wp], capture_output=True).returncode != 0:
        problems.append(f"settings: wallpaper {wp!r} is not in the wallpaper folder")
    for s in scenes:
        name = s.get("name", "?")
        where = f"{name}"
        if name in seen:
            problems.append(f"{where}: two scenes have this name")
        seen.add(name)
        crop = s.get("crop", "full")
        if crop != "full":
            if len(crop) != 4:
                problems.append(f"{where}: crop is [x, y, width, height] or \"full\"")
            else:
                x, y, cw, ch = crop
                if x < 0 or y < 0 or x + cw > w or y + ch > h:
                    problems.append(f"{where}: crop {crop} leaves the {w}x{h} screen")
        for mode in s.get("modes", ["light", "dark"]):
            if mode not in SCHEMES:
                problems.append(f"{where}: unknown mode {mode!r}")
        doc = s.get("doc")
        if doc and not (REPO / doc).exists():
            problems.append(f"{where}: {doc} does not exist")
        for step in s.get("steps", []) + s.get("after", []):
            problems += [f"{where}: {p}" for p in check_step(step, surface)]
    return problems


def check_step(step, surface):
    try:
        words = shlex.split(step)
    except ValueError as e:
        return [f"{step!r}: {e}"]
    if not words:
        return ["an empty step"]
    verb, args = words[0], words[1:]
    if verb == "ipc":
        if len(args) < 2:
            return [f"{step!r}: ipc TARGET FUNCTION [ARGS...]"]
        target, function, rest = args[0], args[1], args[2:]
        if target not in surface:
            return [f"{step!r}: the shell has no ipc target {target!r}"]
        if function not in surface[target]:
            return [f"{step!r}: {target} has no function {function!r}"]
        want = surface[target][function]
        if len(rest) != want:
            return [f"{step!r}: {target} {function} takes {want} argument(s), not {len(rest)}"]
        return []
    if verb == "wait":
        try:
            float(args[0])
            return []
        except (IndexError, ValueError):
            return [f"{step!r}: wait SECONDS"]
    if verb == "run":
        if not args:
            return [f"{step!r}: run COMMAND..."]
        cmd = os.path.expanduser(args[0])
        found = os.access(cmd, os.X_OK) if "/" in cmd else subprocess.run(
            ["sh", "-c", f"command -v {shlex.quote(cmd)}"], capture_output=True).returncode == 0
        return [] if found else [f"{step!r}: {args[0]} is not installed"]
    if verb == "close":
        return [] if len(args) == 1 else [f"{step!r}: close CLASS"]
    if verb == "notify":
        parts = " ".join(args).split("|")
        if len(parts) not in (3, 4):
            return [f"{step!r}: notify APP | SUMMARY | BODY [| OPTIONS]"]
        problems = []
        for opt in (parts[3].split() if len(parts) == 4 else []):
            key, _, value = opt.partition("=")
            if key not in NOTIFY_OPTIONS or not value:
                problems.append(f"{step!r}: {opt!r} is not entry=, icon=, image= or urgency=")
            elif key == "urgency" and value not in ("low", "normal", "critical"):
                problems.append(f"{step!r}: urgency is low, normal or critical")
            elif key == "image" and not Path(value.replace("{repo}", str(REPO))).expanduser().is_file():
                problems.append(f"{step!r}: no image at {value}")
        return problems
    return [f"{step!r}: unknown step {verb!r}"]


NOTIFY_OPTIONS = ("entry", "icon", "image", "urgency")


def notify_args(options):
    """notify-send's arguments for a notify step's OPTIONS. Qt reads no
    WebP here, so a .webp image goes over as a PNG copy in the cache."""
    out = []
    for opt in options.split():
        key, _, value = opt.partition("=")
        if key == "entry":
            out += ["-h", f"string:desktop-entry:{value}"]
        elif key == "icon":
            out += ["-i", value]
        elif key == "urgency":
            out += ["-u", value]
        elif key == "image":
            path = Path(value.replace("{repo}", str(REPO))).expanduser()
            if path.suffix.lower() == ".webp":
                from PIL import Image
                png = CACHE / "notify" / (path.stem + ".png")
                png.parent.mkdir(parents=True, exist_ok=True)
                if not png.exists() or png.stat().st_mtime < path.stat().st_mtime:
                    Image.open(path).save(png)
                path = png
            out += ["-h", f"string:image-path:{path}"]
    return out


class Take:
    """One run: what to put back, and the windows to close."""

    def __init__(self, settings):
        self.ws = str(settings.get("workspace", "9"))
        self.saved_scheme = scheme_get()
        self.saved_ws = workspace_get()
        self.saved_demo = ipc("demo", "status") == "on"
        self.settings = settings
        self._library = None
        self.wallpaper = settings.get("wallpaper")
        self.saved_wallpaper = wallpaper_get() if self.wallpaper else None
        self.saved_playlist = PLAYLIST.read_bytes() if self.wallpaper and PLAYLIST.exists() else None
        self.procs = []
        self.notes = []
        self.pointer = tuple(settings.get("pointer", [960, 1100]))
        self.saved_pointer = pointer_get()

    def park(self):
        pointer_go(*self.pointer)

    def start(self):
        busy = [c for c in clients() if str(c["workspace"]["id"]) == self.ws]
        if busy:
            fail(f"workspace {self.ws} is not empty ({busy[0]['class']}); "
                 "close its windows or set another one in scenes.toml")
        ipc("demo", "on")
        if self.wallpaper:
            # One file of a light/dark pair stands for both: the scheme
            # changes below bring the other half.
            wallpaper_set(self.wallpaper)
            # So Prisme opens on it too.
            try:
                playlist = json.loads(self.saved_playlist or b"{}")
            except ValueError:
                playlist = {}
            playlist["last_static"] = self.wallpaper
            PLAYLIST.write_text(json.dumps(playlist))
        workspace_go(self.ws)
        time.sleep(0.8)

    def step(self, step):
        words = shlex.split(step)
        verb, args = words[0], words[1:]
        if verb == "ipc":
            if "{library}" in args:
                self._library = self._library or library(self.settings)
                args = [str(self._library) if a == "{library}" else a for a in args]
            ipc(*args)
        elif verb == "wait":
            time.sleep(float(args[0]))
        elif verb == "run":
            cmd = [os.path.expanduser(a.replace("{repo}", str(REPO))) for a in args]
            self.procs.append(subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                                               stderr=subprocess.DEVNULL, start_new_session=True))
        elif verb == "close":
            self.close(args[0])
        elif verb == "notify":
            parts = [p.strip() for p in " ".join(args).split("|")]
            app, summary, body = parts[:3]
            extra = notify_args(parts[3]) if len(parts) == 4 else []
            nid = subprocess.run(["notify-send", "-p", "-a", app, *extra, summary, body],
                                 capture_output=True, text=True, check=True).stdout.strip()
            self.notes.append(nid)

    def close(self, cls):
        for c in clients():
            if c["class"] == cls and str(c["workspace"]["id"]) == self.ws:
                try:
                    os.kill(c["pid"], signal.SIGTERM)
                except ProcessLookupError:
                    pass

    def end_scene(self):
        for p in self.procs:
            if p.poll() is None:
                try:
                    os.killpg(p.pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
        self.procs = []
        # The scene's notifications go with it, or the next mode's take of
        # the centre shows them twice.
        for nid in self.notes:
            subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
                            "--object-path", "/org/freedesktop/Notifications",
                            "--method", "org.freedesktop.Notifications.CloseNotification", nid],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.notes = []
        for c in clients():
            if str(c["workspace"]["id"]) == self.ws:
                try:
                    os.kill(c["pid"], signal.SIGTERM)
                except ProcessLookupError:
                    pass

    def restore(self):
        try:
            self.end_scene()
        finally:
            if self._library:
                ipc("controller", "reset")
            if not self.saved_demo:
                ipc("demo", "off")
            scheme_set(*self.saved_scheme)
            if self.saved_playlist is not None:
                PLAYLIST.write_bytes(self.saved_playlist)
            elif self.wallpaper:
                PLAYLIST.unlink(missing_ok=True)
            if self.saved_wallpaper:
                time.sleep(1)   # after the scheme's own swap, not raced by it
                wallpaper_set(self.saved_wallpaper)
            workspace_go(self.saved_ws)
            pointer_go(*self.saved_pointer)


def shoot(scene, mode, take, out, settings):
    from PIL import Image
    take.park()
    for step in scene.get("steps", []):
        take.step(step)
    with tempfile.NamedTemporaryFile(suffix=".png") as raw:
        sh("grim", raw.name)
        img = Image.open(raw.name).convert("RGB")
    # The whole screen too, for the showcase pictures.
    full = full_path(scene["name"], mode)
    full.parent.mkdir(parents=True, exist_ok=True)
    img.save(full)
    for step in scene.get("after", []):
        take.step(step)
    take.end_scene()
    crop = scene.get("crop", "full")
    if crop != "full":
        x, y, w, h = crop
        img = img.crop((x, y, x + w, y + h))
    width = scene.get("width", settings.get("width"))
    if width and img.width > width:
        img = img.resize((width, round(img.height * width / img.width)), Image.LANCZOS)
    name = scene["name"] + ("" if mode == "light" else "-dark")
    path = out / f"{name}.webp"
    img.save(path, quality=settings.get("quality", 85), method=6)
    return path


def full_path(name, mode):
    return CACHE / "full" / (name + ("" if mode == "light" else "-dark") + ".png")


SHOWCASE = REPO / "docs" / "screenshots" / "showcase.html"


def check_showcases(showcases, scenes):
    problems = []
    modes = {s["name"]: s.get("modes", ["light", "dark"]) for s in scenes}
    crops = {s["name"]: s.get("crop", "full") for s in scenes}
    for sc in showcases:
        where = f"showcase {sc.get('name')}"
        mode = sc.get("mode", "light")
        names = sc.get("back", []) + sc.get("front", []) + ([sc["blank"]] if sc.get("blank") else [])
        if not sc.get("back") or not sc.get("front"):
            problems.append(f"{where}: needs a back and a front screen")
        for name in names:
            if name not in modes:
                problems.append(f"{where}: no scene called {name}")
            elif mode not in modes[name]:
                problems.append(f"{where}: {name} is not taken in {mode} mode")
        for name in sc.get("back", [])[1:] + sc.get("front", [])[1:]:
            if crops.get(name) == "full":
                problems.append(f"{where}: {name} has no crop to lay on the screen")
    return problems


def screen(names, mode, blank, crops):
    """One screen of a showcase: the first scene's whole screen, with the
    others' crops laid on it. They all share the same frozen desktop, so
    there is no seam. With `blank` (the empty desktop's scene), only what
    each one adds to it is laid, so its crop's margins cover nothing."""
    from PIL import Image, ImageChops
    img = Image.open(full_path(names[0], mode)).convert("RGB")
    for n in names[1:]:
        x, y, w, h = crops[n]
        box = (x, y, x + w, y + h)
        part = Image.open(full_path(n, mode)).convert("RGB")
        if blank:
            base = Image.open(full_path(blank, mode)).convert("RGB")
            bb = ImageChops.difference(part.crop(box), base.crop(box)).convert("L") \
                .point(lambda v: 255 if v > 18 else 0).getbbox()
            if bb:
                pad = 40
                box = (max(x, x + bb[0] - pad), max(y, y + bb[1] - pad),
                       min(x + w, x + bb[2] + pad), min(y + h, y + bb[3] + pad))
        img.paste(part.crop(box), box[:2])
    return img


def compose(sc, out, settings, scenes):
    """The showcase picture: two screens in cascade, drawn by
    showcase.html and rendered by Firefox. NAME.webp here, NAME.png at full
    size in the cache, for other uses (a portfolio)."""
    from PIL import Image
    from urllib.parse import urlencode
    mode = sc.get("mode", "light")
    blank = sc.get("blank")
    needed = [full_path(n, mode) for n in sc["back"] + sc["front"] + ([blank] if blank else [])]
    missing = [f.name for f in needed if not f.exists()]
    if missing:
        fail(f"showcase {sc['name']}: take {', '.join(missing)} first")
    crops = {s["name"]: s.get("crop") for s in scenes}
    parts = CACHE / "showcase" / "parts"
    parts.mkdir(parents=True, exist_ok=True)
    urls = {}
    for key in ("back", "front"):
        path = parts / f"{sc['name']}-{key}.png"
        screen(sc[key], mode, blank, crops).save(path)
        urls[key] = path.as_uri()
    w, h = sc.get("size", [2560, 1600])
    png = CACHE / "showcase" / f"{sc['name']}.png"
    url = SHOWCASE.as_uri() + "?" + urlencode({**urls, "mode": mode})
    with tempfile.TemporaryDirectory(prefix="pellicule-firefox-") as profile:
        sh("firefox", "--headless", "--no-remote", "--profile", profile,
           f"--window-size={w},{h}", "--screenshot", str(png), url)
    img = Image.open(png).convert("RGB")
    width = sc.get("width", 1600)
    small = img.resize((width, round(img.height * width / img.width)), Image.LANCZOS)
    webp = out / f"{sc['name']}.webp"
    small.save(webp, quality=settings.get("quality", 85), method=6)
    return webp, png


def raw_path(video):
    return CACHE / f"{video['name']}.mkv"


def record(video, take):
    """Runs the video's steps while wf-recorder films the screen, without
    loss, into the cache: encode() can then be rerun without filming again."""
    raw = raw_path(video)
    raw.parent.mkdir(parents=True, exist_ok=True)
    take.park()
    rec = subprocess.Popen(["wf-recorder", "-y", "-f", str(raw), "-c", "libx264",
                            "-x", "yuv444p", "-p", "preset=ultrafast", "-p", "qp=0"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(1)
    try:
        for step in video.get("steps", []):
            take.step(step)
    finally:
        rec.send_signal(signal.SIGINT)
        rec.wait(timeout=60)
    take.end_scene()


def encode(video, out):
    """NAME.webm (the site) and NAME.webp, animated (the README: GitHub
    shows an animated image from the repository, not a video)."""
    raw = raw_path(video)
    if not raw.exists():
        fail(f"no recording of {video['name']} yet: scripts/pellicule --video {video['name']}")
    # The recorder's first second, before the steps start, is cut.
    trim = ["-ss", "0.8"]
    fps = video.get("fps", 60)
    scale = f"fps={fps}" + (f",scale={video['width']}:-2:flags=lanczos" if "width" in video else "")
    webm = out / f"{video['name']}.webm"
    sh("ffmpeg", "-y", "-loglevel", "error", *trim, "-i", str(raw), "-vf", scale + ",format=yuv420p",
       "-c:v", "libvpx-vp9", "-b:v", "0", "-crf", str(video.get("crf", 20)),
       "-deadline", "good", "-cpu-used", "1", "-row-mt", "1", "-tile-columns", "2",
       "-g", str(fps * 5), "-an", str(webm))
    webp = out / f"{video['name']}.webp"
    wscale = f"fps={video.get('webp_fps', 25)},scale={video.get('webp_width', 1280)}:-2:flags=lanczos"
    sh("ffmpeg", "-y", "-loglevel", "error", *trim, "-i", str(raw), "-vf", wscale,
       "-c:v", "libwebp_anim", "-lossless", "0", "-quality", str(video.get("webp_quality", 85)),
       "-compression_level", "6", "-loop", "0", "-an", str(webp))
    return webm, webp


def main():
    ap = argparse.ArgumentParser(prog="pellicule", description="Retakes the documentation's screenshots.")
    ap.add_argument("scenes", nargs="*", help="scene names, or check / list")
    ap.add_argument("--mode", choices=list(SCHEMES), help="only this mode")
    ap.add_argument("--out", type=Path, help="where to write (default: next to scenes.toml)")
    ap.add_argument("--video", metavar="NAME", help="record this [[video]] instead of screenshots")
    ap.add_argument("--encode", action="store_true",
                    help="with --video: encode the last recording again, without filming")
    ap.add_argument("--scenes-file", type=Path, default=SCENES)
    a = ap.parse_args()

    settings, scenes, videos, showcases = load(a.scenes_file)
    all_scenes = scenes

    if a.scenes[:1] == ["list"]:
        for s in scenes:
            say(f"{s['name']:<28} {', '.join(s.get('modes', ['light', 'dark'])):<12} {s.get('doc', '')}")
        for v in videos:
            say(f"{v['name']:<28} {'video, ' + v.get('mode', 'dark'):<12} {v.get('doc', '')}")
        for sc in showcases:
            say(f"{sc['name']:<28} {'showcase':<12} {sc.get('doc', '')}")
        return
    if a.scenes[:1] == ["check"]:
        problems = check(settings, scenes + videos) + check_showcases(showcases, scenes)
        if showcases and subprocess.run(["sh", "-c", "command -v firefox"], capture_output=True).returncode:
            problems.append("showcase: Firefox renders it, and it is not installed")
        for p in problems:
            print(p, file=sys.stderr)
        if problems:
            sys.exit(1)
        say(f"{len(scenes)} scenes, all in step with the shell")
        return

    if a.scenes[:1] == ["showcase"]:
        # Recomposed from the last full-screen captures, without taking any.
        out = a.out or a.scenes_file.parent
        for sc in showcases:
            for path in compose(sc, out, settings, all_scenes):
                say(f"{sc['name']:<16} {path}")
        return

    if a.video:
        found = [v for v in videos if v["name"] == a.video]
        if not found:
            fail(f"no video called {a.video} (scripts/pellicule list)")
        if subprocess.run(["sh", "-c", "command -v wf-recorder"], capture_output=True).returncode:
            fail("wf-recorder is not installed: sudo dnf install wf-recorder")
        video = found[0]
        out = a.out or a.scenes_file.parent
        out.mkdir(parents=True, exist_ok=True)
        if a.encode:
            for path in encode(video, out):
                say(f"{path} ({path.stat().st_size // 1024} KiB)")
            return
        problems = check(settings, [video])
        if problems:
            for p in problems:
                print(p, file=sys.stderr)
            fail("the video is out of step with the shell; nothing recorded")
        take = Take(settings)
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(130))
        try:
            take.start()
            scheme_set(*SCHEMES[video.get("mode", "dark")])
            time.sleep(settings.get("scheme_wait", 3))
            record(video, take)
        except KeyboardInterrupt:
            say("interrupted, putting everything back")
            return
        finally:
            take.restore()
        for path in encode(video, out):
            say(f"{path} ({path.stat().st_size // 1024} KiB)")
        return

    if a.scenes:
        names = {s["name"] for s in scenes}
        unknown = [n for n in a.scenes if n not in names]
        if unknown:
            fail(f"no scene called {', '.join(unknown)} (scripts/pellicule list)")
        scenes = [s for s in scenes if s["name"] in a.scenes]

    problems = check(settings, scenes)
    if problems:
        for p in problems:
            print(p, file=sys.stderr)
        fail("scenes.toml is out of step with the shell; nothing taken")
    size = tuple(settings.get("size", [1920, 1200]))
    if monitor_size() != size:
        fail(f"the screen is {monitor_size()}, the scenes are framed for {size}")

    out = a.out or a.scenes_file.parent
    out.mkdir(parents=True, exist_ok=True)
    modes = [a.mode] if a.mode else list(SCHEMES)

    take = Take(settings)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(130))
    taken = 0
    try:
        take.start()
        for mode in modes:
            todo = [s for s in scenes if mode in s.get("modes", ["light", "dark"])]
            if not todo:
                continue
            scheme_set(*SCHEMES[mode])
            time.sleep(settings.get("scheme_wait", 3))
            for s in todo:
                path = shoot(s, mode, take, out, settings)
                taken += 1
                say(f"{mode:<5} {s['name']:<16} {path.relative_to(REPO) if path.is_relative_to(REPO) else path}")
    except KeyboardInterrupt:
        say("interrupted, putting everything back")
    finally:
        take.restore()
    say(f"{taken} screenshot(s)")
    # The showcases built on what was just taken.
    done = {(s["name"], m) for s in scenes for m in modes}
    for sc in showcases:
        if any((n, sc.get("mode", "light")) in done for n in sc["back"] + sc["front"]):
            for path in compose(sc, out, settings, all_scenes):
                say(f"{'':<5} {sc['name']:<16} {path.relative_to(REPO) if path.is_relative_to(REPO) else path}")


if __name__ == "__main__":
    main()
